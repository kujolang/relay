from src.common import dict_get_or, env_or, env_bool, bool_or, safe_env_name, int_or, path_is_symlink_safe, path_has_symlink_component
from src.capabilities import capability_registry_posture
from src.adapters import kujo_bin, trusted_executable, trusted_file, ai_sdk_root, agents_sdk_root, ai_bridge_path, watchdog_url, run_process, safe_watchdog_upstream_profile
from src.policy import real_path
from src.watchdog import health_check, proxy_config_check, route_policy
from src.registry import agent_catalog, agent_path
from src.store import store_backend, store_root_safe, run_store_posture, sqlite_store_posture

func path_check(label, path, directory, required) {
    exists := false
    if directory { exists = path_is_dir(path) } else { exists = path_exists(path) }
    symlink := exists && path_is_symlink_safe(path)
    symlink_component := path_has_symlink_component(path)
    expected_type := false
    if directory { expected_type = exists } else { expected_type = exists && path_is_file(path) }
    safe := expected_type && symlink == false && symlink_component == false
    return {"name": label, "ok": safe, "required": required, "path": path, "exists": exists, "expected_type": expected_type, "symlink": symlink, "symlink_component": symlink_component, "safe": safe}
}

func dependency_version(label, path, cwd, args, env_map, required) {
    command := [path]
    for arg in args { command := push(command, arg) }
    result := run_process(command, cwd, env_map, 10000)
    version := trim(to_string(dict_get_or(result, "stdout", "")))
    if len(version) > 256 { version = substring(version, 0, 256) }
    ok := dict_get_or(result, "success", false) && version != ""
    error := "version_probe_failed"
    if ok { error = "" }
    return {"name": label, "ok": ok, "required": required, "safe": ok, "path": path, "version": version, "error": error, "duration_ms": int_or(dict_get_or(result, "duration_ms", 0), 0)}
}

func sha256_format(value) {
    candidate := to_lower(trim(to_string(value)))
    if len(candidate) != 64 { return false }
    mut i := 0
    while i < len(candidate) {
        if index_of("0123456789abcdef", substring(candidate, i, i + 1)) < 0 { return false }
        i = i + 1
    }
    return true
}

func dependency_hash(label, path, env_name) {
    expected := to_lower(trim(to_string(env_or(env_name, ""))))
    if expected == "" { return {"name": label, "ok": true, "required": false, "safe": true, "configured": false, "matched": null, "path": path} }
    if sha256_format(expected) == false { return {"name": label, "ok": false, "required": true, "safe": false, "configured": true, "matched": false, "path": path, "error": "invalid_expected_hash"} }
    if path_is_file(path) == false || path_is_symlink_safe(path) || path_has_symlink_component(path) { return {"name": label, "ok": false, "required": true, "safe": false, "configured": true, "matched": false, "path": path, "error": "path_unsafe"} }
    actual := ""
    try { actual = to_lower(trim(to_string(sha256_file(path)))) } except err { actual = "" }
    matched := actual == expected
    error := "hash_mismatch"
    if matched { error = "" }
    return {"name": label, "ok": matched, "required": true, "safe": matched, "configured": true, "matched": matched, "path": path, "expected_sha256": expected, "actual_sha256": actual, "error": error}
}

func doctor(repair) {
    root := env_or("RELAY_ROOT", ".")
    checks := []
    configured_kujo_path := env_or("KUJO_BIN", root + "/../kujo/target/release/kujo")
    checks := push(checks, path_check("kujo runtime", configured_kujo_path, false, true))
    checks := push(checks, path_check("Relay entrypoint", root + "/main.kujo", false, true))
    checks := push(checks, path_check("Relay source tree", root + "/src", true, true))
    state_path := env_or("RELAY_STATE_ROOT", root + "/.relay")
    store_safe := store_root_safe(state_path)
    checks := push(checks, {"name": "Relay evidence store", "ok": store_safe, "required": true, "path": state_path, "safe": store_safe, "reason": "state root and runs directory must not be symbolic links"})
    run_posture := run_store_posture(state_path)
    checks := push(checks, {"name": "Relay run store posture", "ok": dict_get_or(run_posture, "ok", false), "required": true, "safe": dict_get_or(run_posture, "safe", false), "present": dict_get_or(run_posture, "present", false), "entries": int_or(dict_get_or(run_posture, "entries", 0), 0), "valid": int_or(dict_get_or(run_posture, "valid", 0), 0), "invalid": int_or(dict_get_or(run_posture, "invalid", 0), 0), "limit": int_or(dict_get_or(run_posture, "limit", 4096), 4096), "exceeded": bool_or(dict_get_or(run_posture, "exceeded", false), false), "error": dict_get_or(run_posture, "error", "")})
    sqlite_posture := sqlite_store_posture(state_path)
    sqlite_required := store_backend() == "sqlite"
    checks := push(checks, {"name": "Relay transactional store", "ok": dict_get_or(sqlite_posture, "ok", false), "required": sqlite_required, "safe": dict_get_or(sqlite_posture, "safe", false), "backend": store_backend(), "configured": dict_get_or(sqlite_posture, "configured", false), "contract_version": dict_get_or(sqlite_posture, "contract_version", ""), "records": int_or(dict_get_or(sqlite_posture, "records", 0), 0), "error": dict_get_or(sqlite_posture, "error", "")})
    capability_posture := capability_registry_posture(root, repair)
    checks := push(checks, {"name": "Agents SDK capability registry", "ok": dict_get_or(capability_posture, "ok", false), "required": true, "safe": dict_get_or(capability_posture, "safe", false), "records": int_or(dict_get_or(capability_posture, "records", 0), 0), "stale": int_or(dict_get_or(capability_posture, "stale", 0), 0), "invalid": int_or(dict_get_or(capability_posture, "invalid", 0), 0), "locked": int_or(dict_get_or(capability_posture, "locked", 0), 0), "cleaned": int_or(dict_get_or(capability_posture, "cleaned", 0), 0), "repair": bool_or(repair, false), "error": dict_get_or(capability_posture, "error", "")})
    checks := push(checks, path_check("Relay launcher", root + "/bin/relay", false, false))
    checks := push(checks, path_check("AI SDK checkout", ai_sdk_root(), true, true))
    checks := push(checks, path_check("Agents SDK checkout", agents_sdk_root(), true, true))
    packwrite_path := trusted_executable("RELAY_PACKWRITE_BIN", root + "/../packwrite/bin/packwrite")
    runledger_path := trusted_executable("RELAY_RUNLEDGER_BIN", root + "/../runledger/bin/runledger")
    changebucket_path := trusted_executable("RELAY_CHANGEBUCKET_BIN", root + "/../changebucket/bin/changebucket")
    checks := push(checks, path_check("PackWrite binary", env_or("RELAY_PACKWRITE_BIN", root + "/../packwrite/bin/packwrite"), false, true))
    checks := push(checks, path_check("RunLedger binary", env_or("RELAY_RUNLEDGER_BIN", root + "/../runledger/bin/runledger"), false, true))
    checks := push(checks, path_check("ChangeBucket binary", env_or("RELAY_CHANGEBUCKET_BIN", root + "/../changebucket/bin/changebucket"), false, true))
    checks := push(checks, path_check("Eval entrypoint", env_or("RELAY_EVAL_ENTRY", root + "/../eval/main.kujo"), false, true))
    checks := push(checks, path_check("Capsule binary", env_or("RELAY_CAPSULE_BIN", root + "/../benchmarks-capsule/bin/capsule"), false, false))
    checks := push(checks, dependency_version("Kujo runtime version", kujo_bin(), root, ["--version"], {}, true))
    checks := push(checks, dependency_version("PackWrite version", packwrite_path, env_or("RELAY_PACKWRITE_ROOT", root + "/../packwrite"), ["version"], {"KUJO": kujo_bin()}, true))
    checks := push(checks, dependency_version("RunLedger version", runledger_path, env_or("RELAY_RUNLEDGER_ROOT", root + "/../runledger"), ["version"], {"KUJO": kujo_bin()}, true))
    kujo_modules := real_path(root + "/../kujo/modules")
    if kujo_modules == "" { kujo_modules = root + "/../kujo/modules" }
    checks := push(checks, dependency_version("ChangeBucket version", changebucket_path, env_or("RELAY_CHANGEBUCKET_ROOT", root + "/../changebucket"), ["version"], {"KUJO": kujo_bin(), "KUJO_MODULE_PATH": kujo_modules}, true))
    checks := push(checks, dependency_hash("Kujo runtime hash", kujo_bin(), "RELAY_KUJO_SHA256"))
    checks := push(checks, dependency_hash("PackWrite hash", packwrite_path, "RELAY_PACKWRITE_SHA256"))
    checks := push(checks, dependency_hash("RunLedger hash", runledger_path, "RELAY_RUNLEDGER_SHA256"))
    checks := push(checks, dependency_hash("ChangeBucket hash", changebucket_path, "RELAY_CHANGEBUCKET_SHA256"))
    agent_errors := []
    for agent in agent_catalog() {
        if path_is_dir(agent_path(agent["id"])) == false { agent_errors := push(agent_errors, agent["id"]) }
    }
    registry_safe := len(agent_errors) == 0
    checks := push(checks, {"name": "Chain of Command registry", "ok": registry_safe, "required": true, "safe": registry_safe, "missing": agent_errors})
    bridge_safe := ai_bridge_path() != ""
    checks := push(checks, {"name": "AI bridge source", "ok": bridge_safe, "required": true, "safe": bridge_safe})
    live := env_bool("RELAY_OFFLINE_FIXTURE", true) == false
    mode := "fixture"
    if live { mode = "live" }
    watchdog_route := route_policy(watchdog_url())
    watchdog_configured := dict_get_or(watchdog_route, "configured", false)
    watchdog_ok := dict_get_or(watchdog_route, "valid", false)
    if live == false { watchdog_ok = true }
    checks := push(checks, {"name": "Watchdog route", "ok": watchdog_ok, "required": live, "safe": watchdog_ok, "configured": watchdog_configured, "valid": dict_get_or(watchdog_route, "valid", false), "scheme": dict_get_or(watchdog_route, "scheme", ""), "reason": dict_get_or(watchdog_route, "reason", "")})
    watchdog_verify_required := live && env_bool("RELAY_WATCHDOG_VERIFY", false)
    if watchdog_verify_required {
        watchdog_health := health_check()
        watchdog_config := proxy_config_check()
        watchdog_api_ok := watchdog_health["healthy"] && watchdog_config["configured"]
        checks := push(checks, {"name": "Watchdog API health and proxy configuration", "ok": watchdog_api_ok, "required": true, "safe": watchdog_api_ok, "health": watchdog_health, "proxy_config": watchdog_config})
    }
    api_key_env := env_or("RELAY_API_KEY_ENV", "OPENAI_API_KEY")
    credential_name_ok := safe_env_name(api_key_env)
    credential_configured := credential_name_ok && env_or(api_key_env, "") != ""
    upstream_profile := env_or("RELAY_WATCHDOG_UPSTREAM_PROFILE", "")
    upstream_profile_valid := safe_watchdog_upstream_profile(upstream_profile)
    upstream_profile_configured := upstream_profile != ""
    checks := push(checks, {"name": "Watchdog upstream profile", "ok": upstream_profile_valid, "required": upstream_profile_configured, "safe": upstream_profile_valid, "configured": upstream_profile_configured})
    credential_ok := credential_configured || (upstream_profile_configured && upstream_profile_valid)
    if live == false { credential_ok = true }
    checks := push(checks, {"name": "live provider credential", "ok": credential_ok, "required": live, "safe": credential_name_ok, "environment": api_key_env, "name_valid": credential_name_ok, "configured": credential_configured, "upstream_profile_configured": upstream_profile_configured})
    required_failures := 0
    for check in checks { if dict_get_or(check, "required", false) && dict_get_or(check, "ok", false) == false { required_failures = required_failures + 1 } }
    return {"ok": required_failures == 0, "mode": mode, "required_failures": required_failures, "checks": checks}
}

export doctor := doctor
