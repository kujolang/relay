from src.common import dict_get_or, env_or, safe_env_name, int_or
from src.adapters import kujo_bin, ai_sdk_root, agents_sdk_root, watchdog_url, run_process
from src.watchdog import health_check, proxy_config_check, route_policy
from src.registry import agent_catalog, agent_path
from src.store import store_root_safe

func path_check(label, path, directory, required) {
    exists := false
    if directory { exists = path_is_dir(path) } else { exists = path_exists(path) }
    symlink := exists && path_is_symlink(path)
    expected_type := false
    if directory { expected_type = exists } else { expected_type = exists && path_is_file(path) }
    safe := expected_type && symlink == false
    return {"name": label, "ok": safe, "required": required, "path": path, "exists": exists, "expected_type": expected_type, "symlink": symlink, "safe": safe}
}

func dependency_version(label, path, cwd, args, env_map, required) {
    command := [path]
    for arg in args { command := push(command, arg) }
    result := run_process(command, cwd, env_map, 10000)
    version := trim(to_string(dict_get_or(result, "stdout", "")))
    if len(version) > 256 { version = substring(version, 0, 256) }
    ok := dict_get_or(result, "success", false) && version != ""
    error := "version_probe_failed"
    if ok { error = "" }
    return {"name": label, "ok": ok, "required": required, "safe": ok, "path": path, "version": version, "error": error, "duration_ms": int_or(dict_get_or(result, "duration_ms", 0), 0)}
}

func doctor() {
    root := env_or("RELAY_ROOT", ".")
    checks := []
    checks := push(checks, path_check("kujo runtime", kujo_bin(), false, true))
    checks := push(checks, path_check("Relay entrypoint", root + "/main.kujo", false, true))
    checks := push(checks, path_check("Relay source tree", root + "/src", true, true))
    store_safe := store_root_safe(root + "/.relay")
    checks := push(checks, {"name": "Relay evidence store", "ok": store_safe, "required": true, "path": root + "/.relay", "safe": store_safe, "reason": "state root and runs directory must not be symbolic links"})
    checks := push(checks, path_check("Relay launcher", root + "/bin/relay", false, false))
    checks := push(checks, path_check("AI SDK checkout", ai_sdk_root(), true, true))
    checks := push(checks, path_check("Agents SDK checkout", agents_sdk_root(), true, true))
    checks := push(checks, path_check("PackWrite binary", env_or("RELAY_PACKWRITE_BIN", root + "/../packwrite/bin/packwrite"), false, true))
    checks := push(checks, path_check("RunLedger binary", env_or("RELAY_RUNLEDGER_BIN", root + "/../runledger/bin/runledger"), false, true))
    checks := push(checks, path_check("ChangeBucket binary", env_or("RELAY_CHANGEBUCKET_BIN", root + "/../changebucket/bin/changebucket"), false, true))
    checks := push(checks, path_check("Eval entrypoint", env_or("RELAY_EVAL_ENTRY", root + "/../eval/main.kujo"), false, true))
    checks := push(checks, path_check("Capsule binary", env_or("RELAY_CAPSULE_BIN", root + "/../benchmarks-capsule/bin/capsule"), false, false))
    packwrite_path := env_or("RELAY_PACKWRITE_BIN", root + "/../packwrite/bin/packwrite")
    runledger_path := env_or("RELAY_RUNLEDGER_BIN", root + "/../runledger/bin/runledger")
    changebucket_path := env_or("RELAY_CHANGEBUCKET_BIN", root + "/../changebucket/bin/changebucket")
    checks := push(checks, dependency_version("Kujo runtime version", kujo_bin(), root, ["--version"], {}, true))
    checks := push(checks, dependency_version("PackWrite version", packwrite_path, env_or("RELAY_PACKWRITE_ROOT", root + "/../packwrite"), ["version"], {"KUJO": kujo_bin()}, true))
    checks := push(checks, dependency_version("RunLedger version", runledger_path, env_or("RELAY_RUNLEDGER_ROOT", root + "/../runledger"), ["version"], {"KUJO": kujo_bin()}, true))
    checks := push(checks, dependency_version("ChangeBucket version", changebucket_path, env_or("RELAY_CHANGEBUCKET_ROOT", root + "/../changebucket"), ["version"], {"KUJO": kujo_bin()}, true))
    agent_errors := []
    for agent in agent_catalog() {
        if path_is_dir(agent_path(agent["id"])) == false { agent_errors := push(agent_errors, agent["id"]) }
    }
    registry_safe := len(agent_errors) == 0
    checks := push(checks, {"name": "Chain of Command registry", "ok": registry_safe, "required": true, "safe": registry_safe, "missing": agent_errors})
    live := env_or("RELAY_OFFLINE_FIXTURE", "true") != "true"
    mode := "fixture"
    if live { mode = "live" }
    watchdog_route := route_policy(watchdog_url())
    watchdog_configured := dict_get_or(watchdog_route, "configured", false)
    watchdog_ok := dict_get_or(watchdog_route, "valid", false)
    if live == false { watchdog_ok = true }
    checks := push(checks, {"name": "Watchdog route", "ok": watchdog_ok, "required": live, "safe": watchdog_ok, "configured": watchdog_configured, "valid": dict_get_or(watchdog_route, "valid", false), "scheme": dict_get_or(watchdog_route, "scheme", ""), "reason": dict_get_or(watchdog_route, "reason", "")})
    watchdog_verify_required := live && env_or("RELAY_WATCHDOG_VERIFY", "false") == "true"
    if watchdog_verify_required {
        watchdog_health := health_check()
        watchdog_config := proxy_config_check()
        watchdog_api_ok := watchdog_health["healthy"] && watchdog_config["configured"]
        checks := push(checks, {"name": "Watchdog API health and proxy configuration", "ok": watchdog_api_ok, "required": true, "safe": watchdog_api_ok, "health": watchdog_health, "proxy_config": watchdog_config})
    }
    api_key_env := env_or("RELAY_API_KEY_ENV", "OPENAI_API_KEY")
    credential_name_ok := safe_env_name(api_key_env)
    credential_configured := credential_name_ok && env_or(api_key_env, "") != ""
    credential_ok := credential_configured
    if live == false { credential_ok = true }
    checks := push(checks, {"name": "live provider credential", "ok": credential_ok, "required": live, "safe": credential_name_ok, "environment": api_key_env, "name_valid": credential_name_ok, "configured": credential_configured})
    required_failures := 0
    for check in checks { if dict_get_or(check, "required", false) && dict_get_or(check, "ok", false) == false { required_failures = required_failures + 1 } }
    return {"ok": required_failures == 0, "mode": mode, "required_failures": required_failures, "checks": checks}
}

export doctor := doctor
