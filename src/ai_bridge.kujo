# Provider bridge executed with the AI SDK repository as its working directory.
from src.providers import openai_provider, openrouter_provider, deepseek_provider, custom_openai_compatible_provider
from src.ai_sdk import create_client, create_message, chat_completion

func get(obj, key, fallback) {
    if type(obj) == "dict" && has_key(obj, key) { return obj[key] }
    return fallback
}

payload_text := env("RELAY_AI_PAYLOAD")
if type(payload_text) == "null" || trim(to_string(payload_text)) == "" { print(to_json({"ok": false, "error": {"code": "missing_payload"}})); exit(1) }
payload_text := to_string(payload_text)
if len(payload_text) > 131072 { print(to_json({"ok": false, "error": {"code": "payload_too_large", "message": "RELAY_AI_PAYLOAD exceeds the 128 KiB safety limit"}})); exit(1) }
payload := null
try { payload = parse_json(payload_text) } except err { print(to_json({"ok": false, "error": {"code": "invalid_payload", "message": "RELAY_AI_PAYLOAD is invalid JSON"}})); exit(1) }
if type(payload) != "dict" { print(to_json({"ok": false, "error": {"code": "invalid_payload", "message": "RELAY_AI_PAYLOAD must be a JSON object"}})); exit(1) }
base_url := get(payload, "base_url", "https://api.openai.com/v1")
api_env := get(payload, "api_key_env", "OPENAI_API_KEY")
model := get(payload, "model", "fixture-model")
provider := custom_openai_compatible_provider(base_url, api_env, model)
messages := []
for item in get(payload, "messages", []) {
    if type(item) == "dict" { messages := push(messages, create_message(get(item, "role", "user"), get(item, "content", ""))) }
}
client := create_client(provider, null)
options := {"model": model, "max_tokens": get(payload, "max_tokens", 700), "temperature": get(payload, "temperature", 0.2), "max_retries": 1, "offline_fixture": get(payload, "offline_fixture", true), "stream": get(payload, "stream", false)}
watchdog_token := env("RELAY_WATCHDOG_PROXY_TOKEN")
if type(watchdog_token) != "null" && trim(to_string(watchdog_token)) != "" {
    options["headers"] := {"X-Watchdog-Proxy-Token": watchdog_token}
}
correlation_id := get(payload, "correlation_id", "")
if type(correlation_id) == "string" && trim(correlation_id) != "" {
    headers := get(options, "headers", {})
    if type(headers) != "dict" { headers = {} }
    headers["X-Observe-Correlation-Id"] := correlation_id
    headers["X-Observe-Session-Id"] := correlation_id
    options["headers"] := headers
}
result := chat_completion(client, messages, options)
print(to_json(result))
