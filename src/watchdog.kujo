from src.common import dict_get_or, env_or, string_or, int_or

# Watchdog owns live AI proxying and telemetry storage. Relay only consumes the
# narrow HTTP health/correlation contract needed to prove that a request was
# observed; it never reads Watchdog's SQLite database directly.

func api_base() {
    explicit := env_or("RELAY_WATCHDOG_API_URL", "")
    if explicit != "" { return explicit }
    proxy := env_or("RELAY_WATCHDOG_URL", "")
    marker := index_of(proxy, "/proxy/v1")
    if marker >= 0 { return substring(proxy, 0, marker) }
    return proxy
}

func route_policy(value) {
    base := string_or(value, "")
    if base == "" { return {"configured": false, "valid": false, "scheme": "", "reason": "missing"} }
    if contains(base, " ") || contains(base, "\n") || contains(base, "\r") || contains(base, "\t") { return {"configured": true, "valid": false, "scheme": "", "reason": "control_character"} }
    if contains(base, "@") { return {"configured": true, "valid": false, "scheme": "", "reason": "embedded_credentials"} }
    scheme := ""
    offset := 0
    if starts_with(base, "https://") { scheme = "https"; offset = 8 }
    else if starts_with(base, "http://") { scheme = "http"; offset = 7 }
    else { return {"configured": true, "valid": false, "scheme": "", "reason": "unsupported_scheme"} }
    if contains(base, "?") || contains(base, "#") { return {"configured": true, "valid": false, "scheme": scheme, "reason": "query_or_fragment"} }
    host_port := substring(base, offset, len(base))
    slash := index_of(host_port, "/")
    if slash >= 0 { host_port = substring(host_port, 0, slash) }
    if host_port == "" { return {"configured": true, "valid": false, "scheme": scheme, "reason": "missing_host"} }
    host := host_port
    if starts_with(host_port, "[") {
        closing := index_of(host_port, "]")
        if closing < 0 { return {"configured": true, "valid": false, "scheme": scheme, "reason": "malformed_ipv6_host"} }
        host = substring(host_port, 0, closing + 1)
    } else {
        colon := index_of(host_port, ":")
        if colon >= 0 { host = substring(host_port, 0, colon) }
    }
    if host == "" { return {"configured": true, "valid": false, "scheme": scheme, "reason": "missing_host"} }
    loopback := host == "127.0.0.1" || host == "localhost" || host == "[::1]"
    if scheme == "http" && loopback == false { return {"configured": true, "valid": false, "scheme": scheme, "reason": "http_non_loopback"} }
    return {"configured": true, "valid": true, "scheme": scheme, "reason": ""}
}

func safe_base(value) {
    return dict_get_or(route_policy(value), "valid", false)
}

func safe_correlation_id(value) {
    candidate := trim(to_string(value))
    if candidate == "" || len(candidate) > 160 { return "" }
    mut i := 0
    while i < len(candidate) {
        character := substring(candidate, i, i + 1)
        if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_", character) < 0 { return "" }
        i = i + 1
    }
    return candidate
}

func endpoint(path) {
    base := api_base()
    if safe_base(base) == false { return "" }
    if ends_with(base, "/") { return substring(base, 0, len(base) - 1) + path }
    return base + path
}

func get_json(path) {
    url := endpoint(path)
    if url == "" { return {"ok": false, "status": 0, "error": "RELAY_WATCHDOG_URL or RELAY_WATCHDOG_API_URL must be an http(s) URL"} }
    headers := {"Accept": "application/json"}
    api_token := env_or("RELAY_WATCHDOG_API_TOKEN", "")
    if api_token != "" { headers["X-Watchdog-Token"] := api_token }
    try {
        result := http_request(url, {"method": "GET", "timeout": 10, "_headers": headers})
        match result {
            case Ok(response): {
                status := dict_get_or(response, "_status", dict_get_or(response, "status", 0))
                body := string_or(dict_get_or(response, "_body", dict_get_or(response, "body", "")), "")
                parsed := null
                try { parsed = parse_json(body) } except err { parsed = null }
                if type(parsed) != "dict" { return {"ok": false, "status": status, "error": "Watchdog returned invalid JSON", "endpoint": path} }
                request_ok := status >= 200 && status < 300
                return {"ok": request_ok, "status": status, "body": parsed, "endpoint": path}
            }
            case Err(error): { return {"ok": false, "status": 0, "error": "Watchdog HTTP request failed", "endpoint": path} }
        }
    } except err { return {"ok": false, "status": 0, "error": "Watchdog HTTP request failed", "endpoint": path} }
}

func health_check() {
    raw := get_json("/healthz")
    result := {"ok": raw["ok"], "status": raw["status"], "endpoint": raw["endpoint"]}
    body := dict_get_or(raw, "body", {})
    data := dict_get_or(body, "data", {})
    healthy := raw["ok"] && dict_get_or(body, "ok", false) && string_or(dict_get_or(data, "status", ""), "") == "ok"
    result["healthy"] := healthy
    if healthy == false {
        result["error"] := string_or(dict_get_or(raw, "error", ""), "Watchdog health check failed")
    }
    return result
}

func proxy_config_check() {
    raw := get_json("/api/proxy-config")
    result := {"ok": raw["ok"], "status": raw["status"], "endpoint": raw["endpoint"]}
    body := dict_get_or(raw, "body", {})
    configured := raw["ok"] && dict_get_or(body, "ok", false) && type(dict_get_or(body, "data", null)) == "dict"
    result["configured"] := configured
    if configured == false { result["error"] := string_or(dict_get_or(raw, "error", ""), "Watchdog proxy configuration check failed") }
    return result
}

func sanitized_request_row(row) {
    if type(row) != "dict" { return {} }
    usage_complete := has_key(row, "input_tokens") && has_key(row, "output_tokens") && has_key(row, "total_tokens")
    return {
        "request_id": string_or(dict_get_or(row, "request_id", ""), ""),
        "model": string_or(dict_get_or(row, "model", ""), ""),
        "status": string_or(dict_get_or(row, "status", ""), ""),
        "usage_complete": usage_complete,
        "input_tokens": int_or(dict_get_or(row, "input_tokens", 0), 0),
        "output_tokens": int_or(dict_get_or(row, "output_tokens", 0), 0),
        "total_tokens": int_or(dict_get_or(row, "total_tokens", 0), 0),
        "cost_usd": dict_get_or(row, "cost_usd", 0),
        "latency_ms": int_or(dict_get_or(row, "latency_ms", 0), 0)
    }
}

func usage_reconciliation(expected_usage, observed_row) {
    if type(expected_usage) != "dict" || type(observed_row) != "dict" { return {"available": false, "matched": false, "reason": "usage_unavailable"} }
    expected_total := int_or(dict_get_or(expected_usage, "total_tokens", -1), -1)
    observed_total := int_or(dict_get_or(observed_row, "total_tokens", -1), -1)
    if expected_total < 0 || observed_total < 0 || dict_get_or(observed_row, "usage_complete", false) == false { return {"available": false, "matched": false, "reason": "usage_unavailable", "expected_total_tokens": expected_total, "observed_total_tokens": observed_total} }
    expected_input := int_or(dict_get_or(expected_usage, "input_tokens", -1), -1)
    expected_output := int_or(dict_get_or(expected_usage, "output_tokens", -1), -1)
    observed_input := int_or(dict_get_or(observed_row, "input_tokens", -1), -1)
    observed_output := int_or(dict_get_or(observed_row, "output_tokens", -1), -1)
    total_match := expected_total == observed_total
    input_match := expected_input < 0 || observed_input < 0 || expected_input == observed_input
    output_match := expected_output < 0 || observed_output < 0 || expected_output == observed_output
    matched := total_match && input_match && output_match
    return {"available": true, "matched": matched, "reason": "compared", "expected_input_tokens": expected_input, "expected_output_tokens": expected_output, "expected_total_tokens": expected_total, "observed_input_tokens": observed_input, "observed_output_tokens": observed_output, "observed_total_tokens": observed_total}
}

func usage_reconciliation_for_rows(expected_usage, observed_rows) {
    fallback := usage_reconciliation(expected_usage, {})
    if type(observed_rows) != "array" { return fallback }
    for row in observed_rows {
        candidate := usage_reconciliation(expected_usage, row)
        if dict_get_or(candidate, "matched", false) {
            candidate["matched_row"] := row
            return candidate
        }
        if dict_get_or(candidate, "available", false) { fallback = candidate }
    }
    return fallback
}

func correlation_check(correlation_id, request_id) {
    correlation := safe_correlation_id(correlation_id)
    if correlation == "" { return {"ok": false, "error": "A safe correlation ID is required"} }
    expected_request_id := string_or(request_id, "")
    if expected_request_id == "" { return {"ok": false, "correlation_id": correlation, "request_id": "", "matched": false, "matched_row": {}, "error": "A Watchdog request ID is required"} }
    raw := get_json("/api/requests?correlation_id=" + correlation + "&page_size=20")
    result := {"ok": raw["ok"], "status": raw["status"], "endpoint": raw["endpoint"]}
    body := dict_get_or(raw, "body", {})
    rows := dict_get_or(body, "data", [])
    found := false
    matched_row := {}
    matched_rows := []
    if type(rows) == "array" {
        for row in rows {
            correlation_matches := type(row) == "dict" && string_or(dict_get_or(row, "correlation_id", ""), "") == correlation
            request_matches := string_or(dict_get_or(row, "request_id", ""), "") == expected_request_id
            if correlation_matches && request_matches {
                sanitized := sanitized_request_row(row)
                matched_rows := push(matched_rows, sanitized)
                if found == false { found = true; matched_row = sanitized }
            }
        }
    }
    result["correlation_id"] := correlation
    result["request_id"] := expected_request_id
    result["matched"] := found
    result["matched_row"] := matched_row
    result["matched_rows"] := matched_rows
    result["ok"] := raw["ok"] && found
    if result["ok"] == false { result["error"] := string_or(dict_get_or(raw, "error", ""), "No Watchdog request row matched the Relay correlation ID") }
    return result
}

func verify(correlation_id, expected_usage, request_id) {
    health := health_check()
    config := proxy_config_check()
    correlation := correlation_check(correlation_id, request_id)
    reconciliation := usage_reconciliation_for_rows(expected_usage, dict_get_or(correlation, "matched_rows", []))
    verified := health["healthy"] && config["configured"] && correlation["ok"] && reconciliation["matched"]
    return {"ok": verified, "health": health, "proxy_config": config, "correlation": correlation, "usage_reconciliation": reconciliation}
}

export api_base := api_base
export route_policy := route_policy
export safe_base := safe_base
export safe_correlation_id := safe_correlation_id
export health_check := health_check
export proxy_config_check := proxy_config_check
export correlation_check := correlation_check
export usage_reconciliation := usage_reconciliation
export usage_reconciliation_for_rows := usage_reconciliation_for_rows
export verify := verify
export watchdog_verify := verify
