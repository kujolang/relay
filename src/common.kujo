func dict_get_or(obj, key, fallback) {
    if type(obj) != "dict" || has_key(obj, key) == 0 { return fallback }
    return obj[key]
}

func env_or(key, fallback) {
    raw := env(key)
    if type(raw) == "null" { return fallback }
    value := trim(to_string(raw))
    if value == "" { return fallback }
    return value
}

func string_or(value, fallback) {
    if type(value) != "string" { return fallback }
    value := trim(value)
    if value == "" { return fallback }
    return value
}

func bool_or(value, fallback) {
    if type(value) == "bool" { return value }
    if type(value) == "int" { return value != 0 }
    if type(value) == "string" {
        value := to_lower(trim(value))
        if value == "true" || value == "1" || value == "yes" { return true }
        if value == "false" || value == "0" || value == "no" { return false }
    }
    return fallback
}

func env_bool(key, fallback) {
    return bool_or(env_or(key, ""), fallback)
}

func int_or(value, fallback) {
    if type(value) == "int" { return value }
    if type(value) == "string" {
        try { return parse_int(trim(value)) } except err {}
    }
    return fallback
}

func array_or(value) {
    if type(value) == "array" { return value }
    return []
}

func now_iso() { return format_date(now(), "YYYY-MM-DDTHH:mm:ssZ") }

func safe_id(value, fallback) {
    raw := string_or(value, fallback)
    candidate := ""
    mut i := 0
    while i < len(raw) {
        character := substring(raw, i, i + 1)
        if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_", character) >= 0 {
            candidate = candidate + character
        } else {
            candidate = candidate + "-"
        }
        i = i + 1
    }
    if len(candidate) > 96 { candidate = substring(candidate, 0, 96) }
    if candidate == "" || candidate == "." || candidate == "-" {
        return "fallback"
    }
    return candidate
}

func safe_json(value) {
    try { return to_json(value) } except err { return "{}" }
}

func shell_quote_single(value) {
    return "'" + replace(to_string(value), "'", "'\"'\"'") + "'"
}

# Mission commands are intentionally tokenized into argv and executed without a
# shell. Callers that need shell syntax are rejected by policy rather than
# being silently reintroduced through `/bin/sh -lc`.
func command_args(command) {
    text := trim(to_string(command))
    if text == "" { return [] }
    argv := []
    for part in split(text, " ") {
        token := trim(part)
        if token != "" { argv := push(argv, token) }
    }
    return argv
}

func safe_env_name(value) {
    name := trim(to_string(value))
    if name == "" || starts_with(name, "PATH") || name == "HOME" || name == "PWD" || name == "SHELL" { return false }
    if contains_any(name, ["-", " ", ".", "/", "\\", ":"]) { return false }
    if starts_with(name, "LD_") || starts_with(name, "DYLD_") { return false }
    if contains_any(name, ["BASH_ENV", "GIT_CONFIG", "GIT_EXTERNAL_DIFF", "GIT_SSH_COMMAND", "NODE_OPTIONS", "PERL5OPT", "PYTHONPATH", "RUBYOPT", "SSL_CERT_FILE", "CURL_CA_BUNDLE", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "FTP_PROXY"]) { return false }
    if contains("0123456789", substring(name, 0, 1)) { return false }
    mut i := 0
    while i < len(name) {
        character := substring(name, i, i + 1)
        if contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", character) == false { return false }
        i = i + 1
    }
    return true
}

func path_is_symlink_safe(path) {
    # A probe error is not proof that the path is safe. Callers use this
    # helper at evidence and authority boundaries, so fail closed when the
    # runtime cannot inspect the path.
    try {
        return path_is_symlink(path)
    } except err {
        # A missing path is the only safe negative result after an inspection
        # error. Check existence only as a fallback so dangling symlinks are
        # still caught by symlink_metadata before they can be misclassified as
        # absent.
        try { if path_exists(path) == false { return false } } except nested_err {}
        return true
    }
}

func path_has_symlink_component(path) {
    candidate := trim(to_string(path))
    if candidate == "" { return true }
    mut current := ""
    if starts_with(candidate, "/") { current = "/" }
    for part in split(candidate, "/") {
        if part == "" || part == "." { continue }
        if part == ".." {
            if current == "/" { current = current + ".." } else if current == "" { current = ".." } else { current = current + "/.." }
            if path_is_symlink_safe(current) { return true }
            continue
        }
        if current == "/" { current = current + part } else if current == "" { current = part } else { current = current + "/" + part }
        # macOS exposes /tmp as the stable system alias for /private/tmp. It is
        # a platform-owned redirect, not a caller-selected repository alias;
        # continue past that one component while still checking every child
        # component for attacker-controlled redirection.
        if current == "/tmp" { continue }
        if path_is_symlink_safe(current) { return true }
    }
    return false
}

func path_has_parent_component(path) {
    for part in split(trim(to_string(path)), "/") {
        if part == ".." { return true }
    }
    return false
}

func write_text_atomic(path, content) {
    try {
        # Kujo's native atomic writer uses an O_EXCL temporary inode, fsync,
        # and atomic rename. Keep this wrapper so Relay callers retain one
        # boolean contract while avoiding predictable temp-file races.
        return write_file_atomic(path, to_string(content), true)
    } except err { return false }
}

func create_exclusive_dir(path) {
    candidate := trim(to_string(path))
    if candidate == "" || path_is_symlink_safe(candidate) || path_exists(candidate) { return false }
    try {
        # Kujo's create_dir is intentionally idempotent. Use the fixed native
        # mkdir executable for the OS-level exclusive-create primitive needed
        # by capability and index lock directories; no shell is involved.
        result := spawn_process(["/bin/mkdir", candidate], process_options({}, 2000, 4096))
        return result.success && result.exitcode == 0 && path_is_dir(candidate) && path_is_symlink_safe(candidate) == false
    } except err { return false }
}

func ensure_safe_directory(path) {
    candidate := trim(to_string(path))
    if candidate == "" || candidate == "." { return true }
    if path_is_symlink_safe(candidate) || path_has_symlink_component(candidate) { return false }
    if path_is_dir(candidate) { return true }
    parts := split(candidate, "/")
    mut current := ""
    if starts_with(candidate, "/") { current = "/" }
    mut i := 0
    while i < len(parts) {
        part := parts[i]
        if part != "" && part != "." {
            if current == "/" { current = "/" + part } else if current == "" { current = part } else { current = current + "/" + part }
            if path_is_symlink_safe(current) || path_has_symlink_component(current) { return false }
            if path_is_dir(current) == false {
                if create_exclusive_dir(current) == false && (path_is_symlink_safe(current) || path_is_dir(current) == false) { return false }
            }
        }
        i = i + 1
    }
    return path_is_dir(candidate) && path_is_symlink_safe(candidate) == false && path_has_symlink_component(candidate) == false
}

func safe_process_path() {
    # External adapters use absolute sibling-tool paths. Mission commands are
    # resolved only from these fixed system locations so a caller-controlled
    # PATH cannot replace `git`, `kujo`, or a policy helper with a workspace
    # executable.
    return "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
}

func process_options(extra_env, timeout_ms, max_output_bytes) {
    mut env_map := {}
    mut allowed := []
    for name in ["PATH", "HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL"] {
        if name == "PATH" {
            env_map["PATH"] := safe_process_path()
            allowed := push(allowed, "PATH")
            continue
        }
        value := env(name)
        if type(value) != "null" {
            env_map[name] := value
            allowed := push(allowed, name)
        }
    }
    if type(extra_env) == "dict" {
        for name in keys(extra_env) {
            # Never let a caller widen executable lookup or inject a loader,
            # interpreter, Git override, or trust-store variable through the
            # child-process boundary. PWD is retained only because run_process
            # derives it from its already validated working directory.
            if name == "PATH" { continue }
            if safe_env_name(name) == false { continue }
            env_map[name] := extra_env[name]
            allowed := push(allowed, name)
        }
    }
    env_map["PATH"] := safe_process_path()
    if index_of(allowed, "PATH") < 0 { allowed := push(allowed, "PATH") }
    return {"inherit_env": false, "timeout_ms": timeout_ms, "max_output_bytes": max_output_bytes, "env": env_map, "env_allow": allowed}
}

func process_options_with_cancel(extra_env, timeout_ms, max_output_bytes, cancel_file) {
    options := process_options(extra_env, timeout_ms, max_output_bytes)
    path := trim(to_string(cancel_file))
    if path != "" { options["cancel_file"] := path }
    return options
}

func read_json_or(path, fallback) {
    # Probe link metadata before existence semantics so a dangling link cannot
    # be treated as an absent optional artifact.
    if path_is_symlink_safe(path) { return fallback }
    if path_exists(path) == false || path_is_file(path) == false { return fallback }
    try { return parse_json(read_file(path)) } except err { return fallback }
}

func read_json_limited(path, fallback, max_bytes) {
    limit := int_or(max_bytes, 1048576)
    if limit <= 0 || path_is_symlink_safe(path) || path_exists(path) == false { return fallback }
    if path_is_file(path) == false || file_size(path) > limit { return fallback }
    return read_json_or(path, fallback)
}

func write_json(path, value) {
    return write_text_atomic(path, safe_json(value))
}

func append_jsonl_bounded(path, value, max_bytes) {
    try {
        line := safe_json(value) + "\n"
        limit := int_or(max_bytes, 8388608)
        if limit <= 0 || len(line) > limit { return false }
        # Check metadata before path_exists: writing through a dangling link
        # would otherwise turn an absent evidence file into an attacker-
        # selected destination.
        if path_is_symlink_safe(path) { return false }
        if path_exists(path) {
            if path_is_file(path) == false { return false }
            if file_size(path) + len(line) > limit { return false }
            append_file(path, line)
        } else { write_file(path, line) }
        return true
    } except err { return false }
}

func append_jsonl(path, value) {
    return append_jsonl_bounded(path, value, 8388608)
}

func capability_registry_path(root, run_id, session_id) {
    base := trim(to_string(root))
    if base == "" || path_is_symlink_safe(base) || path_has_symlink_component(base) { return "" }
    return base + "/.relay/capabilities/" + sha256(to_string(run_id) + "|" + to_string(session_id)) + ".json"
}

func issue_agent_capability(root, run_id, session_id, workspace, nonce, max_calls, ttl_ms) {
    path := capability_registry_path(root, run_id, session_id)
    if path == "" { return {"ok": false, "error": {"code": "capability_registry_unsafe", "message": "Capability registry root is unsafe"}} }
    directory := root + "/.relay/capabilities"
    if path_is_symlink_safe(directory) || path_has_symlink_component(directory) { return {"ok": false, "error": {"code": "capability_registry_unsafe", "message": "Capability registry directory is unsafe"}} }
    if ensure_safe_directory(directory) == false { return {"ok": false, "error": {"code": "capability_registry_unavailable", "message": "Capability registry directory could not be created safely"}} }
    lock := path + ".lock"
    if path_is_symlink_safe(path) || path_is_symlink_safe(lock) { return {"ok": false, "error": {"code": "capability_registry_unsafe", "message": "Capability registry record or lock is unsafe"}} }
    if path_exists(path) {
        if path_is_file(path) { return {"ok": false, "error": {"code": "capability_already_registered", "message": "Tool capability is already registered"}} }
        return {"ok": false, "error": {"code": "capability_registry_unsafe", "message": "Capability registry record is not a regular file"}}
    }
    if create_exclusive_dir(lock) == false {
        if path_exists(lock) && path_is_dir(lock) { return {"ok": false, "error": {"code": "capability_busy", "message": "Tool capability is already being issued or consumed"}} }
        return {"ok": false, "error": {"code": "capability_lock_unsafe", "message": "Tool capability lock could not be acquired"}}
    }
    if path_exists(path) {
        if path_is_dir(lock) { os_rmdir(lock) }
        return {"ok": false, "error": {"code": "capability_already_registered", "message": "Tool capability is already registered"}}
    }
    calls := int_or(max_calls, 4)
    if calls < 1 { calls = 1 }
    if calls > 16 { calls = 16 }
    lifetime := int_or(ttl_ms, 180000)
    if lifetime < 1000 { lifetime = 1000 }
    if lifetime > 600000 { lifetime = 600000 }
    secret := sha256(to_string(run_id) + "|" + to_string(session_id) + "|" + to_string(nonce) + "|" + to_string(current_timestamp()) + "|" + to_string(random_int(1000, 999999)))
    record := {"contract_version": "relay-agent-capability-v1", "run_id": to_string(run_id), "session_id": to_string(session_id), "workspace": to_string(workspace), "nonce": to_string(nonce), "capability": sha256(to_string(run_id) + "|" + to_string(session_id) + "|" + to_string(workspace) + "|" + to_string(nonce) + "|relay-agent-tools"), "secret_digest": sha256(secret), "issued_at_ms": current_timestamp(), "expires_at_ms": current_timestamp() + lifetime, "max_calls": calls, "used_calls": 0}
    if write_json(path, record) == false {
        if path_is_dir(lock) { os_rmdir(lock) }
        return {"ok": false, "error": {"code": "capability_registry_write_failed", "message": "Capability registry record could not be persisted"}}
    }
    if path_is_dir(lock) { os_rmdir(lock) }
    return {"ok": true, "secret": secret, "path": path, "expires_at_ms": record["expires_at_ms"], "max_calls": calls}
}

func consume_agent_capability(root, request, supplied_secret) {
    if type(request) != "dict" { return {"ok": false, "error": {"code": "capability_invalid", "message": "Capability request must be an object"}} }
    run_id := to_string(dict_get_or(request, "run_id", ""))
    session_id := to_string(dict_get_or(request, "session_id", ""))
    path := capability_registry_path(root, run_id, session_id)
    if path == "" || path_is_symlink_safe(path) || path_exists(path) == false { return {"ok": false, "error": {"code": "capability_not_registered", "message": "Tool capability is not registered"}} }
    lock := path + ".lock"
    if path_is_symlink_safe(lock) { return {"ok": false, "error": {"code": "capability_lock_unsafe", "message": "Tool capability lock is unsafe"}} }
    if path_exists(lock) {
        if path_is_dir(lock) { return {"ok": false, "error": {"code": "capability_busy", "message": "Tool capability is already being consumed"}} }
        return {"ok": false, "error": {"code": "capability_lock_unsafe", "message": "Tool capability lock is not a directory"}}
    }
    if create_exclusive_dir(lock) == false {
        if path_exists(lock) && path_is_dir(lock) { return {"ok": false, "error": {"code": "capability_busy", "message": "Tool capability is already being consumed"}} }
        return {"ok": false, "error": {"code": "capability_lock_unsafe", "message": "Tool capability lock could not be acquired"}}
    }
    mut result := {"ok": false, "error": {"code": "capability_invalid", "message": "Tool capability is invalid"}}
    try {
        record := read_json_limited(path, null, 65536)
        if type(record) != "dict" { result = {"ok": false, "error": {"code": "capability_invalid", "message": "Tool capability record is invalid"}} }
        else if to_string(dict_get_or(record, "run_id", "")) != run_id || to_string(dict_get_or(record, "session_id", "")) != session_id || to_string(dict_get_or(record, "workspace", "")) != to_string(dict_get_or(request, "workspace", "")) || to_string(dict_get_or(record, "nonce", "")) != to_string(dict_get_or(request, "capability_nonce", "")) || to_string(dict_get_or(record, "capability", "")) != to_string(dict_get_or(request, "capability", "")) { result = {"ok": false, "error": {"code": "capability_invalid", "message": "Tool capability identity does not match"}} }
        else if sha256(to_string(supplied_secret)) != to_string(dict_get_or(record, "secret_digest", "")) { result = {"ok": false, "error": {"code": "capability_invalid", "message": "Tool capability secret is invalid"}} }
        else if current_timestamp() > int_or(dict_get_or(record, "expires_at_ms", 0), 0) { result = {"ok": false, "error": {"code": "capability_expired", "message": "Tool capability has expired"}} }
        else {
            used := int_or(dict_get_or(record, "used_calls", 0), 0)
            maximum := int_or(dict_get_or(record, "max_calls", 0), 0)
            if maximum < 1 || used >= maximum { result = {"ok": false, "error": {"code": "capability_replay_detected", "message": "Tool capability call budget is exhausted"}} }
            else {
                record["used_calls"] := used + 1
                record["last_used_at_ms"] := current_timestamp()
                if write_json(path, record) == false { result = {"ok": false, "error": {"code": "capability_registry_write_failed", "message": "Tool capability usage could not be persisted"}} }
                else { result = {"ok": true, "used_calls": used + 1, "remaining_calls": maximum - used - 1, "expires_at_ms": record["expires_at_ms"]} }
            }
        }
    } except err { result = {"ok": false, "error": {"code": "capability_invalid", "message": "Tool capability could not be verified"}} }
    if path_is_dir(lock) { os_rmdir(lock) }
    return result
}

func revoke_agent_capability(root, run_id, session_id) {
    path := capability_registry_path(root, run_id, session_id)
    if path == "" || path_is_symlink_safe(path) { return false }
    lock := path + ".lock"
    if path_is_symlink_safe(lock) { return false }
    mut acquired := false
    mut attempt := 1
    while attempt <= 4 {
        if path_exists(lock) {
            if path_is_dir(lock) {
                if attempt < 4 { sleep(20 * attempt); attempt = attempt + 1; continue }
                return false
            }
            return false
        }
        if create_exclusive_dir(lock) { acquired = true; break }
        if path_exists(lock) && path_is_dir(lock) {
            if attempt < 4 { sleep(20 * attempt); attempt = attempt + 1; continue }
            return false
        }
        return false
    }
    if acquired == false { return false }
    mut removed := true
    try {
        if path_exists(path) {
            if path_is_symlink_safe(path) || path_is_file(path) == false { removed = false }
            else { delete_file(path) }
        }
    } except err { removed = false }
    if path_is_dir(lock) { os_rmdir(lock) }
    return removed
}

func capability_registry_posture(root, repair) {
    directory := trim(to_string(root)) + "/.relay/capabilities"
    if path_is_symlink_safe(directory) || path_has_symlink_component(directory) { return {"ok": false, "safe": false, "present": true, "records": 0, "stale": 0, "invalid": 1, "cleaned": 0, "error": "capability registry path is unsafe"} }
    if path_exists(directory) == false { return {"ok": true, "safe": true, "present": false, "records": 0, "stale": 0, "invalid": 0, "cleaned": 0} }
    if path_is_dir(directory) == false { return {"ok": false, "safe": false, "present": true, "records": 0, "stale": 0, "invalid": 1, "cleaned": 0, "error": "capability registry path is not a directory"} }
    names := list_dir(directory)
    if len(names) > 1024 { return {"ok": false, "safe": false, "present": true, "records": 0, "stale": 0, "invalid": 1, "cleaned": 0, "error": "capability registry exceeds the 1024-entry limit"} }
    mut records := 0
    mut stale := 0
    mut invalid := 0
    mut cleaned := 0
    mut locked := 0
    for name in names {
        if ends_with(name, ".json") == false { continue }
        path := directory + "/" + name
        if path_is_symlink_safe(path) || path_is_file(path) == false { invalid = invalid + 1; continue }
        record := read_json_limited(path, null, 65536)
        if type(record) != "dict" || to_string(dict_get_or(record, "contract_version", "")) != "relay-agent-capability-v1" { invalid = invalid + 1; continue }
        records = records + 1
        expired := current_timestamp() > int_or(dict_get_or(record, "expires_at_ms", 0), 0)
        exhausted := int_or(dict_get_or(record, "used_calls", 0), 0) >= int_or(dict_get_or(record, "max_calls", 0), 0)
        if bool_or(repair, false) {
            lock := path + ".lock"
            if path_is_symlink_safe(lock) {
                invalid = invalid + 1
                continue
            }
            if path_exists(lock) && path_is_dir(lock) == false {
                invalid = invalid + 1
                continue
            }
            acquired := false
            if path_exists(lock) {
                if path_is_dir(lock) { locked = locked + 1 } else { invalid = invalid + 1 }
            } else if create_exclusive_dir(lock) { acquired = true } else if path_exists(lock) && path_is_dir(lock) { locked = locked + 1 } else { invalid = invalid + 1 }
            if acquired {
                current := read_json_limited(path, null, 65536)
                if type(current) != "dict" || to_string(dict_get_or(current, "contract_version", "")) != "relay-agent-capability-v1" {
                    invalid = invalid + 1
                } else {
                    current_expired := current_timestamp() > int_or(dict_get_or(current, "expires_at_ms", 0), 0)
                    current_exhausted := int_or(dict_get_or(current, "used_calls", 0), 0) >= int_or(dict_get_or(current, "max_calls", 0), 0)
                    if current_expired || current_exhausted {
                        stale = stale + 1
                        try { delete_file(path); cleaned = cleaned + 1 } except err {}
                    }
                }
                if path_is_dir(lock) { os_rmdir(lock) }
            } else if expired || exhausted { stale = stale + 1 }
        } else if expired || exhausted {
            stale = stale + 1
        }
    }
    return {"ok": invalid == 0, "safe": invalid == 0, "present": true, "records": records, "stale": stale, "invalid": invalid, "locked": locked, "cleaned": cleaned, "repair": bool_or(repair, false)}
}

func redact_text(value) {
    text := to_string(value)
    text := replace(text, "Authorization: Bearer ", "Authorization: Bearer [REDACTED]")
    text := replace(text, "authorization: Bearer ", "authorization: Bearer [REDACTED]")
    text := replace(text, "Authorization: bearer ", "Authorization: bearer [REDACTED]")
    text := replace(text, "authorization: bearer ", "authorization: bearer [REDACTED]")
    text := replace(text, "OPENAI_API_KEY=", "OPENAI_API_KEY=[REDACTED]")
    text := replace(text, "DEEPSEEK_API_KEY=", "DEEPSEEK_API_KEY=[REDACTED]")
    text := replace(text, "OLLAMA_API_KEY=", "OLLAMA_API_KEY=[REDACTED]")
    text := replace(text, "ANTHROPIC_API_KEY=", "ANTHROPIC_API_KEY=[REDACTED]")
    text := replace(text, "GOOGLE_API_KEY=", "GOOGLE_API_KEY=[REDACTED]")
    text := replace(text, "AZURE_OPENAI_API_KEY=", "AZURE_OPENAI_API_KEY=[REDACTED]")
    text := replace(text, "RELAY_API_KEY=", "RELAY_API_KEY=[REDACTED]")
    text := regex_replace(text, "(?i)Bearer[[:space:]]+[^[:space:]]+", "Bearer [REDACTED]")
    text := regex_replace(text, "(?i)(api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|authorization|token|password|secret)([[:space:]:=\\\"']+)[^[:space:],}\\\"']+", "$1$2[REDACTED_CREDENTIAL]")
    text := regex_replace(text, "(?i)[A-Za-z0-9_-]*(?:TOKEN|KEY|SECRET|PASSWORD)[A-Za-z0-9_-]*[[:space:]]*=[[:space:]]*[^[:space:],;]+", "[REDACTED_CREDENTIAL]")
    text := regex_replace(text, "sk-[A-Za-z0-9_-]{8}[A-Za-z0-9_-]+", "sk-[REDACTED_KEY]")
    text := regex_replace(text, "AKIA[0-9A-Z]{16}", "AKIA[REDACTED_KEY]")
    text := regex_replace(text, "github_pat_[A-Za-z0-9_]{20,}", "github_pat_[REDACTED_KEY]")
    text := regex_replace(text, "gh[pousr]_[A-Za-z0-9]{20,}", "gh_[REDACTED_KEY]")
    text := regex_replace(text, "xox[baprs]-[A-Za-z0-9-]{10,}", "xox-[REDACTED_KEY]")
    text := regex_replace(text, "-----BEGIN [A-Z ]*PRIVATE KEY-----", "[REDACTED_PRIVATE_KEY]")
    return text
}

func contains_any(text, needles) {
    for needle in needles {
        if contains(to_lower(text), to_lower(needle)) { return true }
    }
    return false
}

