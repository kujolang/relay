from src.common import dict_get_or, int_or, bool_or, read_json_limited, write_json, string_or, path_is_symlink_safe, path_has_symlink_component, path_has_parent_component, create_exclusive_dir
from src.contracts import state_integrity_valid

# The index is a rebuildable cache. Per-run state.json remains authoritative;
# this keeps inspection correct after a torn write, copied workspace, or a
# process that exits between state persistence and index registration.

func safe_run_key(value) {
    candidate := to_string(value)
    if candidate == "" || candidate == "." || candidate == ".." || len(candidate) > 160 { return false }
    mut i := 0
    while i < len(candidate) {
        character := substring(candidate, i, i + 1)
        if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_", character) < 0 { return false }
        i = i + 1
    }
    return true
}

func run_state_path(state_root, run_id) {
    if safe_run_key(run_id) == false { return "" }
    return state_root + "/runs/" + run_id + "/state.json"
}

func expected_run_dir(state_root, run_id) {
    if safe_run_key(run_id) == false { return "" }
    return state_root + "/runs/" + run_id
}

func store_root_safe(state_root) {
    if trim(to_string(state_root)) == "" || path_has_parent_component(state_root) || path_has_symlink_component(state_root) { return false }
    runs_root := state_root + "/runs"
    if path_has_parent_component(runs_root) || path_has_symlink_component(runs_root) { return false }
    return true
}

func index_record(state_root, run_id, state) {
    integrity_valid := state_integrity_valid(state)
    status := string_or(dict_get_or(state, "status", "unknown"), "unknown")
    if integrity_valid == false { status = "integrity_invalid" }
    return {
        "run_dir": expected_run_dir(state_root, run_id),
        "mission_id": string_or(dict_get_or(state, "mission_id", ""), ""),
        "status": status,
        "updated_at": string_or(dict_get_or(state, "updated_at", ""), ""),
        "integrity_valid": integrity_valid
    }
}

func index_lock_path(state_root) { return state_root + "/.index.lock" }
func index_lock_owner_path(state_root) { return index_lock_path(state_root) + "/owner.json" }

func acquire_index_lock(state_root) {
    lock_path := index_lock_path(state_root)
    if path_is_symlink_safe(lock_path) {
        return {"ok": false, "error": "Run index lock path must not be a symbolic link"}
    }
    if path_is_dir(lock_path) {
        owner := read_json_limited(index_lock_owner_path(state_root), {}, 65536)
        acquired_at := dict_get_or(owner, "acquired_at_ms", 0)
        if type(acquired_at) == "int" && acquired_at > 0 && current_timestamp() - acquired_at > 60000 {
            if file_exists(index_lock_owner_path(state_root)) { delete_file(index_lock_owner_path(state_root)) }
            os_rmdir(lock_path)
        } else {
            return {"ok": false, "error": "Run index is busy"}
        }
    }
    token := sha256(state_root + ":" + to_string(current_timestamp()) + ":" + to_string(random_int(1000, 999999)))
    if create_exclusive_dir(lock_path) == false { return {"ok": false, "error": "Unable to acquire run index lock"} }
    owner := {"token": token, "acquired_at_ms": current_timestamp()}
    if write_json(index_lock_owner_path(state_root), owner) == false {
        os_rmdir(lock_path)
        return {"ok": false, "error": "Unable to persist run index lock owner"}
    }
    return {"ok": true, "token": token}
}

func acquire_index_lock_retry(state_root, max_attempts, delay_ms) {
    attempts := int_or(max_attempts, 1)
    delay := int_or(delay_ms, 0)
    if attempts < 1 { attempts = 1 }
    if attempts > 8 { attempts = 8 }
    if delay < 0 { delay = 0 }
    if delay > 1000 { delay = 1000 }
    mut attempt := 1
    mut last := {"ok": false, "error": "Run index lock acquisition failed"}
    while attempt <= attempts {
        last = acquire_index_lock(state_root)
        if last["ok"] {
            last["attempts"] := attempt
            return last
        }
        if attempt < attempts && delay > 0 { sleep(delay * attempt) }
        attempt = attempt + 1
    }
    last["attempts"] := attempts
    return last
}

func release_index_lock(state_root, token) {
    lock_path := index_lock_path(state_root)
    if path_is_dir(lock_path) == false { return {"ok": true, "released": false} }
    owner := read_json_limited(index_lock_owner_path(state_root), {}, 65536)
    if string_or(dict_get_or(owner, "token", ""), "") != string_or(token, "") {
        return {"ok": false, "error": "Run index lock token mismatch"}
    }
    if file_exists(index_lock_owner_path(state_root)) { delete_file(index_lock_owner_path(state_root)) }
    os_rmdir(lock_path)
    return {"ok": true, "released": true}
}

func rebuild_run_index(state_root) {
    index := {}
    runs_root := state_root + "/runs"
    if path_is_dir(runs_root) == false || path_is_symlink_safe(runs_root) { return index }
    for name in list_dir(runs_root) {
        if safe_run_key(name) == false { continue }
        run_dir := expected_run_dir(state_root, name)
        if path_is_dir(run_dir) == false || path_is_symlink_safe(run_dir) { continue }
        state := read_json_limited(run_state_path(state_root, name), null, 67108864)
        if type(state) != "dict" || string_or(dict_get_or(state, "run_id", ""), "") != name { continue }
        index[name] := index_record(state_root, name, state)
    }
    return index
}

func cached_index_is_safe(state_root, index) {
    if type(index) != "dict" { return false }
    index_path := state_root + "/index.json"
    if path_is_symlink_safe(index_path) || (path_exists(index_path) && file_size(index_path) > 8388608) { return false }
    for run_id in keys(index) {
        if safe_run_key(run_id) == false { return false }
        record := index[run_id]
        if type(record) != "dict" { return false }
        if string_or(dict_get_or(record, "run_dir", ""), "") != expected_run_dir(state_root, run_id) { return false }
        if path_is_dir(expected_run_dir(state_root, run_id)) == false || path_is_symlink_safe(expected_run_dir(state_root, run_id)) { return false }
    }
    return true
}

func run_directories_match_index(state_root, index) {
    if type(index) != "dict" { return false }
    runs_root := state_root + "/runs"
    if path_is_dir(runs_root) == false || path_is_symlink_safe(runs_root) { return len(index) == 0 }
    mut count := 0
    for name in list_dir(runs_root) {
        run_dir := expected_run_dir(state_root, name)
        if safe_run_key(name) && path_is_dir(run_dir) && path_is_symlink_safe(run_dir) == false {
            count = count + 1
            if has_key(index, name) == 0 { return false }
            state := read_json_limited(run_state_path(state_root, name), null, 67108864)
            if type(state) != "dict" || string_or(dict_get_or(state, "run_id", ""), "") != name { return false }
            expected := index_record(state_root, name, state)
            record := index[name]
            if string_or(dict_get_or(record, "mission_id", ""), "") != expected["mission_id"] || string_or(dict_get_or(record, "status", ""), "") != expected["status"] || string_or(dict_get_or(record, "updated_at", ""), "") != expected["updated_at"] || bool_or(dict_get_or(record, "integrity_valid", false), false) != expected["integrity_valid"] { return false }
        }
    }
    return count == len(index)
}

func rebuild_and_persist_run_index_result(state_root) {
    if store_root_safe(state_root) == false { return {"ok": false, "index": {}, "error": "Run index store root is unsafe"} }
    lock := acquire_index_lock_retry(state_root, 4, 20)
    if lock["ok"] == false { return {"ok": false, "index": rebuild_run_index(state_root), "error": "Run index could not acquire its bounded lock", "attempts": dict_get_or(lock, "attempts", 0)} }
    authoritative := rebuild_run_index(state_root)
    index_path := state_root + "/index.json"
    if write_json(index_path, authoritative) == false {
        release_index_lock(state_root, lock["token"])
        return {"ok": false, "index": authoritative, "error": "Run index could not be persisted", "attempts": lock["attempts"]}
    }
    persisted := read_json_limited(index_path, null, 8388608)
    verified := type(persisted) == "dict" && cached_index_is_safe(state_root, persisted) && run_directories_match_index(state_root, persisted)
    release_index_lock(state_root, lock["token"])
    if verified == false { return {"ok": false, "index": authoritative, "error": "Persisted run index failed verification", "attempts": lock["attempts"]} }
    return {"ok": true, "index": authoritative, "persisted": true, "attempts": lock["attempts"]}
}

func load_run_index(state_root) {
    if store_root_safe(state_root) == false { return {} }
    cached := read_json_limited(state_root + "/index.json", null, 8388608)
    if cached_index_is_safe(state_root, cached) && run_directories_match_index(state_root, cached) {
        return cached
    }
    return rebuild_and_persist_run_index(state_root)
}

func rebuild_and_persist_run_index(state_root) {
    result := rebuild_and_persist_run_index_result(state_root)
    return dict_get_or(result, "index", {})
}

func persist_run_index(state_root, index) {
    result := rebuild_and_persist_run_index_result(state_root)
    if dict_get_or(result, "ok", false) == false { return index }
    return dict_get_or(result, "index", index)
}

export safe_run_key := safe_run_key
export store_root_safe := store_root_safe
export index_lock_path := index_lock_path
export acquire_index_lock := acquire_index_lock
export acquire_index_lock_retry := acquire_index_lock_retry
export release_index_lock := release_index_lock
export rebuild_run_index := rebuild_run_index
export rebuild_and_persist_run_index_result := rebuild_and_persist_run_index_result
export rebuild_and_persist_run_index := rebuild_and_persist_run_index
export load_run_index := load_run_index
export persist_run_index := persist_run_index
