from src.common import dict_get_or, read_json_or, write_json, string_or

# The index is a rebuildable cache. Per-run state.json remains authoritative;
# this keeps inspection correct after a torn write, copied workspace, or a
# process that exits between state persistence and index registration.

func safe_run_key(value) {
    candidate := to_string(value)
    if candidate == "" || candidate == "." || candidate == ".." || len(candidate) > 160 { return false }
    mut i := 0
    while i < len(candidate) {
        character := substring(candidate, i, i + 1)
        if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_", character) < 0 { return false }
        i = i + 1
    }
    return true
}

func run_state_path(state_root, run_id) {
    if safe_run_key(run_id) == false { return "" }
    return state_root + "/runs/" + run_id + "/state.json"
}

func expected_run_dir(state_root, run_id) {
    if safe_run_key(run_id) == false { return "" }
    return state_root + "/runs/" + run_id
}

func index_record(state_root, run_id, state) {
    return {
        "run_dir": expected_run_dir(state_root, run_id),
        "mission_id": string_or(dict_get_or(state, "mission_id", ""), ""),
        "status": string_or(dict_get_or(state, "status", "unknown"), "unknown"),
        "updated_at": string_or(dict_get_or(state, "updated_at", ""), "")
    }
}

func rebuild_run_index(state_root) {
    index := {}
    runs_root := state_root + "/runs"
    if path_is_dir(runs_root) == false || path_is_symlink(runs_root) { return index }
    for name in list_dir(runs_root) {
        if safe_run_key(name) == false { continue }
        run_dir := expected_run_dir(state_root, name)
        if path_is_dir(run_dir) == false || path_is_symlink(run_dir) { continue }
        state := read_json_or(run_state_path(state_root, name), null)
        if type(state) != "dict" || string_or(dict_get_or(state, "run_id", ""), "") != name { continue }
        index[name] := index_record(state_root, name, state)
    }
    return index
}

func cached_index_is_safe(state_root, index) {
    if type(index) != "dict" { return false }
    for run_id in keys(index) {
        if safe_run_key(run_id) == false { return false }
        record := index[run_id]
        if type(record) != "dict" { return false }
        if string_or(dict_get_or(record, "run_dir", ""), "") != expected_run_dir(state_root, run_id) { return false }
        if path_is_dir(expected_run_dir(state_root, run_id)) == false || path_is_symlink(expected_run_dir(state_root, run_id)) { return false }
    }
    return true
}

func run_directories_match_index(state_root, index) {
    if type(index) != "dict" { return false }
    runs_root := state_root + "/runs"
    if path_is_dir(runs_root) == false || path_is_symlink(runs_root) { return len(index) == 0 }
    mut count := 0
    for name in list_dir(runs_root) {
        run_dir := expected_run_dir(state_root, name)
        if safe_run_key(name) && path_is_dir(run_dir) && path_is_symlink(run_dir) == false {
            count = count + 1
            if has_key(index, name) == 0 { return false }
        }
    }
    return count == len(index)
}

func load_run_index(state_root) {
    cached := read_json_or(state_root + "/index.json", null)
    if cached_index_is_safe(state_root, cached) && run_directories_match_index(state_root, cached) {
        return cached
    }
    rebuilt := rebuild_run_index(state_root)
    write_json(state_root + "/index.json", rebuilt)
    return rebuilt
}

func persist_run_index(state_root, index) {
    write_json(state_root + "/index.json", index)
    return index
}

export safe_run_key := safe_run_key
export rebuild_run_index := rebuild_run_index
export load_run_index := load_run_index
export persist_run_index := persist_run_index
