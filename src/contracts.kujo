from src.common import dict_get_or, string_or, array_or, now_iso, safe_json

export RELAY_VERSION := "0.1.0"
export EVENT_CONTRACT := "AgentEvent-compatible-v1"

func event_integrity_input(item) {
    return to_string(dict_get_or(item, "type", "")) + "|" +
        to_string(dict_get_or(item, "kind", "")) + "|" +
        to_string(dict_get_or(item, "run_id", "")) + "|" +
        to_string(dict_get_or(item, "session_id", "")) + "|" +
        to_string(dict_get_or(item, "step_id", "")) + "|" +
        to_string(dict_get_or(item, "agent_id", "")) + "|" +
        to_string(dict_get_or(item, "event_id", "")) + "|" +
        to_string(dict_get_or(item, "timestamp", "")) + "|" +
        to_string(dict_get_or(item, "parent_event_id", "")) + "|" +
        safe_json(dict_get_or(item, "payload", {})) + "|" +
        safe_json(dict_get_or(item, "metadata", {}))
}

func event(kind, mission_id, run_id, step_id, agent_id, payload, parent_event_id) {
    item := {
        "type": "AgentEvent",
        "kind": kind,
        "run_id": run_id,
        "agent_id": agent_id,
        "session_id": run_id,
        "step_id": step_id,
        "event_id": "evt-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999)) + "-" + kind,
        "timestamp": now_iso(),
        "parent_event_id": parent_event_id,
        "payload": payload,
        "metadata": {
            "mission_id": mission_id,
            "contract_version": EVENT_CONTRACT
        }
    }
    item["integrity_sha256"] := sha256(event_integrity_input(item))
    return item
}

func event_integrity_valid(item) {
    expected := string_or(dict_get_or(item, "integrity_sha256", ""), "")
    return expected != "" && expected == sha256(event_integrity_input(item))
}

func event_chain_integrity_valid(items) {
    if type(items) != "array" { return false }
    parent := ""
    seen := {}
    for item in items {
        if type(item) != "dict" { return false }
        event_id := string_or(dict_get_or(item, "event_id", ""), "")
        if event_id == "" || has_key(seen, event_id) { return false }
        if string_or(dict_get_or(item, "parent_event_id", ""), "") != parent { return false }
        if event_integrity_valid(item) == false { return false }
        seen[event_id] := true
        parent = event_id
    }
    return true
}

func event_sequence_matches_state(state_events, log_events) {
    if type(state_events) != "array" || type(log_events) != "array" || len(state_events) != len(log_events) { return false }
    mut i := 0
    while i < len(state_events) {
        state_id := string_or(dict_get_or(state_events[i], "event_id", ""), "")
        log_id := string_or(dict_get_or(log_events[i], "event_id", ""), "")
        if state_id == "" || state_id != log_id { return false }
        i = i + 1
    }
    return true
}

func run_state(mission_id, workflow, repo, run_id) {
    return {
        "type": "RelayRun",
        "contract_version": "relay-run-v1",
        "mission_id": mission_id,
        "run_id": run_id,
        "workflow": workflow,
        "status": "created",
        "repository": repo,
        "mission_spec": {},
        "checkpoint": null,
        "started_at": now_iso(),
        "updated_at": now_iso(),
        "current_step": "",
        "attempt": 0,
        "budgets": {"max_steps": 8, "max_repairs": 1, "max_tokens": 4000, "max_tool_calls": 4, "max_output_bytes": 1048576, "max_write_bytes": 1048576, "used_tokens": 0},
        "events": [],
        "artifacts": [],
        "evaluations": [],
        "changes": {},
        "failure": null
    }
}

func agent_profile(id, name, mandate, model, tools, authority) {
    return {
        "id": id,
        "name": name,
        "mandate": mandate,
        "model_preference": {"preferred": [model], "fallback": "fixture-model"},
        "allowed_tools": tools,
        "authority": authority,
        "stop_conditions": ["budget_exceeded", "policy_violation", "acceptance_met"],
        "handoff_targets": []
    }
}

export event := event
export event_integrity_valid := event_integrity_valid
export event_chain_integrity_valid := event_chain_integrity_valid
export event_sequence_matches_state := event_sequence_matches_state
export run_state := run_state
export agent_profile := agent_profile
