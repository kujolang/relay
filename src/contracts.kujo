from src.common import dict_get_or, string_or, array_or, now_iso, safe_json

export RELAY_VERSION := "1.1.0"
export MISSION_SPEC_VERSION := "1.0.0"
export LEGACY_MISSION_SPEC_VERSION := "0.1.0"
export EVENT_CONTRACT := "AgentEvent-compatible-v1"
export RECEIPT_CONTRACT := "relay-receipt-v1"

export func mission_spec_version_supported(version) {
    return version == MISSION_SPEC_VERSION || version == LEGACY_MISSION_SPEC_VERSION
}

func event_integrity_input(item) {
    return to_string(dict_get_or(item, "type", "")) + "|" +
        to_string(dict_get_or(item, "kind", "")) + "|" +
        to_string(dict_get_or(item, "run_id", "")) + "|" +
        to_string(dict_get_or(item, "session_id", "")) + "|" +
        to_string(dict_get_or(item, "step_id", "")) + "|" +
        to_string(dict_get_or(item, "agent_id", "")) + "|" +
        to_string(dict_get_or(item, "event_id", "")) + "|" +
        to_string(dict_get_or(item, "timestamp", "")) + "|" +
        to_string(dict_get_or(item, "parent_event_id", "")) + "|" +
        safe_json(dict_get_or(item, "payload", {})) + "|" +
        safe_json(dict_get_or(item, "metadata", {}))
}

func event(kind, mission_id, run_id, step_id, agent_id, payload, parent_event_id) {
    item := {
        "type": "AgentEvent",
        "kind": kind,
        "run_id": run_id,
        "agent_id": agent_id,
        "session_id": run_id,
        "step_id": step_id,
        "event_id": "evt-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999)) + "-" + kind,
        "timestamp": now_iso(),
        "parent_event_id": parent_event_id,
        "payload": payload,
        "metadata": {
            "mission_id": mission_id,
            "contract_version": EVENT_CONTRACT
        }
    }
    item["integrity_sha256"] := sha256(event_integrity_input(item))
    return item
}

func event_integrity_valid(item) {
    expected := string_or(dict_get_or(item, "integrity_sha256", ""), "")
    return expected != "" && expected == sha256(event_integrity_input(item))
}

func event_chain_integrity_valid(items) {
    if type(items) != "array" { return false }
    parent := ""
    seen := {}
    for item in items {
        if type(item) != "dict" { return false }
        event_id := string_or(dict_get_or(item, "event_id", ""), "")
        if event_id == "" || has_key(seen, event_id) { return false }
        if string_or(dict_get_or(item, "parent_event_id", ""), "") != parent { return false }
        if event_integrity_valid(item) == false { return false }
        seen[event_id] := true
        parent = event_id
    }
    return true
}

func event_sequence_matches_state(state_events, log_events) {
    if type(state_events) != "array" || type(log_events) != "array" || len(state_events) != len(log_events) { return false }
    mut i := 0
    while i < len(state_events) {
        state_id := string_or(dict_get_or(state_events[i], "event_id", ""), "")
        log_id := string_or(dict_get_or(log_events[i], "event_id", ""), "")
        if state_id == "" || state_id != log_id || safe_json(state_events[i]) != safe_json(log_events[i]) { return false }
        i = i + 1
    }
    return true
}

func receipt_integrity_input(item) {
    return to_string(dict_get_or(item, "type", "")) + "|" +
        to_string(dict_get_or(item, "contract_version", "")) + "|" +
        to_string(dict_get_or(item, "receipt_id", "")) + "|" +
        to_string(dict_get_or(item, "kind", "")) + "|" +
        to_string(dict_get_or(item, "mission_id", "")) + "|" +
        to_string(dict_get_or(item, "run_id", "")) + "|" +
        to_string(dict_get_or(item, "step_id", "")) + "|" +
        to_string(dict_get_or(item, "agent_id", "")) + "|" +
        to_string(dict_get_or(item, "artifact_ref", "")) + "|" +
        to_string(dict_get_or(item, "status", "")) + "|" +
        to_string(dict_get_or(item, "created_at", "")) + "|" +
        safe_json(dict_get_or(item, "metadata", {})) + "|" +
        safe_json(dict_get_or(item, "payload", {}))
}

func receipt(kind, mission_id, run_id, step_id, agent_id, artifact_ref, status, payload) {
    item := {
        "type": "RelayReceipt",
        "contract_version": RECEIPT_CONTRACT,
        "receipt_id": "rcpt-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999)) + "-" + kind,
        "kind": kind,
        "mission_id": mission_id,
        "run_id": run_id,
        "step_id": step_id,
        "agent_id": agent_id,
        "artifact_ref": artifact_ref,
        "status": status,
        "created_at": now_iso(),
        "metadata": {},
        "payload": payload
    }
    item["integrity_sha256"] := sha256(receipt_integrity_input(item))
    return item
}

func receipt_integrity_valid(item) {
    expected := string_or(dict_get_or(item, "integrity_sha256", ""), "")
    return expected != "" && expected == sha256(receipt_integrity_input(item))
}

func receipt_sequence_valid(items) {
    if type(items) != "array" { return false }
    seen := {}
    for item in items {
        if type(item) != "dict" { return false }
        receipt_id := string_or(dict_get_or(item, "receipt_id", ""), "")
        if receipt_id == "" || has_key(seen, receipt_id) || receipt_integrity_valid(item) == false { return false }
        seen[receipt_id] := true
    }
    return true
}

func receipt_sequence_matches_state(state_receipts, file_receipts) {
    if type(state_receipts) != "array" || type(file_receipts) != "array" { return false }
    return safe_json(state_receipts) == safe_json(file_receipts)
}

func state_integrity_input(state) {
    if type(state) != "dict" { return "" }
    unsigned := {}
    for key in keys(state) {
        if key != "integrity_sha256" { unsigned[key] := state[key] }
    }
    return safe_json(unsigned)
}

func state_integrity_valid(state) {
    expected := string_or(dict_get_or(state, "integrity_sha256", ""), "")
    return expected != "" && expected == sha256(state_integrity_input(state))
}

func run_state(mission_id, workflow, repo, run_id) {
    return {
        "type": "RelayRun",
        "relay_version": RELAY_VERSION,
        "contract_version": "relay-run-v1",
        "mission_id": mission_id,
        "run_id": run_id,
        "workflow": workflow,
        "status": "created",
        "repository": repo,
        "mission_spec": {},
        "checkpoint": null,
        "started_at": now_iso(),
        "updated_at": now_iso(),
        "current_step": "",
        "attempt": 0,
        "budgets": {"max_steps": 8, "max_repairs": 1, "max_tokens": 4000, "max_tool_calls": 4, "max_tool_turns": 2, "max_output_bytes": 1048576, "max_write_bytes": 1048576, "used_tokens": 0},
        "model": "",
        "provider": "",
        "packet_revision": 0,
        "events": [],
        "receipts": [],
        "artifacts": [],
        "evaluations": [],
        "changes": {},
        "failure": null
    }
}

func agent_profile(id, name, mandate, model, tools, authority) {
    return {
        "id": id,
        "name": name,
        "mandate": mandate,
        "model_preference": {"preferred": [model], "fallback": "fixture-model"},
        "allowed_tools": tools,
        "authority": authority,
        "stop_conditions": ["budget_exceeded", "policy_violation", "acceptance_met"],
        "handoff_targets": []
    }
}

export event := event
export event_integrity_input := event_integrity_input
export event_integrity_valid := event_integrity_valid
export event_chain_integrity_valid := event_chain_integrity_valid
export event_sequence_matches_state := event_sequence_matches_state
export receipt := receipt
export receipt_integrity_input := receipt_integrity_input
export receipt_integrity_valid := receipt_integrity_valid
export receipt_sequence_valid := receipt_sequence_valid
export receipt_sequence_matches_state := receipt_sequence_matches_state
export state_integrity_input := state_integrity_input
export state_integrity_valid := state_integrity_valid
export run_state := run_state
export agent_profile := agent_profile
