from src.common import dict_get_or, env_or, string_or, bool_or, read_json_or, safe_json, write_json
from src.contracts import RELAY_VERSION, event_chain_integrity_valid, event_sequence_matches_state
from src.registry import agent_catalog, find_agent, agent_path
from src.adapters import ai_chat, capsule_run
from src.runtime import ensure_dir, create_mission, run_mission, pause_run, cleanup_run, resume_run, execute_tool_request, state_root, run_root
from src.store import load_run_index, rebuild_run_index, persist_run_index
from src.doctor import doctor

func has_flag(flags, name) { return has_key(flags, name) }

func positional(values, index, fallback) {
    if type(values) != "array" || index < 0 || index >= len(values) { return fallback }
    return values[index]
}

func parse_tokens(tokens) {
    positionals := []
    flags := {}
    mut i := 0
    while i < len(tokens) {
        token := tokens[i]
        if starts_with(token, "--") {
            key := substring(token, 2, len(token))
            if key == "json" || key == "stream" || key == "fixture" || key == "offline" || key == "help" || key == "skip-agent-smoke" || key == "confirm" {
                flags[key] := true
            } else if i + 1 < len(tokens) && starts_with(tokens[i + 1], "--") == false {
                flags[key] := tokens[i + 1]
                i = i + 1
            } else { flags[key] := "" }
        } else { positionals := push(positionals, token) }
        i = i + 1
    }
    return {"positionals": positionals, "flags": flags}
}

func output(payload, json_mode) {
    if type(payload) == "dict" && has_key(payload, "_stream_events") {
        for item in payload["_stream_events"] { print(safe_json(item)) }
        return
    }
    if json_mode { print(safe_json(payload)); return }
    if type(payload) == "dict" {
        if has_key(payload, "error") { print("error: " + to_string(payload["error"])); return }
        if has_key(payload, "ok") { print("ok: " + to_string(payload["ok"])) }
        if has_key(payload, "path") { print("path: " + to_string(payload["path"])) }
        if has_key(payload, "run_dir") { print("run_dir: " + to_string(payload["run_dir"])) }
        if has_key(payload, "status") { print("status: " + to_string(payload["status"])) }
        if has_key(payload, "run") && type(payload["run"]) == "dict" { print("run: " + to_string(dict_get_or(payload["run"], "run_id", ""))) }
    } else { print(to_string(payload)) }
}

func help_text() {
    return "Relay " + RELAY_VERSION + " — Kujo-native mission composition runtime\n\n" +
        "Usage: relay <chat|models|agents|missions|runs|benchmark|doctor> ...\n\n" +
        "  chat <prompt> [--model <id>] [--provider <id>] [--fixture] [--stream] [--json]\n" +
        "  models list|inspect <model>|probe <model> [--fixture]\n" +
        "  agents list|inspect <agent>|validate\n" +
        "  doctor [--json]\n" +
        "  missions create [spec.json] [--output path]\n" +
        "  missions run <spec.json> [--fixture] [--pause-after-plan] [--skip-agent-smoke] [--json]\n" +
        "  missions inspect <run-id>|pause <run-id>|resume <run-id>|cleanup <run-id> --confirm|report <run-id>\n" +
        "  runs list|rebuild|inspect <run-id>|events <run-id>|changes <run-id>|evaluations <run-id>|export <run-id> [--output path]\n" +
        "  tools execute --json (bounded Agents SDK worker callback)\n" +
        "  benchmark run <repo> [--json] (Capsule discovery slice)"
}

func cmd_chat(tokens) {
    parsed := parse_tokens(tokens)
    if len(parsed["positionals"]) == 0 { return {"ok": false, "error": "chat requires a prompt"} }
    prompt := join(parsed["positionals"], " ")
    model := string_or(dict_get_or(parsed["flags"], "model", "fixture-model"), "fixture-model")
    provider := string_or(dict_get_or(parsed["flags"], "provider", "fixture"), "fixture")
    offline := has_flag(parsed["flags"], "fixture") || has_flag(parsed["flags"], "offline") || env_or("RELAY_OFFLINE_FIXTURE", "true") == "true"
    result := ai_chat([{"role": "user", "content": prompt}], model, provider, offline, has_flag(parsed["flags"], "stream"))
    if has_flag(parsed["flags"], "stream") {
        events := []
        raw := dict_get_or(result, "raw", {})
        stream_events := dict_get_or(raw, "stream_events", [])
        if type(stream_events) == "array" {
            for source_event in stream_events {
                if type(source_event) != "dict" { continue }
                choices := dict_get_or(source_event, "choices", [])
                if type(choices) != "array" || len(choices) == 0 { continue }
                choice := choices[0]
                delta := dict_get_or(choice, "delta", {})
                content := dict_get_or(delta, "content", "")
                if type(content) == "string" && content != "" { events := push(events, {"type": "delta", "content": content, "done": false}) }
            }
        }
        if len(events) == 0 {
            content := dict_get_or(result, "output_text", dict_get_or(result, "content", dict_get_or(result, "response", "")))
            if content != "" { events := push(events, {"type": "delta", "content": content, "done": false}) }
        }
        events := push(events, {"type": "done", "ok": dict_get_or(result, "ok", false), "usage": dict_get_or(result, "usage", {}), "telemetry": dict_get_or(result, "relay_telemetry", {})})
        return {"ok": dict_get_or(result, "ok", false), "_stream_events": events, "result": result}
    }
    return result
}

func cmd_models(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "list")
    models := [
        {"id": "fixture-model", "provider": "fixture", "capabilities": ["chat", "structured_output"], "offline": true},
        {"id": env_or("RELAY_MODEL", "gpt-4.1-mini"), "provider": env_or("RELAY_PROVIDER", "openai-compatible"), "capabilities": ["chat", "streaming", "tool_calls"], "offline": false}
    ]
    if sub == "inspect" { for model in models { if model["id"] == positional(parsed["positionals"], 1, "") { return {"ok": true, "model": model} } }; return {"ok": false, "error": "unknown model"} }
    if sub == "probe" {
        model := string_or(positional(parsed["positionals"], 1, env_or("RELAY_MODEL", "fixture-model")), "fixture-model")
        provider := string_or(dict_get_or(parsed["flags"], "provider", env_or("RELAY_PROVIDER", "fixture")), "fixture")
        offline := has_flag(parsed["flags"], "fixture") || has_flag(parsed["flags"], "offline") || env_or("RELAY_OFFLINE_FIXTURE", "true") == "true"
        result := ai_chat([{"role": "user", "content": "Reply with exactly: relay-probe-ok"}], model, provider, offline, false)
        return {"ok": dict_get_or(result, "ok", false), "model": model, "provider": provider, "offline": offline, "result": result}
    }
    return {"ok": true, "models": models, "routing": "explicit profile selection; fallback is visible in run evidence"}
}

func cmd_agents(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "list")
    if sub == "inspect" {
        agent := find_agent(positional(parsed["positionals"], 1, ""))
        if type(agent) == "null" { return {"ok": false, "error": "unknown agent"} }
        agent["source_path"] := agent_path(agent["id"])
        agent["source_exists"] := path_is_dir(agent_path(agent["id"]))
        return {"ok": true, "agent": agent}
    }
    if sub == "validate" {
        errors := []
        for agent in agent_catalog() { if path_is_dir(agent_path(agent["id"])) == false { errors := push(errors, agent["id"] + " source path missing") } }
        return {"ok": len(errors) == 0, "errors": errors, "count": len(agent_catalog())}
    }
    return {"ok": true, "agents": agent_catalog(), "source": env_or("KUJO_AGENTS_PATH", "../kujo-agents") + "/chain-of-command"}
}

func cmd_missions(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "help")
    if sub == "create" {
        source := positional(parsed["positionals"], 1, "")
        return create_mission(source, string_or(dict_get_or(parsed["flags"], "output", ""), ""))
    }
    if sub == "run" {
        path := positional(parsed["positionals"], 1, "")
        if path == "" { return {"ok": false, "error": "missions run requires a spec path"} }
        offline := has_flag(parsed["flags"], "fixture")
        if env_or("RELAY_OFFLINE_FIXTURE", "true") == "true" { offline = true }
        return run_mission(path, {"offline_fixture": offline, "stream": false, "pause_after_plan": has_flag(parsed["flags"], "pause-after-plan"), "agents_sdk_smoke": has_flag(parsed["flags"], "skip-agent-smoke") == false})
    }
    id := positional(parsed["positionals"], 1, "")
    index := load_run_index(state_root())
    if sub == "pause" { return pause_run(id) }
    if sub == "cleanup" { return cleanup_run(id, has_flag(parsed["flags"], "confirm")) }
    if sub == "resume" { return resume_run(id) }
    if sub == "inspect" || sub == "report" {
        record := dict_get_or(index, id, null)
        if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + id} }
        state := read_json_or(record["run_dir"] + "/state.json", {})
        if sub == "report" { return {"ok": true, "report_json": record["run_dir"] + "/report.json", "report_markdown": record["run_dir"] + "/report.md", "status": dict_get_or(state, "status", "unknown")} }
        return {"ok": true, "run": state, "run_dir": record["run_dir"]}
    }
    return {"ok": false, "error": "unknown missions command"}
}

func cmd_runs(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "list")
    index := load_run_index(state_root())
    id := positional(parsed["positionals"], 1, "")
    if sub == "list" { return {"ok": true, "runs": index, "index_source": "validated_cache_or_rebuild"} }
    if sub == "rebuild" { rebuilt := rebuild_run_index(state_root()); persist_run_index(state_root(), rebuilt); return {"ok": true, "runs": rebuilt, "index_source": "rebuild"} }
    record := dict_get_or(index, id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + id} }
    if sub == "inspect" { return {"ok": true, "run": read_json_or(record["run_dir"] + "/state.json", {}), "run_dir": record["run_dir"]} }
    if sub == "events" || sub == "export" {
        events_path := record["run_dir"] + "/events.jsonl"
        if path_exists(events_path) == false || file_size(events_path) > 8388608 { return {"ok": false, "error": "run event log is missing or exceeds the 8 MiB inspection limit", "integrity_valid": false, "state_consistent": false} }
        raw_events := read_file(events_path)
        events := []
        for line in split(raw_events, "\n") {
            if trim(line) == "" { continue }
            try { events = push(events, parse_json(line)) } except err { return {"ok": false, "error": "run event log contains invalid JSON", "integrity_valid": false} }
        }
        state := read_json_or(record["run_dir"] + "/state.json", {})
        chain_valid := event_chain_integrity_valid(events)
        state_consistent := event_sequence_matches_state(dict_get_or(state, "events", []), events)
        valid := chain_valid && state_consistent
        event_bundle := {"integrity_valid": valid, "chain_integrity_valid": chain_valid, "state_consistent": state_consistent, "events": events, "events_jsonl": raw_events}
        if sub == "events" { event_bundle["ok"] := valid; return event_bundle }
        if valid == false { event_bundle["ok"] := false; event_bundle["error"] := "run event integrity verification failed"; return event_bundle }
        bundle := {"format": "relay-run-export-v1", "run_id": id, "integrity_valid": true, "run": state, "events": events, "changes": read_json_or(record["run_dir"] + "/changes.json", {}), "evaluations": read_json_or(record["run_dir"] + "/evaluations.json", []), "report": read_json_or(record["run_dir"] + "/report.json", {})}
        output_path := string_or(dict_get_or(parsed["flags"], "output", ""), "")
        if output_path != "" {
            if write_json(output_path, bundle) == false { return {"ok": false, "error": "run export could not be written"} }
            return {"ok": true, "output": output_path, "run_id": id, "integrity_valid": true}
        }
        bundle["ok"] := true
        return bundle
    }
    if sub == "changes" { return {"ok": true, "changes": read_json_or(record["run_dir"] + "/changes.json", {})} }
    if sub == "evaluations" { return {"ok": true, "evaluations": read_json_or(record["run_dir"] + "/evaluations.json", [])} }
    return {"ok": false, "error": "unknown runs command"}
}

func cmd_benchmark(tokens) {
    parsed := parse_tokens(tokens)
    repo := positional(parsed["positionals"], 1, ".")
    result := capsule_run(repo, state_root() + "/capsule")
    result["benchmark"] := "capsule-discovery"
    return result
}

func cmd_tools(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "")
    if sub != "execute" { return {"ok": false, "error": "unknown tools command"} }
    raw := env("RELAY_TOOL_REQUEST")
    if type(raw) == "null" || trim(to_string(raw)) == "" { return {"ok": false, "error": "RELAY_TOOL_REQUEST is required"} }
    request := null
    try { request = parse_json(raw) } except err { return {"ok": false, "error": "RELAY_TOOL_REQUEST is invalid JSON"} }
    return execute_tool_request(request, dict_get_or(parsed["flags"], "capability", ""))
}

export func main(argv) {
    if len(argv) == 0 || argv[0] == "help" || argv[0] == "--help" { print(help_text()); return 0 }
    command := argv[0]
    rest := slice(argv, 1, len(argv))
    parsed := parse_tokens(rest)
    json_mode := has_flag(parsed["flags"], "json")
    result := null
    if command == "chat" { result = cmd_chat(rest) }
    else if command == "models" { result = cmd_models(rest) }
    else if command == "agents" { result = cmd_agents(rest) }
    else if command == "missions" { result = cmd_missions(rest) }
    else if command == "runs" { result = cmd_runs(rest) }
    else if command == "tools" { result = cmd_tools(rest) }
    else if command == "benchmark" { result = cmd_benchmark(rest) }
    else if command == "doctor" { result = doctor() }
    else { print(help_text()); return 2 }
    output(result, json_mode)
    if type(result) == "dict" && dict_get_or(result, "ok", true) == false { return 1 }
    return 0
}
