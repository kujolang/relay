from src.common import dict_get_or, env_or, env_bool, string_or, bool_or, int_or, read_json_limited, safe_json, write_json, now_iso, path_is_symlink_safe
from src.contracts import RELAY_VERSION, event_chain_integrity_valid, event_sequence_matches_state, receipt_sequence_valid, receipt_sequence_matches_state, state_integrity_valid
from src.registry import agent_catalog, find_agent, agent_path
from src.adapters import ai_chat, capsule_run
from src.runtime import ensure_dir, create_mission, run_mission, pause_run, cancel_run, cleanup_run, resume_run, execute_tool_request, verify_packet_manifest, state_root, run_root
from src.store import load_run_index, rebuild_run_index, persist_run_index, rebuild_and_persist_run_index_result, store_root_safe
from src.doctor import doctor

func has_flag(flags, name) { return has_key(flags, name) }

func state_store_check() {
    if store_root_safe(state_root()) == false { return {"ok": false, "failure_class": "state_store_failure", "error": "Relay state store root is unsafe"} }
    return {"ok": true}
}

func read_receipt_evidence(run_dir) {
    path := run_dir + "/receipts.json"
    # A missing receipt file must not silently fall back to the copy embedded
    # in state.json. The file is the persisted evidence boundary; accepting the
    # state fallback would let an incomplete run appear fully receipted.
    if path_is_symlink_safe(path) || path_exists(path) == false || path_is_file(path) == false || file_size(path) > 8388608 {
        return {"ok": false, "receipts": [], "error": "run receipt evidence is missing, non-regular, symbolic-linked, or exceeds the 8 MiB inspection limit"}
    }
    receipts := read_json_limited(path, null, 8388608)
    if type(receipts) != "array" {
        return {"ok": false, "receipts": [], "error": "run receipt evidence is invalid JSON"}
    }
    return {"ok": true, "receipts": receipts}
}

func read_run_state_evidence(run_dir, run_id) {
    path := run_dir + "/state.json"
    if path_is_symlink_safe(path) || path_exists(path) == false || path_is_file(path) == false || file_size(path) > 67108864 {
        return {"ok": false, "state": {}, "error": "run state evidence is missing, non-regular, symbolic-linked, or exceeds the 64 MiB inspection limit"}
    }
    state := read_json_limited(path, null, 67108864)
    if type(state) != "dict" {
        return {"ok": false, "state": {}, "error": "run state evidence is invalid JSON"}
    }
    if string_or(dict_get_or(state, "run_id", ""), "") != string_or(run_id, "") {
        return {"ok": false, "state": {}, "error": "run state evidence identity does not match the requested run"}
    }
    if state_integrity_valid(state) == false {
        return {"ok": false, "state": {}, "error": "run state evidence integrity verification failed"}
    }
    return {"ok": true, "state": state}
}

func read_run_artifact_evidence(run_dir, name, expected_type, max_bytes) {
    path := run_dir + "/" + name
    limit := int_or(max_bytes, 8388608)
    if path_is_symlink_safe(path) || path_exists(path) == false || path_is_file(path) == false || file_size(path) > limit {
        return {"ok": false, "value": null, "error": "run artifact evidence is missing, non-regular, symbolic-linked, or exceeds its inspection limit: " + name}
    }
    value := read_json_limited(path, null, limit)
    if type(value) != expected_type {
        return {"ok": false, "value": null, "error": "run artifact evidence has an invalid JSON shape: " + name}
    }
    return {"ok": true, "value": value}
}

func provider_tool_result_evidence(run_dir, state, run_id) {
    agent_sdk_tools := dict_get_or(state, "agent_sdk_tools", {})
    if bool_or(dict_get_or(agent_sdk_tools, "provider_generated", false), false) == false {
        return {"required": false, "ok": true, "value": null, "error": ""}
    }
    artifact := read_run_artifact_evidence(run_dir, "tool-results.json", "dict", 8388608)
    if dict_get_or(artifact, "ok", false) == false {
        return {"required": true, "ok": false, "value": null, "error": dict_get_or(artifact, "error", "provider tool-result evidence is invalid")}
    }
    bundle := artifact["value"]
    if string_or(dict_get_or(bundle, "contract_version", ""), "") != "relay-tool-result-bundle-v1" || string_or(dict_get_or(bundle, "run_id", ""), "") != string_or(run_id, "") || type(dict_get_or(bundle, "results", null)) != "array" {
        return {"required": true, "ok": false, "value": null, "error": "provider tool-result evidence has an invalid contract or run identity"}
    }
    expected_hash := string_or(dict_get_or(dict_get_or(state, "tool_result_artifact", {}), "integrity_sha256", ""), "")
    actual_hash := sha256_file(run_dir + "/tool-results.json")
    if expected_hash == "" || actual_hash == "" || expected_hash != actual_hash {
        return {"required": true, "ok": false, "value": null, "error": "provider tool-result evidence integrity does not match authoritative run state"}
    }
    return {"required": true, "ok": true, "value": bundle, "error": ""}
}

func report_matches_state(report, state, run_id) {
    if type(report) != "dict" || type(state) != "dict" { return false }
    if string_or(dict_get_or(report, "run_id", ""), "") != string_or(run_id, "") { return false }
    if string_or(dict_get_or(report, "mission_id", ""), "") != string_or(dict_get_or(state, "mission_id", ""), "") { return false }
    return string_or(dict_get_or(report, "status", ""), "") == string_or(dict_get_or(state, "status", ""), "")
}

func report_markdown_valid(run_dir) {
    path := run_dir + "/report.md"
    return path_is_symlink_safe(path) == false && path_exists(path) && path_is_file(path) && file_size(path) <= 8388608
}

func positional(values, index, fallback) {
    if type(values) != "array" || index < 0 || index >= len(values) { return fallback }
    return values[index]
}

func parse_tokens(tokens) {
    positionals := []
    flags := {}
    mut i := 0
    while i < len(tokens) {
        token := tokens[i]
        if starts_with(token, "--") {
            key := substring(token, 2, len(token))
            if key == "json" || key == "stream" || key == "fixture" || key == "offline" || key == "help" || key == "skip-agent-smoke" || key == "confirm" || key == "hashes" {
                flags[key] := true
            } else if i + 1 < len(tokens) && starts_with(tokens[i + 1], "--") == false {
                flags[key] := tokens[i + 1]
                i = i + 1
            } else { flags[key] := "" }
        } else { positionals := push(positionals, token) }
        i = i + 1
    }
    return {"positionals": positionals, "flags": flags}
}

func output(payload, json_mode) {
    if type(payload) == "dict" && has_key(payload, "_streamed") { return }
    if type(payload) == "dict" && has_key(payload, "_stream_events") {
        for item in payload["_stream_events"] { print(safe_json(item)) }
        return
    }
    if json_mode { print(safe_json(payload)); return }
    if type(payload) == "dict" {
        if has_key(payload, "error") { print("error: " + to_string(payload["error"])); return }
        if has_key(payload, "ok") { print("ok: " + to_string(payload["ok"])) }
        if has_key(payload, "path") { print("path: " + to_string(payload["path"])) }
        if has_key(payload, "run_dir") { print("run_dir: " + to_string(payload["run_dir"])) }
        if has_key(payload, "status") { print("status: " + to_string(payload["status"])) }
        if has_key(payload, "run") && type(payload["run"]) == "dict" { print("run: " + to_string(dict_get_or(payload["run"], "run_id", ""))) }
    } else { print(to_string(payload)) }
}

func help_text() {
    return "Relay " + RELAY_VERSION + " — Kujo-native mission composition runtime\n\n" +
        "Usage: relay <chat|models|agents|missions|runs|benchmark|doctor> ...\n\n" +
        "  chat <prompt> [--model <id>] [--provider <id>] [--fixture] [--stream] [--json]\n" +
        "  models list|inspect <model>|probe <model> [--fixture]\n" +
        "  agents list|inspect <agent>|validate\n" +
        "  doctor [--repair] [--json]\n" +
        "  missions create [spec.json] [--output path]\n" +
        "  missions run <spec.json> [--fixture] [--pause-after-plan] [--skip-agent-smoke] [--json]\n" +
        "  missions inspect <run-id>|pause <run-id>|resume <run-id>|repair <run-id>|cancel <run-id>|cleanup <run-id> --confirm|report <run-id>\n" +
        "  runs list [--after run-id] [--limit n]|rebuild|inspect <run-id>|verify <run-id>|events <run-id> [--after event-id] [--limit n]|watch <run-id>|sizes <run-id>|changes <run-id>|evaluations <run-id>|export <run-id> [--partial] [--output path]\n" +
        "  tools execute --json (bounded Agents SDK worker callback)\n" +
        "  benchmark run <repo> [--json] (Capsule discovery slice)"
}

func cmd_chat(tokens) {
    parsed := parse_tokens(tokens)
    if len(parsed["positionals"]) == 0 { return {"ok": false, "error": "chat requires a prompt"} }
    prompt := join(parsed["positionals"], " ")
    model := string_or(dict_get_or(parsed["flags"], "model", "fixture-model"), "fixture-model")
    provider := string_or(dict_get_or(parsed["flags"], "provider", "fixture"), "fixture")
    offline := has_flag(parsed["flags"], "fixture") || has_flag(parsed["flags"], "offline") || env_bool("RELAY_OFFLINE_FIXTURE", true)
    result := ai_chat([{"role": "user", "content": prompt}], model, provider, offline, has_flag(parsed["flags"], "stream"))
    if has_flag(parsed["flags"], "stream") {
        events := []
        raw := dict_get_or(result, "raw", {})
        stream_events := dict_get_or(raw, "stream_events", [])
        if type(stream_events) == "array" {
            for source_event in stream_events {
                if type(source_event) != "dict" { continue }
                choices := dict_get_or(source_event, "choices", [])
                if type(choices) != "array" || len(choices) == 0 { continue }
                choice := choices[0]
                delta := dict_get_or(choice, "delta", {})
                content := dict_get_or(delta, "content", "")
                if type(content) == "string" && content != "" { events := push(events, {"type": "delta", "content": content, "done": false}) }
            }
        }
        if len(events) == 0 {
            content := dict_get_or(result, "output_text", dict_get_or(result, "content", dict_get_or(result, "response", "")))
            if content != "" { events := push(events, {"type": "delta", "content": content, "done": false}) }
        }
        events := push(events, {"type": "done", "ok": dict_get_or(result, "ok", false), "usage": dict_get_or(result, "usage", {}), "telemetry": dict_get_or(result, "relay_telemetry", {})})
        return {"ok": dict_get_or(result, "ok", false), "_stream_events": events, "result": result}
    }
    return result
}

func cmd_models(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "list")
    models := [
        {"id": "fixture-model", "provider": "fixture", "capabilities": ["chat", "streaming", "structured_output"], "tool_planning": false, "tool_execution": "declared_mission_only", "offline": true, "source": "built_in_fixture"},
        {"id": env_or("RELAY_MODEL", "gpt-4.1-mini"), "provider": env_or("RELAY_PROVIDER", "openai-compatible"), "capabilities": ["chat", "streaming", "provider_tool_planning"], "tool_planning": "opt_in_provider_profile", "tool_execution": "policy_bound_agents_sdk", "offline": false, "source": "environment_profile"}
    ]
    if sub == "inspect" { for model in models { if model["id"] == positional(parsed["positionals"], 1, "") { return {"ok": true, "model": model} } }; return {"ok": false, "error": "unknown model"} }
    if sub == "probe" {
        model := string_or(positional(parsed["positionals"], 1, env_or("RELAY_MODEL", "fixture-model")), "fixture-model")
        provider := string_or(dict_get_or(parsed["flags"], "provider", env_or("RELAY_PROVIDER", "fixture")), "fixture")
        offline := has_flag(parsed["flags"], "fixture") || has_flag(parsed["flags"], "offline") || env_bool("RELAY_OFFLINE_FIXTURE", true)
        result := ai_chat([{"role": "user", "content": "Reply with exactly: relay-probe-ok"}], model, provider, offline, false)
        return {"ok": dict_get_or(result, "ok", false), "model": model, "provider": provider, "offline": offline, "routing": {"mode": "explicit_profile", "reason": "model and provider were selected from command flags or environment defaults", "tool_planning": false, "tool_execution": "declared_mission_only"}, "result": result}
    }
    return {"ok": true, "models": models, "routing": {"mode": "explicit_profile", "reason": "model and provider are selected explicitly; fallback is visible in run evidence", "tool_planning": false, "tool_execution": "declared_mission_only"}}
}

func cmd_agents(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "list")
    if sub == "inspect" {
        agent := find_agent(positional(parsed["positionals"], 1, ""))
        if type(agent) == "null" { return {"ok": false, "error": "unknown agent"} }
        agent["source_path"] := agent_path(agent["id"])
        agent["source_exists"] := path_is_dir(agent_path(agent["id"]))
        return {"ok": true, "agent": agent}
    }
    if sub == "validate" {
        errors := []
        for agent in agent_catalog() { if path_is_dir(agent_path(agent["id"])) == false { errors := push(errors, agent["id"] + " source path missing") } }
        return {"ok": len(errors) == 0, "errors": errors, "count": len(agent_catalog())}
    }
    return {"ok": true, "agents": agent_catalog(), "source": env_or("KUJO_AGENTS_PATH", "../kujo-agents") + "/chain-of-command"}
}

func cmd_missions(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "help")
    if sub == "create" {
        source := positional(parsed["positionals"], 1, "")
        return create_mission(source, string_or(dict_get_or(parsed["flags"], "output", ""), ""))
    }
    if sub == "run" {
        path := positional(parsed["positionals"], 1, "")
        if path == "" { return {"ok": false, "error": "missions run requires a spec path"} }
        offline := has_flag(parsed["flags"], "fixture")
        if env_bool("RELAY_OFFLINE_FIXTURE", true) { offline = true }
        return run_mission(path, {"offline_fixture": offline, "stream": has_flag(parsed["flags"], "stream"), "pause_after_plan": has_flag(parsed["flags"], "pause-after-plan"), "agents_sdk_smoke": has_flag(parsed["flags"], "skip-agent-smoke") == false})
    }
    id := positional(parsed["positionals"], 1, "")
    store_check := state_store_check()
    if store_check["ok"] == false { return store_check }
    index := load_run_index(state_root())
    if sub == "pause" { return pause_run(id) }
    if sub == "cancel" { return cancel_run(id) }
    if sub == "cleanup" { return cleanup_run(id, has_flag(parsed["flags"], "confirm")) }
    if sub == "resume" { return resume_run(id, false) }
    if sub == "repair" { return resume_run(id, true) }
    if sub == "inspect" || sub == "report" {
        record := dict_get_or(index, id, null)
        if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + id} }
        state_evidence := read_run_state_evidence(record["run_dir"], id)
        if dict_get_or(state_evidence, "ok", false) == false { return {"ok": false, "failure_class": "evidence_failure", "error": dict_get_or(state_evidence, "error", "run state evidence is invalid")} }
        state := state_evidence["state"]
        if sub == "report" {
            report_evidence := read_run_artifact_evidence(record["run_dir"], "report.json", "dict", 8388608)
            report_ok := dict_get_or(report_evidence, "ok", false) && report_matches_state(dict_get_or(report_evidence, "value", {}), state, id) && report_markdown_valid(record["run_dir"])
            if report_ok == false { return {"ok": false, "failure_class": "evidence_failure", "error": "report evidence is missing, malformed, or does not match authoritative state"} }
            return {"ok": true, "report_json": record["run_dir"] + "/report.json", "report_markdown": record["run_dir"] + "/report.md", "status": dict_get_or(state, "status", "unknown")}
        }
        return {"ok": true, "run": state, "run_dir": record["run_dir"]}
    }
    return {"ok": false, "error": "unknown missions command"}
}

func watch_run_events(record, run_id, flags) {
    run_dir := string_or(dict_get_or(record, "run_dir", ""), "")
    timeout_ms := int_or(dict_get_or(flags, "timeout-ms", 120000), 120000)
    poll_ms := int_or(dict_get_or(flags, "poll-ms", 50), 50)
    if timeout_ms <= 0 || timeout_ms > 600000 { return {"ok": false, "error": "watch timeout-ms must be between 1 and 600000"} }
    if poll_ms <= 0 || poll_ms > 1000 { return {"ok": false, "error": "watch poll-ms must be between 1 and 1000"} }
    events_path := run_dir + "/events.jsonl"
    started_ms := current_timestamp()
    mut emitted := 0
    mut terminal_status := ""
    mut events := []
    mut last_raw := ""
    mut partial_start := 0
    mut saw_events_file := false
    mut chain_checked_raw := ""
    while current_timestamp() - started_ms <= timeout_ms {
        event_symlink := path_is_symlink_safe(events_path)
        event_exists := path_exists(events_path)
        if event_symlink || (event_exists && path_is_file(events_path) == false) {
            print(safe_json({"type": "relay_watch_error", "error": "run event log is a symbolic link or non-regular file"}))
            return {"ok": false, "_streamed": true}
        }
        if event_exists == false {
            if saw_events_file {
                print(safe_json({"type": "relay_watch_error", "error": "run event log disappeared"}))
                return {"ok": false, "_streamed": true}
            }
        }
        if event_exists && file_size(events_path) > 8388608 {
            print(safe_json({"type": "relay_watch_error", "error": "run event log exceeds the 8 MiB inspection limit"}))
            return {"ok": false, "_streamed": true}
        }
        if event_exists {
            saw_events_file = true
            raw := read_file(events_path)
            if raw != last_raw {
                # The event file is append-only for a run. Reject replacement or
                # truncation, then parse only the changed suffix plus any line
                # that was incomplete during the previous poll. This keeps
                # parsing work proportional to new events while the full event
                # chain is verified whenever the stream changes.
                if last_raw != "" && starts_with(raw, last_raw) == false {
                    print(safe_json({"type": "relay_watch_error", "error": "run event log was replaced or truncated"}))
                    return {"ok": false, "_streamed": true}
                }
                chunk := substring(raw, partial_start, len(raw))
                lines := split(chunk, "\n")
                complete_count := len(lines)
                if ends_with(chunk, "\n") == false { complete_count = complete_count - 1 }
                mut i := 0
                while i < complete_count {
                    line := trim(lines[i])
                    if line != "" {
                        try { events = push(events, parse_json(line)) } except err {
                            print(safe_json({"type": "relay_watch_error", "error": "run event log contains invalid JSON"}))
                            return {"ok": false, "_streamed": true}
                        }
                    }
                    i = i + 1
                }
                if ends_with(raw, "\n") { partial_start = len(raw) }
                else {
                    mut cursor := len(raw) - 1
                    while cursor >= 0 && substring(raw, cursor, cursor + 1) != "\n" { cursor = cursor - 1 }
                    partial_start = cursor + 1
                }
                last_raw = raw
            }
        }
        if last_raw != chain_checked_raw {
            if event_chain_integrity_valid(events) == false {
                print(safe_json({"type": "relay_watch_error", "error": "run event chain integrity verification failed"}))
                return {"ok": false, "_streamed": true}
            }
            chain_checked_raw = last_raw
        }
        while emitted < len(events) {
            print(safe_json(events[emitted]))
            emitted = emitted + 1
        }
        state_evidence := read_run_state_evidence(run_dir, run_id)
        if dict_get_or(state_evidence, "ok", false) == false {
            print(safe_json({"type": "relay_watch_error", "error": dict_get_or(state_evidence, "error", "run state evidence is invalid")}))
            return {"ok": false, "_streamed": true}
        }
        state := state_evidence["state"]
        terminal_status = string_or(dict_get_or(state, "status", ""), "")
        if (terminal_status == "completed" || terminal_status == "failed" || terminal_status == "cancelled") && emitted == len(events) {
            state_events := dict_get_or(state, "events", [])
            # Runtime state and the append-only file can cross the watcher
            # between the final state transition and the final JSONL append.
            # Wait for the authoritative sequence to catch up instead of
            # misclassifying this short handoff window as corruption.
            if type(state_events) == "array" && len(state_events) != len(events) {
                sleep(poll_ms)
                continue
            }
            state_consistent := event_sequence_matches_state(state_events, events)
            receipt_evidence := read_receipt_evidence(run_dir)
            receipts := dict_get_or(receipt_evidence, "receipts", [])
            receipts_valid := dict_get_or(receipt_evidence, "ok", false) && receipt_sequence_valid(receipts)
            receipts_consistent := receipts_valid && receipt_sequence_matches_state(dict_get_or(state, "receipts", []), receipts)
            if state_consistent == false || receipts_valid == false || receipts_consistent == false {
                print(safe_json({"type": "relay_watch_error", "error": "terminal run evidence is inconsistent", "state_consistent": state_consistent, "receipts_valid": receipts_valid, "receipts_consistent": receipts_consistent, "receipt_error": dict_get_or(receipt_evidence, "error", "")}))
                return {"ok": false, "_streamed": true}
            }
            return {"ok": terminal_status == "completed", "_streamed": true, "events": emitted, "status": terminal_status}
        }
        sleep(poll_ms)
    }
    print(safe_json({"type": "relay_watch_error", "error": "run watch timed out", "timeout_ms": timeout_ms, "events": emitted}))
    return {"ok": false, "_streamed": true}
}

func artifact_inventory(path, relative, max_entries, max_bytes, depth, include_hashes) {
    if depth > 16 { return {"ok": false, "error": "run artifact inventory exceeds the 16-level directory depth limit"} }
    if path_is_symlink_safe(path) { return {"ok": false, "error": "run artifact inventory encountered a symbolic link: " + relative} }
    if path_is_dir(path) {
        mut entries := []
        mut total_bytes := 0
        mut files := 0
        mut directories := 1
        names := sort(list_dir(path))
        if len(names) > max_entries { return {"ok": false, "error": "run artifact inventory exceeds the entry limit"} }
        for name in names {
            child := artifact_inventory(path + "/" + name, relative + "/" + name, max_entries, max_bytes, depth + 1, include_hashes)
            if dict_get_or(child, "ok", false) == false { return child }
            child_entries := dict_get_or(child, "entries", [])
            if type(child_entries) == "array" {
                for entry in child_entries { entries := push(entries, entry) }
            }
            total_bytes := total_bytes + int_or(dict_get_or(child, "bytes", 0), 0)
            files := files + int_or(dict_get_or(child, "files", 0), 0)
            directories := directories + int_or(dict_get_or(child, "directories", 0), 0)
            if len(entries) > max_entries { return {"ok": false, "error": "run artifact inventory exceeds the entry limit"} }
            if total_bytes > max_bytes { return {"ok": false, "error": "run artifact inventory exceeds the total byte limit"} }
        }
        return {"ok": true, "entries": entries, "bytes": total_bytes, "files": files, "directories": directories}
    }
    if path_is_file(path) == false { return {"ok": false, "error": "run artifact inventory encountered an unsupported path: " + relative} }
    bytes := file_size(path)
    if bytes > max_bytes { return {"ok": false, "error": "run artifact inventory exceeds the total byte limit"} }
    entry := {"path": relative, "kind": "file", "bytes": bytes}
    if bool_or(include_hashes, false) { entry["integrity_sha256"] := sha256_file(path) }
    return {"ok": true, "entries": [entry], "bytes": bytes, "files": 1, "directories": 0}
}

func run_artifact_sizes(record, run_id, flags) {
    run_dir := string_or(dict_get_or(record, "run_dir", ""), "")
    if run_dir == "" || path_is_dir(run_dir) == false || path_is_symlink_safe(run_dir) { return {"ok": false, "error": "run artifact directory is missing or unsafe"} }
    mut entries := []
    mut total_bytes := 0
    mut files := 0
    mut directories := 0
    mut excluded := [{"path": "workspace", "reason": "repository workspace excluded from artifact inventory", "present": path_exists(run_dir + "/workspace")}]
    for name in sort(list_dir(run_dir)) {
        if name == "workspace" {
            continue
        }
        child := artifact_inventory(run_dir + "/" + name, name, 4096, 8388608, 0, has_flag(flags, "hashes"))
        if dict_get_or(child, "ok", false) == false { return child }
        child_entries := dict_get_or(child, "entries", [])
        if type(child_entries) == "array" {
            for entry in child_entries { entries := push(entries, entry) }
        }
        total_bytes := total_bytes + int_or(dict_get_or(child, "bytes", 0), 0)
        files := files + int_or(dict_get_or(child, "files", 0), 0)
        directories := directories + int_or(dict_get_or(child, "directories", 0), 0)
        if len(entries) > 4096 { return {"ok": false, "error": "run artifact inventory exceeds the entry limit"} }
        if total_bytes > 8388608 { return {"ok": false, "error": "run artifact inventory exceeds the total byte limit"} }
    }
    return {"ok": true, "format": "relay-run-sizes-v1", "run_id": run_id, "run_dir": run_dir, "generated_at": now_iso(), "hashes_included": bool_or(has_flag(flags, "hashes"), false), "summary": {"bytes": total_bytes, "files": files, "directories": directories}, "entries": entries, "excluded": excluded}
}

func event_window(events, flags) {
    if type(events) != "array" { return {"ok": false, "error": "event window source is invalid"} }
    after := string_or(dict_get_or(flags, "after", ""), "")
    limit_value := dict_get_or(flags, "limit", 0)
    limit := 0
    if has_key(flags, "limit") == 0 { limit = 0 }
    else if type(limit_value) == "string" && trim(limit_value) != "" {
        limit = int_or(limit_value, -1)
    } else {
        limit = int_or(limit_value, -1)
    }
    if (has_key(flags, "limit") && (limit <= 0 || limit > 4096)) { return {"ok": false, "error": "event limit must be between 1 and 4096"} }
    mut start := 0
    if after != "" {
        mut found := false
        mut i := 0
        while i < len(events) {
            if string_or(dict_get_or(events[i], "event_id", ""), "") == after {
                start = i + 1
                found = true
                break
            }
            i = i + 1
        }
        if found == false { return {"ok": false, "error": "event cursor was not found in the verified run"} }
    }
    end := len(events)
    if limit > 0 && start + limit < end { end = start + limit }
    window := []
    mut cursor := start
    while cursor < end {
        window = push(window, events[cursor])
        cursor = cursor + 1
    }
    next_after := ""
    if len(window) > 0 { next_after = string_or(dict_get_or(window[len(window) - 1], "event_id", ""), "") }
    return {"ok": true, "events": window, "event_count": len(events), "offset": start, "has_more": end < len(events), "next_after": next_after}
}

func run_window(index, flags) {
    if type(index) != "dict" { return {"ok": false, "error": "run index is invalid"} }
    after := string_or(dict_get_or(flags, "after", ""), "")
    limit_value := dict_get_or(flags, "limit", 0)
    limit := 0
    if has_key(flags, "limit") == 0 { limit = 0 }
    else { limit = int_or(limit_value, -1) }
    if has_key(flags, "limit") && (limit <= 0 || limit > 4096) { return {"ok": false, "error": "run limit must be between 1 and 4096"} }
    run_ids := sort(keys(index))
    mut start := 0
    if after != "" {
        mut found := false
        mut i := 0
        while i < len(run_ids) {
            if run_ids[i] == after {
                start = i + 1
                found = true
                break
            }
            i = i + 1
        }
        if found == false { return {"ok": false, "error": "run cursor was not found in the validated index"} }
    }
    end := len(run_ids)
    if limit > 0 && start + limit < end { end = start + limit }
    window := {}
    mut cursor := start
    while cursor < end {
        window[run_ids[cursor]] := index[run_ids[cursor]]
        cursor = cursor + 1
    }
    next_after := ""
    if end > start { next_after = run_ids[end - 1] }
    return {"ok": true, "runs": window, "run_count": len(run_ids), "offset": start, "has_more": end < len(run_ids), "next_after": next_after}
}

func cmd_runs(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "list")
    store_check := state_store_check()
    if store_check["ok"] == false { return store_check }
    index := load_run_index(state_root())
    id := positional(parsed["positionals"], 1, "")
    if sub == "list" {
        response := {"ok": true, "runs": index, "index_source": "validated_cache_or_rebuild"}
        if has_key(parsed["flags"], "after") || has_key(parsed["flags"], "limit") {
            window := run_window(index, parsed["flags"])
            if dict_get_or(window, "ok", false) == false { return window }
            response["runs"] := window["runs"]
            response["run_count"] := window["run_count"]
            response["offset"] := window["offset"]
            response["has_more"] := window["has_more"]
            response["next_after"] := window["next_after"]
        }
        return response
    }
    if sub == "rebuild" {
        rebuilt_result := rebuild_and_persist_run_index_result(state_root())
        if dict_get_or(rebuilt_result, "ok", false) == false { return {"ok": false, "failure_class": "state_store_failure", "runs": dict_get_or(rebuilt_result, "index", {}), "index_source": "rebuild", "error": dict_get_or(rebuilt_result, "error", "Run index persistence failed")} }
        return {"ok": true, "runs": dict_get_or(rebuilt_result, "index", {}), "index_source": "rebuild", "persisted": true}
    }
    record := dict_get_or(index, id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + id} }
    if sub == "verify" {
        state_evidence := read_run_state_evidence(record["run_dir"], id)
        if dict_get_or(state_evidence, "ok", false) == false {
            return {"ok": false, "format": "relay-run-verification-v1", "run_id": id, "integrity_valid": false, "state_valid": false, "error": dict_get_or(state_evidence, "error", "run state evidence is invalid")}
        }
        events_result := cmd_runs(["events", id])
        if dict_get_or(events_result, "ok", false) == false {
            return {"ok": false, "format": "relay-run-verification-v1", "run_id": id, "integrity_valid": false, "state_valid": true, "events_valid": dict_get_or(events_result, "integrity_valid", false), "receipts_valid": dict_get_or(events_result, "receipts_valid", false), "receipts_consistent": dict_get_or(events_result, "receipts_consistent", false), "error": dict_get_or(events_result, "error", "run event evidence is invalid")}
        }
        changes := read_run_artifact_evidence(record["run_dir"], "changes.json", "dict", 8388608)
        evaluations := read_run_artifact_evidence(record["run_dir"], "evaluations.json", "array", 8388608)
        report := read_run_artifact_evidence(record["run_dir"], "report.json", "dict", 8388608)
        tool_results := provider_tool_result_evidence(record["run_dir"], state_evidence["state"], id)
        packet_manifest := verify_packet_manifest(record["run_dir"], state_evidence["state"])
        changes_valid := dict_get_or(changes, "ok", false)
        evaluations_valid := dict_get_or(evaluations, "ok", false)
        report_valid := dict_get_or(report, "ok", false) && report_matches_state(dict_get_or(report, "value", {}), state_evidence["state"], id) && report_markdown_valid(record["run_dir"])
        tool_results_valid := dict_get_or(tool_results, "ok", false)
        packet_manifest_valid := dict_get_or(packet_manifest, "ok", false)
        valid := changes_valid && evaluations_valid && report_valid && tool_results_valid && packet_manifest_valid
        return {"ok": valid, "format": "relay-run-verification-v1", "run_id": id, "status": dict_get_or(state_evidence["state"], "status", "unknown"), "integrity_valid": valid, "state_valid": true, "events_valid": true, "receipts_valid": dict_get_or(events_result, "receipts_valid", false), "receipts_consistent": dict_get_or(events_result, "receipts_consistent", false), "changes_valid": changes_valid, "evaluations_valid": evaluations_valid, "report_valid": report_valid, "tool_results_required": dict_get_or(tool_results, "required", false), "tool_results_valid": tool_results_valid, "packet_manifest_required": dict_get_or(packet_manifest, "required", false), "packet_manifest_valid": packet_manifest_valid, "errors": [dict_get_or(changes, "error", ""), dict_get_or(evaluations, "error", ""), dict_get_or(report, "error", ""), dict_get_or(tool_results, "error", ""), dict_get_or(packet_manifest, "error", "")]}
    }
    if sub == "watch" { return watch_run_events(record, id, parsed["flags"]) }
    if sub == "sizes" { return run_artifact_sizes(record, id, parsed["flags"]) }
    if sub == "inspect" {
        state_evidence := read_run_state_evidence(record["run_dir"], id)
        if dict_get_or(state_evidence, "ok", false) == false {
            return {"ok": false, "failure_class": "evidence_failure", "error": dict_get_or(state_evidence, "error", "run state evidence is invalid")}
        }
        return {"ok": true, "run": state_evidence["state"], "run_dir": record["run_dir"]}
    }
    if sub == "events" || sub == "export" {
        events_path := record["run_dir"] + "/events.jsonl"
        if path_is_symlink_safe(events_path) || path_exists(events_path) == false || path_is_file(events_path) == false || file_size(events_path) > 8388608 { return {"ok": false, "error": "run event log is missing, non-regular, symbolic-linked, or exceeds the 8 MiB inspection limit", "integrity_valid": false, "state_consistent": false} }
        raw_events := read_file(events_path)
        events := []
        for line in split(raw_events, "\n") {
            if trim(line) == "" { continue }
            try { events = push(events, parse_json(line)) } except err { return {"ok": false, "error": "run event log contains invalid JSON", "integrity_valid": false} }
        }
        state_evidence := read_run_state_evidence(record["run_dir"], id)
        if dict_get_or(state_evidence, "ok", false) == false {
            return {"ok": false, "error": dict_get_or(state_evidence, "error", "run state evidence is invalid"), "integrity_valid": false, "state_consistent": false, "receipts_valid": false, "receipts_consistent": false}
        }
        state := state_evidence["state"]
        chain_valid := event_chain_integrity_valid(events)
        state_consistent := event_sequence_matches_state(dict_get_or(state, "events", []), events)
        receipt_evidence := read_receipt_evidence(record["run_dir"])
        receipts := dict_get_or(receipt_evidence, "receipts", [])
        receipts_valid := dict_get_or(receipt_evidence, "ok", false) && receipt_sequence_valid(receipts)
        receipts_consistent := receipts_valid && receipt_sequence_matches_state(dict_get_or(state, "receipts", []), receipts)
        valid := chain_valid && state_consistent && receipts_valid && receipts_consistent
        event_bundle := {"integrity_valid": valid, "chain_integrity_valid": chain_valid, "state_consistent": state_consistent, "receipts_valid": receipts_valid, "receipts_consistent": receipts_consistent, "receipt_error": dict_get_or(receipt_evidence, "error", ""), "events": events, "events_jsonl": raw_events, "event_count": len(events), "offset": 0, "has_more": false, "next_after": ""}
        if sub == "events" {
            if valid == false { event_bundle["ok"] := false; return event_bundle }
            window := event_window(events, parsed["flags"])
            if dict_get_or(window, "ok", false) == false { return {"ok": false, "integrity_valid": true, "chain_integrity_valid": chain_valid, "state_consistent": state_consistent, "receipts_valid": receipts_valid, "receipts_consistent": receipts_consistent, "error": dict_get_or(window, "error", "event window is invalid")} }
            event_bundle["events"] := window["events"]
            event_bundle["events_jsonl"] := ""
            event_bundle["event_count"] := window["event_count"]
            event_bundle["offset"] := window["offset"]
            event_bundle["has_more"] := window["has_more"]
            event_bundle["next_after"] := window["next_after"]
            event_bundle["ok"] := true
            return event_bundle
        }
        if valid == false { event_bundle["ok"] := false; event_bundle["error"] := "run event integrity verification failed"; return event_bundle }
        changes_evidence := read_run_artifact_evidence(record["run_dir"], "changes.json", "dict", 8388608)
        evaluations_evidence := read_run_artifact_evidence(record["run_dir"], "evaluations.json", "array", 8388608)
        report_evidence := read_run_artifact_evidence(record["run_dir"], "report.json", "dict", 8388608)
        tool_results_evidence := provider_tool_result_evidence(record["run_dir"], state, id)
        packet_manifest_evidence := verify_packet_manifest(record["run_dir"], state)
        changes_valid := dict_get_or(changes_evidence, "ok", false)
        evaluations_valid := dict_get_or(evaluations_evidence, "ok", false)
        report_valid := dict_get_or(report_evidence, "ok", false) && report_matches_state(dict_get_or(report_evidence, "value", {}), state, id) && report_markdown_valid(record["run_dir"])
        tool_results_valid := dict_get_or(tool_results_evidence, "ok", false)
        packet_manifest_valid := dict_get_or(packet_manifest_evidence, "ok", false)
        if changes_valid == false || evaluations_valid == false || report_valid == false || tool_results_valid == false || packet_manifest_valid == false {
            partial_requested := has_flag(parsed["flags"], "partial")
            run_status := string_or(dict_get_or(state, "status", "unknown"), "unknown")
            if partial_requested && run_status != "completed" {
                partial_bundle := {"format": "relay-run-export-partial-v1", "run_id": id, "integrity_valid": false, "completeness": "partial", "partial": true, "status": run_status, "state_valid": true, "events_valid": true, "receipts_valid": receipts_valid, "receipts_consistent": receipts_consistent, "artifact_presence": {"changes": changes_valid, "evaluations": evaluations_valid, "report": report_valid, "tool_results": tool_results_valid, "packet_manifest": packet_manifest_valid}, "artifact_errors": [dict_get_or(changes_evidence, "error", ""), dict_get_or(evaluations_evidence, "error", ""), dict_get_or(report_evidence, "error", ""), dict_get_or(tool_results_evidence, "error", ""), dict_get_or(packet_manifest_evidence, "error", "")], "run": state, "events": events, "receipts": receipts, "changes": dict_get_or(changes_evidence, "value", null), "evaluations": dict_get_or(evaluations_evidence, "value", null), "report": dict_get_or(report_evidence, "value", null), "tool_results": dict_get_or(tool_results_evidence, "value", null), "packet_manifest": dict_get_or(packet_manifest_evidence, "value", null)}
                output_path := string_or(dict_get_or(parsed["flags"], "output", ""), "")
                if output_path != "" {
                    if write_json(output_path, partial_bundle) == false { return {"ok": false, "error": "partial run export could not be written"} }
                    return {"ok": true, "output": output_path, "run_id": id, "format": "relay-run-export-partial-v1", "integrity_valid": false, "completeness": "partial"}
                }
                partial_bundle["ok"] := true
                return partial_bundle
            }
            event_bundle["ok"] := false
            event_bundle["error"] := "run export evidence is incomplete"
            event_bundle["partial_export_available"] := run_status != "completed"
            event_bundle["changes_valid"] := changes_valid
            event_bundle["evaluations_valid"] := evaluations_valid
            event_bundle["report_valid"] := report_valid
            event_bundle["artifact_errors"] := [dict_get_or(changes_evidence, "error", ""), dict_get_or(evaluations_evidence, "error", ""), dict_get_or(report_evidence, "error", ""), dict_get_or(tool_results_evidence, "error", ""), dict_get_or(packet_manifest_evidence, "error", "")]
            event_bundle["tool_results_valid"] := tool_results_valid
            event_bundle["packet_manifest_valid"] := packet_manifest_valid
            return event_bundle
        }
        bundle := {"format": "relay-run-export-v1", "run_id": id, "integrity_valid": true, "chain_integrity_valid": chain_valid, "state_consistent": state_consistent, "receipts_valid": receipts_valid, "receipts_consistent": receipts_consistent, "changes_valid": true, "evaluations_valid": true, "report_valid": true, "tool_results_required": dict_get_or(tool_results_evidence, "required", false), "tool_results_valid": true, "packet_manifest_required": dict_get_or(packet_manifest_evidence, "required", false), "packet_manifest_valid": true, "run": state, "events": events, "receipts": receipts, "changes": changes_evidence["value"], "evaluations": evaluations_evidence["value"], "report": report_evidence["value"], "tool_results": dict_get_or(tool_results_evidence, "value", null), "packet_manifest": dict_get_or(packet_manifest_evidence, "value", null)}
        output_path := string_or(dict_get_or(parsed["flags"], "output", ""), "")
        if output_path != "" {
            if write_json(output_path, bundle) == false { return {"ok": false, "error": "run export could not be written"} }
            return {"ok": true, "output": output_path, "run_id": id, "integrity_valid": true}
        }
        bundle["ok"] := true
        return bundle
    }
    if sub == "changes" || sub == "evaluations" {
        state_evidence := read_run_state_evidence(record["run_dir"], id)
        if dict_get_or(state_evidence, "ok", false) == false {
            return {"ok": false, "failure_class": "evidence_failure", "error": dict_get_or(state_evidence, "error", "run state evidence is invalid")}
        }
        artifact_name := "changes.json"
        expected_type := "dict"
        if sub == "evaluations" { artifact_name = "evaluations.json"; expected_type = "array" }
        artifact := read_run_artifact_evidence(record["run_dir"], artifact_name, expected_type, 8388608)
        if dict_get_or(artifact, "ok", false) == false {
            return {"ok": false, "failure_class": "evidence_failure", "error": dict_get_or(artifact, "error", "run artifact evidence is invalid")}
        }
        if sub == "changes" { return {"ok": true, "changes": artifact["value"]} }
        return {"ok": true, "evaluations": artifact["value"]}
    }
    return {"ok": false, "error": "unknown runs command"}
}

func cmd_benchmark(tokens) {
    parsed := parse_tokens(tokens)
    repo := positional(parsed["positionals"], 1, ".")
    result := capsule_run(repo, state_root() + "/capsule")
    result["benchmark"] := "capsule-discovery"
    return result
}

func cmd_tools(tokens) {
    parsed := parse_tokens(tokens)
    sub := positional(parsed["positionals"], 0, "")
    if sub != "execute" { return {"ok": false, "error": "unknown tools command"} }
    raw := env("RELAY_TOOL_REQUEST")
    if type(raw) == "null" || trim(to_string(raw)) == "" { return {"ok": false, "error": "RELAY_TOOL_REQUEST is required"} }
    raw := to_string(raw)
    if len(raw) > 131072 { return {"ok": false, "error": "RELAY_TOOL_REQUEST exceeds the 128 KiB safety limit"} }
    request := null
    try { request = parse_json(raw) } except err { return {"ok": false, "error": "RELAY_TOOL_REQUEST is invalid JSON"} }
    if type(request) != "dict" { return {"ok": false, "error": "RELAY_TOOL_REQUEST must be a JSON object"} }
    return execute_tool_request(request, dict_get_or(parsed["flags"], "capability", ""))
}

export func main(argv) {
    if len(argv) == 0 || argv[0] == "help" || argv[0] == "--help" { print(help_text()); return 0 }
    if argv[0] == "version" || argv[0] == "--version" { print("relay " + RELAY_VERSION); return 0 }
    command := argv[0]
    rest := slice(argv, 1, len(argv))
    parsed := parse_tokens(rest)
    json_mode := has_flag(parsed["flags"], "json")
    result := null
    if command == "chat" { result = cmd_chat(rest) }
    else if command == "models" { result = cmd_models(rest) }
    else if command == "agents" { result = cmd_agents(rest) }
    else if command == "missions" { result = cmd_missions(rest) }
    else if command == "runs" { result = cmd_runs(rest) }
    else if command == "tools" { result = cmd_tools(rest) }
    else if command == "benchmark" { result = cmd_benchmark(rest) }
    else if command == "doctor" { result = doctor(has_flag(parsed["flags"], "repair")) }
    else { print(help_text()); return 2 }
    output(result, json_mode)
    if type(result) == "dict" && dict_get_or(result, "ok", true) == false { return 1 }
    return 0
}
