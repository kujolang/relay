from src.common import dict_get_or, env_or, env_bool, string_or, bool_or, int_or, safe_json, read_json_or, redact_text, process_options, safe_env_name, contains_any, path_is_symlink_safe, path_has_symlink_component, issue_agent_capability, revoke_agent_capability
from src.policy import real_path, path_is_within_root
from src.watchdog import watchdog_verify, safe_base, route_policy, safe_correlation_id

func bounded_max_tokens(value, fallback) {
    candidate := int_or(value, int_or(fallback, 700))
    if candidate <= 0 { return 0 }
    if candidate > 16384 { return 16384 }
    return candidate
}

func relay_root() {
    raw := env_or("RELAY_ROOT", env_or("PWD", "."))
    if starts_with(raw, "/") { return raw }
    resolved := real_path(raw)
    if resolved != "" { return resolved }
    return raw
}

func rooted_path(value) {
    candidate := string_or(value, "")
    if candidate == "" || starts_with(candidate, "/") { return candidate }
    root := relay_root()
    rooted := root + "/" + candidate
    resolved := real_path(rooted)
    if resolved != "" { return resolved }
    return rooted
}

func trusted_path(env_name, fallback, regular_file) {
    raw := env_or(env_name, fallback)
    candidate := raw
    if starts_with(candidate, "/") == false { candidate = relay_root() + "/" + candidate }
    if path_is_symlink_safe(candidate) || path_has_symlink_component(candidate) { return "" }
    if regular_file && path_is_file(candidate) == false { return "" }
    if regular_file == false && path_exists(candidate) == false { return "" }
    resolved := real_path(candidate)
    if resolved == "" || path_has_symlink_component(resolved) { return "" }
    if path_is_symlink_safe(resolved) { return "" }
    if regular_file && path_is_file(resolved) == false { return "" }
    return resolved
}

func trusted_executable(env_name, fallback) { return trusted_path(env_name, fallback, true) }
func trusted_file(env_name, fallback) { return trusted_path(env_name, fallback, true) }

func kujo_bin() { return trusted_executable("KUJO_BIN", relay_root() + "/../kujo/target/release/kujo") }
func repo_root() { return rooted_path(env_or("RELAY_REPO_ROOT", relay_root() + "/..")) }
func ai_sdk_root() { return rooted_path(env_or("RELAY_AI_SDK_PATH", relay_root() + "/../ai-sdk")) }
func agents_sdk_root() { return rooted_path(env_or("RELAY_AGENTS_SDK_PATH", relay_root() + "/../agents-sdk")) }
func watchdog_url() { return env_or("RELAY_WATCHDOG_URL", "") }
func watchdog_route_allowed(value) { return safe_base(value) }

func ai_bridge_path() {
    root := real_path(relay_root())
    if root == "" { return "" }
    configured := env_or("RELAY_AI_BRIDGE", relay_root() + "/src/ai_bridge.kujo")
    candidate := configured
    if starts_with(candidate, "/") == false { candidate = relay_root() + "/" + candidate }
    if path_is_symlink_safe(candidate) || path_has_symlink_component(candidate) || path_is_file(candidate) == false { return "" }
    resolved := real_path(candidate)
    if resolved == "" || ends_with(resolved, ".kujo") == false || path_is_within_root(resolved, root) == false { return "" }
    return resolved
}

func last_json(raw) {
    text := trim(to_string(raw))
    if text == "" { return null }
    try { return parse_json(text) } except err {}
    lines := split(text, "\n")
    i := len(lines) - 1
    while i >= 0 {
        candidate := trim(lines[i])
        if candidate != "" {
            try { return parse_json(candidate) } except err {}
        }
        i := i - 1
    }
    return null
}

func run_process(command, cwd, extra_env, timeout_ms) {
    started_ms := current_timestamp()
    mut process_env := extra_env
    if type(process_env) != "dict" { process_env = {} }
    effective_cwd := rooted_path(cwd)
    resolved_cwd := ""
    # `/usr/bin/env -C` changes the kernel cwd, but some Kujo module resolution
    # paths also consult PWD. Keep both views aligned for sibling-tool probes
    # and adapters so a dependency cannot accidentally import Relay's `src/`
    # tree merely because the caller launched it from Relay.
    if effective_cwd != "" {
        resolved_cwd = real_path(effective_cwd)
        if resolved_cwd == "" { resolved_cwd = effective_cwd }
        process_env["PWD"] := resolved_cwd
    }
    options := process_options(process_env, timeout_ms, 8 * 1024 * 1024)
    if effective_cwd != "" {
        if has_key(options["env"], "PWD") == 0 { options["env_allow"] := push(options["env_allow"], "PWD") }
        env_options := options["env"]
        env_options["PWD"] := resolved_cwd
        options["env"] := env_options
    }
    actual_command := command
    if effective_cwd != "" {
        actual_command := ["/usr/bin/env", "-C", effective_cwd]
        for item in command { actual_command := push(actual_command, item) }
    }
    try {
        raw := spawn_process(actual_command, options)
        return {"success": raw.success, "exit_code": raw.exitcode, "stdout": redact_text(raw.stdout), "stderr": redact_text(raw.stderr), "timed_out": raw.timed_out, "stdout_truncated": raw.stdout_truncated, "stderr_truncated": raw.stderr_truncated, "duration_ms": current_timestamp() - started_ms}
    } except err {
        return {"success": false, "exit_code": 3, "stdout": "", "stderr": redact_text(to_string(err)), "timed_out": false, "stdout_truncated": false, "stderr_truncated": false, "duration_ms": current_timestamp() - started_ms}
    }
}

func tool_schema(tool_name) {
    if tool_name == "relay.list_files" {
        return {
            "type": "function",
            "function": {
                "name": "relay.list_files",
                "description": "List one bounded page of Git-tracked workspace files. Use offset to continue when has_more is true.",
                "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "offset": {"type": "integer", "minimum": 0, "description": "Optional file offset; defaults to 0."}
                    }
                }
            }
        }
    }
    if tool_name == "relay.read_file" {
        return {
            "type": "function",
            "function": {
                "name": "relay.read_file",
                "description": "Read a bounded chunk of one Git-workspace-relative UTF-8 text file. Use offset to continue when output_truncated is true.",
                "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path"],
                    "properties": {
                        "path": {"type": "string", "description": "Workspace-relative tracked file path."},
                        "offset": {"type": "integer", "minimum": 0, "description": "Optional character offset; defaults to 0."}
                    }
                }
            }
        }
    }
    if tool_name == "relay.write_file" {
        return {
            "type": "function",
            "function": {
                "name": "relay.write_file",
                "description": "Write one approved UTF-8 text file inside the isolated mission workspace.",
                "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "content"],
                    "properties": {
                        "path": {"type": "string", "description": "Workspace-relative file path."},
                        "content": {"type": "string", "description": "Complete replacement file contents."}
                    }
                }
            }
        }
    }
    if tool_name == "relay.run_command" {
        return {
            "type": "function",
            "function": {
                "name": "relay.run_command",
                "description": "Run one explicitly allowlisted read-oriented command in the isolated mission workspace.",
                "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["command"],
                    "properties": {
                        "command": {"type": "string", "description": "One shell-free allowlisted validation command. Do not use it to list or read files; use relay.list_files and relay.read_file."},
                        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}
                    }
                }
            }
        }
    }
    return null
}

func tool_definitions(allowlist) {
    if type(allowlist) != "array" { return [] }
    definitions := []
    for tool_name in allowlist {
        schema := tool_schema(string_or(tool_name, ""))
        if type(schema) == "dict" { definitions := push(definitions, schema) }
    }
    return definitions
}

func canonical_provider_tool_name(value) {
    name := string_or(value, "")
    if name == "list_files" || name == "relay_list_files" { return "relay.list_files" }
    if name == "read_file" || name == "relay_read_file" { return "relay.read_file" }
    if name == "write_file" || name == "relay_write_file" { return "relay.write_file" }
    if name == "run_command" || name == "relay_run_command" { return "relay.run_command" }
    if name == "submit_answer" || name == "relay_submit_answer" { return "relay.submit_answer" }
    return name
}

func normalize_provider_tool_calls(raw_calls) {
    if type(raw_calls) != "array" { return {"ok": false, "error": "provider tool call payload must be an array"} }
    calls := []
    seen_ids := {}
    mut call_index := 0
    for item in raw_calls {
        if type(item) != "dict" { return {"ok": false, "error": "provider tool call must be an object"} }
        function := dict_get_or(item, "function", {})
        if type(function) != "dict" { function = {} }
        name := canonical_provider_tool_name(dict_get_or(item, "tool_name", dict_get_or(item, "name", dict_get_or(function, "name", ""))))
        raw_input := dict_get_or(item, "input", dict_get_or(item, "arguments", dict_get_or(function, "arguments", {})))
        input := raw_input
        if type(raw_input) == "string" {
            try { input = parse_json(raw_input) } except err { return {"ok": false, "error": "provider tool arguments are not valid JSON", "tool_name": name} }
        }
        if name == "" || type(input) != "dict" { return {"ok": false, "error": "provider tool call is missing a valid name or object input", "tool_name": name} }
        if len(safe_json(input)) > 65536 { return {"ok": false, "error": "provider tool arguments exceed the 64 KiB safety limit", "tool_name": name} }
        provider_call_id := string_or(dict_get_or(item, "id", ""), "")
        if provider_call_id == "" { provider_call_id = "relay-call-" + to_string(call_index) }
        if len(provider_call_id) > 256 || contains(provider_call_id, "\n") || contains(provider_call_id, "\r") || contains(provider_call_id, "\t") { return {"ok": false, "error": "provider tool call ID is invalid", "tool_name": name} }
        if has_key(seen_ids, provider_call_id) { return {"ok": false, "error": "provider tool call IDs must be unique", "tool_name": name} }
        seen_ids[provider_call_id] := true
        calls := push(calls, {"name": name, "input": input, "provider_call_id": provider_call_id})
        call_index = call_index + 1
    }
    return {"ok": true, "calls": calls}
}

func provider_payload_size(payload) {
    return len(safe_json(payload))
}

func provider_payload_allowed(payload) {
    return provider_payload_size(payload) <= 114688
}

func safe_watchdog_upstream_profile(value) {
    profile := string_or(value, "")
    if profile == "" { return true }
    if len(profile) > 128 { return false }
    mut index := 0
    while index < len(profile) {
        character := substring(profile, index, index + 1)
        if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-", character) < 0 { return false }
        index = index + 1
    }
    return true
}

func call_ai_with_tools(messages, model, provider, base_url, api_key_env, offline, stream, correlation_id, tools, max_tokens) {
    if offline == false && watchdog_url() == "" {
        return {"ok": false, "error": {"code": "watchdog_route_required", "message": "Live AI calls require RELAY_WATCHDOG_URL"}, "relay_telemetry": {"route": "blocked_no_watchdog", "provider": provider, "model": model}}
    }
    if offline == false && watchdog_route_allowed(watchdog_url()) == false {
        return {"ok": false, "error": {"code": "invalid_watchdog_route", "message": "RELAY_WATCHDOG_URL must be an http(s) URL without embedded credentials"}, "relay_telemetry": {"route": "blocked_invalid_watchdog_url", "provider": provider, "model": model}}
    }
    if safe_env_name(api_key_env) == false {
        return {"ok": false, "error": {"code": "invalid_api_key_env", "message": "RELAY_API_KEY_ENV must be a safe non-reserved environment variable name"}, "relay_telemetry": {"route": "blocked_invalid_env", "provider": provider, "model": model}}
    }
    request_max_tokens := bounded_max_tokens(max_tokens, 700)
    if request_max_tokens <= 0 {
        return {"ok": false, "error": {"code": "token_budget_exhausted", "message": "AI request token budget must be greater than zero"}, "relay_telemetry": {"route": "blocked_token_budget", "provider": provider, "model": model}}
    }
    requested_correlation := string_or(correlation_id, env_or("RELAY_CORRELATION_ID", ""))
    correlation := safe_correlation_id(requested_correlation)
    if correlation == "" { correlation = "relay-ai-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999)) }
    payload := {
        "provider_id": "custom",
        "model": model,
        "base_url": base_url,
        "api_key_env": api_key_env,
        "messages": messages,
        "temperature": 0.2,
        "max_tokens": request_max_tokens,
        "max_retries": 0,
        "timeout": 180.0,
        "read_timeout": 180.0,
        "overall_timeout_ms": 210000,
        "offline_fixture": offline,
        "correlation_id": correlation
    }
    if stream { payload["stream"] := true }
    if type(tools) == "array" && len(tools) > 0 {
        payload["tools"] := tools
        payload["tool_choice"] := "auto"
    }
    if provider_payload_allowed(payload) == false {
        return {"ok": false, "error": {"code": "ai_payload_too_large", "message": "AI request payload exceeds the 112 KiB Relay safety limit"}, "relay_telemetry": {"route": "blocked_payload_size", "provider": provider, "model": model, "payload_bytes": provider_payload_size(payload)}}
    }
    watchdog_profile := env_or("RELAY_WATCHDOG_UPSTREAM_PROFILE", "")
    if safe_watchdog_upstream_profile(watchdog_profile) == false {
        return {"ok": false, "error": {"code": "invalid_watchdog_upstream_profile", "message": "RELAY_WATCHDOG_UPSTREAM_PROFILE must contain only letters, digits, dot, underscore, or hyphen and be at most 128 characters"}, "relay_telemetry": {"route": "blocked_invalid_watchdog_upstream_profile", "provider": provider, "model": model}}
    }
    env_map := {"RELAY_AI_PAYLOAD": safe_json(payload), "AI_SDK_PATH": ai_sdk_root()}
    watchdog_token := env_or("RELAY_WATCHDOG_PROXY_TOKEN", "")
    if watchdog_token != "" { env_map["RELAY_WATCHDOG_PROXY_TOKEN"] := watchdog_token }
    if watchdog_profile != "" { env_map["RELAY_WATCHDOG_UPSTREAM_PROFILE"] := watchdog_profile }
    allow_insecure_localhost := env_or("KUJO_AI_SDK_ALLOW_INSECURE_LOCALHOST", "")
    if allow_insecure_localhost != "" { env_map["KUJO_AI_SDK_ALLOW_INSECURE_LOCALHOST"] := allow_insecure_localhost }
    api_key := env(api_key_env)
    if type(api_key) != "null" { env_map[api_key_env] := api_key }
    bridge := ai_bridge_path()
    if bridge == "" {
        return {"ok": false, "error": {"code": "invalid_ai_bridge_path", "message": "RELAY_AI_BRIDGE must resolve to a regular, non-symlinked Kujo file inside Relay"}, "relay_telemetry": {"route": "blocked_invalid_bridge", "provider": provider, "model": model}}
    }
    command := ["/usr/bin/env", "-C", ai_sdk_root(), kujo_bin(), "run", bridge, "--interpreter"]
    result := run_process(command, "", env_map, 240000)
    parsed := last_json(dict_get_or(result, "stdout", ""))
    if type(parsed) != "dict" {
        if bool_or(dict_get_or(result, "timed_out", false), false) {
            return {"ok": false, "error": {"code": "ai_bridge_timeout", "message": "AI bridge exceeded its 240-second process timeout"}, "raw": result}
        }
        return {"ok": false, "error": {"code": "ai_bridge_parse_error", "message": dict_get_or(result, "stderr", "No JSON response")}, "raw": result}
    }
    route := "direct_ai_sdk"
    if watchdog_url() != "" && offline == false { route = "watchdog_proxy" }
    route_posture := route_policy(watchdog_url())
    parsed["relay_telemetry"] := {"route": route, "watchdog_route": {"configured": dict_get_or(route_posture, "configured", false), "valid": dict_get_or(route_posture, "valid", false), "scheme": dict_get_or(route_posture, "scheme", ""), "reason": dict_get_or(route_posture, "reason", "")}, "watchdog_auth_configured": watchdog_token != "", "watchdog_upstream_profile_configured": watchdog_profile != "", "provider": provider, "model": model, "stream_requested": stream, "requested_max_tokens": request_max_tokens, "correlation_id": correlation, "duration_ms": int_or(dict_get_or(result, "duration_ms", 0), 0)}
    if offline == false && env_bool("RELAY_WATCHDOG_VERIFY", false) {
        verification := watchdog_verify(correlation, dict_get_or(parsed, "usage", {}), string_or(dict_get_or(parsed, "request_id", ""), ""))
        parsed["relay_watchdog_verification"] := verification
        telemetry := dict_get_or(parsed, "relay_telemetry", {})
        telemetry["watchdog_verification"] := {"ok": dict_get_or(verification, "ok", false), "correlation_matched": dict_get_or(dict_get_or(verification, "correlation", {}), "matched", false), "usage_matched": dict_get_or(dict_get_or(verification, "usage_reconciliation", {}), "matched", false)}
        parsed["relay_telemetry"] := telemetry
        if dict_get_or(parsed, "ok", false) && verification["ok"] == false {
            parsed["ok"] := false
            parsed["error"] := {"code": "watchdog_telemetry_unverified", "message": "Watchdog health, proxy configuration, or request correlation verification failed"}
        }
    }
    return parsed
}

func call_ai(messages, model, provider, base_url, api_key_env, offline, stream, correlation_id) {
    return call_ai_with_tools(messages, model, provider, base_url, api_key_env, offline, stream, correlation_id, [], 700)
}

func ai_chat(messages, model, provider, offline, stream) {
    return ai_chat_correlated(messages, model, provider, offline, stream, "")
}

func fallback_allowed(result) {
    code := to_lower(string_or(dict_get_or(dict_get_or(result, "error", {}), "code", ""), ""))
    if code == "" { return false }
    return contains_any(code, ["timeout", "timed_out", "rate", "429", "allowance", "provider_unavailable", "temporarily_unavailable", "overloaded", "model_not_found", "connection", "network", "provider_response_too_large"])
}

func fallback_decision(result, primary_model, fallback_model) {
    primary_id := string_or(primary_model, "")
    fallback_id := string_or(fallback_model, "")
    if dict_get_or(result, "ok", false) {
        return {"action": "none", "reason": "primary_succeeded", "primary_model": primary_id, "fallback_model": fallback_id}
    }
    reason := string_or(dict_get_or(dict_get_or(result, "error", {}), "code", "primary_failed"), "primary_failed")
    if fallback_id == "" {
        return {"action": "skipped", "reason": "fallback_not_configured", "failure_class": reason, "primary_model": primary_id, "fallback_model": fallback_id}
    }
    if fallback_id == primary_id {
        return {"action": "skipped", "reason": "fallback_matches_primary", "failure_class": reason, "primary_model": primary_id, "fallback_model": fallback_id}
    }
    if fallback_allowed(result) == false {
        return {"action": "skipped", "reason": reason, "failure_class": reason, "primary_model": primary_id, "fallback_model": fallback_id}
    }
    return {"action": "attempt", "reason": reason, "failure_class": reason, "primary_model": primary_id, "fallback_model": fallback_id}
}

func ai_chat_correlated(messages, model, provider, offline, stream, correlation_id) {
    return ai_chat_correlated_with_tools(messages, model, provider, offline, stream, correlation_id, [], 700)
}

func ai_chat_correlated_with_tools(messages, model, provider, offline, stream, correlation_id, tools, max_tokens) {
    base := watchdog_url()
    if base == "" { base = "https://api.openai.com/v1" }
    api_key_env := env_or("RELAY_API_KEY_ENV", "OPENAI_API_KEY")
    primary := call_ai_with_tools(messages, model, provider, base, api_key_env, offline, stream, correlation_id, tools, max_tokens)
    fallback_model := env_or("RELAY_FALLBACK_MODEL", "")
    if dict_get_or(primary, "ok", false) == false {
        decision := fallback_decision(primary, model, fallback_model)
        if decision["action"] == "attempt" {
            fallback := call_ai_with_tools(messages, fallback_model, provider, base, api_key_env, offline, stream, correlation_id, tools, max_tokens)
            telemetry := dict_get_or(fallback, "relay_telemetry", {})
            telemetry["fallback_from"] := model
            telemetry["fallback_reason"] := decision["reason"]
            telemetry["fallback_decision"] := decision
            fallback["relay_telemetry"] := telemetry
            return fallback
        }
        telemetry := dict_get_or(primary, "relay_telemetry", {})
        telemetry["fallback_skipped_reason"] := decision["reason"]
        telemetry["fallback_decision"] := decision
        primary["relay_telemetry"] := telemetry
    }
    return primary
}

func agents_sdk_smoke() {
    command := ["/usr/bin/env", "-C", agents_sdk_root(), kujo_bin(), "run", "examples/examples_smoke_runner.kujo", "--interpreter"]
    result := run_process(command, "", {}, 120000)
    return {"ok": dict_get_or(result, "success", false), "data": last_json(dict_get_or(result, "stdout", "")), "stdout": dict_get_or(result, "stdout", ""), "stderr": dict_get_or(result, "stderr", ""), "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

func agents_sdk_tool_run(workspace, spec, run_id, session_id) {
    tools := dict_get_or(spec, "agent_tools", [])
    mission_spec := spec
    mission_spec["allow_writes"] := bool_or(dict_get_or(spec, "allow_writes", false), false)
    mission_spec["budgets"] := dict_get_or(spec, "budgets", {})
    # The capability must not be derivable from public run/workspace IDs. The
    # worker receives this nonce only through the short-lived parent/child
    # environment boundary and Relay verifies it again at the tool authority.
    capability_nonce := sha256(run_id + "|" + session_id + "|" + workspace + "|" + to_string(current_timestamp()) + "|" + to_string(random_int(1000, 999999)))
    tool_budgets := dict_get_or(spec, "budgets", {})
    max_tool_calls := int_or(dict_get_or(tool_budgets, "max_tool_calls", 4), 4)
    if max_tool_calls < 1 { max_tool_calls = 1 }
    if max_tool_calls > 16 { max_tool_calls = 16 }
    issued := issue_agent_capability(relay_root(), run_id, session_id, workspace, capability_nonce, max_tool_calls, 180000)
    if dict_get_or(issued, "ok", false) == false { return {"ok": false, "data": {"ok": false, "error": dict_get_or(issued, "error", {"code": "capability_registry_unavailable"})}, "stdout": "", "stderr": "capability registry unavailable", "duration_ms": 0} }
    payload := {
        "relay_root": relay_root(),
        "kujo_bin": kujo_bin(),
        "capability": sha256(run_id + "|" + session_id + "|" + workspace + "|" + capability_nonce + "|relay-agent-tools"),
        "capability_nonce": capability_nonce,
        "capability_secret": dict_get_or(issued, "secret", ""),
        "run_id": run_id,
        "session_id": session_id,
        "workspace": workspace,
        "agent_id": string_or(dict_get_or(spec, "agent", "core-developer"), "core-developer"),
        "agent_name": "Relay mission agent",
        "prompt": string_or(dict_get_or(spec, "goal", "Execute approved Relay tools"), "Execute approved Relay tools"),
        "output_text": "Relay mission Agents SDK tool execution",
        "tool_calls": tools,
        "approval_approved": bool_or(dict_get_or(dict_get_or(spec, "approval", {}), "approved", false), false),
        "mission_spec": mission_spec
    }
    env_map := {"RELAY_AGENT_PAYLOAD": safe_json(payload), "RELAY_ROOT": relay_root(), "KUJO_BIN": kujo_bin()}
    configured_state_root := env_or("RELAY_STATE_ROOT", "")
    if configured_state_root != "" { env_map["RELAY_STATE_ROOT"] := configured_state_root }
    command := ["/usr/bin/env", "-C", agents_sdk_root(), kujo_bin(), "run", relay_root() + "/src/agent_bridge.kujo", "--interpreter"]
    result := run_process(command, "", env_map, 120000)
    revoke_agent_capability(relay_root(), run_id, session_id)
    parsed := last_json(dict_get_or(result, "stdout", ""))
    ok := dict_get_or(result, "success", false)
    if type(parsed) != "dict" || dict_get_or(parsed, "ok", false) == false { ok = false }
    return {"ok": ok, "data": parsed, "stdout": dict_get_or(result, "stdout", ""), "stderr": dict_get_or(result, "stderr", ""), "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

func packwrite_generate(run_dir, prompt_path, packet_path) {
    packwrite := trusted_executable("RELAY_PACKWRITE_BIN", relay_root() + "/../packwrite/bin/packwrite")
    fake_file := trusted_file("RELAY_PACKWRITE_FAKE_RESPONSE", relay_root() + "/examples/packwrite-response.json")
    command := ["/usr/bin/env", "-C", run_dir, packwrite, "init", prompt_path, "--output", "agent", "--overwrite"]
    result := run_process(command, "", {"KUJO": kujo_bin(), "PACKWRITE_FAKE_RESPONSE_FILE": fake_file}, 120000)
    artifact_dir := run_dir + "/agent"
    master_path := artifact_dir + "/MASTER.md"
    artifact_safe := path_is_dir(artifact_dir) && path_is_symlink_safe(artifact_dir) == false && path_has_symlink_component(artifact_dir) == false && path_is_file(master_path) && path_is_symlink_safe(master_path) == false && path_has_symlink_component(master_path) == false
    ok := dict_get_or(result, "success", false) && artifact_safe
    error := ""
    if ok == false && dict_get_or(result, "success", false) { error = "PackWrite completed without a safe MASTER.md artifact" }
    return {"ok": ok, "command": command, "stdout": dict_get_or(result, "stdout", ""), "stderr": dict_get_or(result, "stderr", ""), "artifact_dir": artifact_dir, "packet_path": packet_path, "artifact_safe": artifact_safe, "error": error, "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

func runledger_start(run_dir, model, provider, task, repo) {
    ledger := run_dir + "/ledger"
    command := ["/usr/bin/env", "-C", run_dir, trusted_executable("RELAY_RUNLEDGER_BIN", relay_root() + "/../runledger/bin/runledger"), "start", "--model", model, "--provider", provider, "--task", task, "--repo", repo, "--ledger", ledger]
    result := run_process(command, "", {"KUJO": kujo_bin()}, 60000)
    output := dict_get_or(result, "stdout", "")
    run_id := ""
    for line in split(output, "\n") {
        if starts_with(trim(line), "Started run: ") { run_id = trim(substring(trim(line), 13, len(trim(line)))) }
    }
    return {"ok": dict_get_or(result, "success", false), "run_id": run_id, "ledger": ledger, "output": output, "error": dict_get_or(result, "stderr", ""), "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

func runledger_finish(run_dir, run_id, status, verdict, notes) {
    command := ["/usr/bin/env", "-C", run_dir, trusted_executable("RELAY_RUNLEDGER_BIN", relay_root() + "/../runledger/bin/runledger"), "finish", run_id, "--status", status, "--verdict", verdict, "--notes", notes, "--ledger", run_dir + "/ledger"]
    result := run_process(command, "", {"KUJO": kujo_bin()}, 60000)
    return {"ok": dict_get_or(result, "success", false), "output": dict_get_or(result, "stdout", ""), "error": dict_get_or(result, "stderr", ""), "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

func changebucket(repo, run_dir) {
    command := ["/usr/bin/env", trusted_executable("RELAY_CHANGEBUCKET_BIN", relay_root() + "/../changebucket/bin/changebucket"), "--json", "--repo", repo]
    kujo_modules := real_path(relay_root() + "/../kujo/modules")
    if kujo_modules == "" { kujo_modules = relay_root() + "/../kujo/modules" }
    result := run_process(command, run_dir, {"KUJO": kujo_bin(), "KUJO_MODULE_PATH": kujo_modules}, 60000)
    return {"ok": dict_get_or(result, "success", false), "data": last_json(dict_get_or(result, "stdout", "")), "stdout": dict_get_or(result, "stdout", ""), "stderr": dict_get_or(result, "stderr", ""), "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

func eval_run(run_dir, config_path) {
    command := ["/usr/bin/env", "-C", run_dir, kujo_bin(), "run", trusted_file("RELAY_EVAL_ENTRY", relay_root() + "/../eval/main.kujo"), "--", "run", config_path, "--json"]
    result := run_process(command, "", {}, 120000)
    return {"ok": dict_get_or(result, "success", false), "data": last_json(dict_get_or(result, "stdout", "")), "stdout": dict_get_or(result, "stdout", ""), "stderr": dict_get_or(result, "stderr", ""), "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

func capsule_run(repo, output_dir) {
    capsule := trusted_executable("RELAY_CAPSULE_BIN", relay_root() + "/../benchmarks-capsule/bin/capsule")
    result := run_process(["/usr/bin/env", capsule, "make", repo, "--out", output_dir, "--stable"], "", {"KUJO": kujo_bin()}, 120000)
    return {"ok": dict_get_or(result, "success", false), "stdout": dict_get_or(result, "stdout", ""), "stderr": dict_get_or(result, "stderr", ""), "artifacts": output_dir, "duration_ms": dict_get_or(result, "duration_ms", 0)}
}

