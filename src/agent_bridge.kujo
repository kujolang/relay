# Agents SDK bridge executed with the Agents SDK checkout as its working
# directory. The SDK owns registry, approval, and runner semantics; Relay owns
# policy and repository authority through the bounded tools worker callback.
from src.common import path_is_symlink_safe, path_has_symlink_component, redact_text, safe_env_name
from src.agents.ai.adapter import create_ai_sdk_adapter
from src.agents.runner import create_agent_runner, run_agent
from src.agents.core_types import create_agent, create_agent_run_request
from src.agents.tools.registry import create_tool_registry, register_tool

func get(obj, key, fallback) {
    if type(obj) == "dict" && has_key(obj, key) { return obj[key] }
    return fallback
}

func json_safe(value) {
    if type(value) == "function" { return null }
    if type(value) == "dict" {
        safe_map := {}
        for key in keys(value) { safe_map[key] := json_safe(value[key]) }
        return safe_map
    }
    if type(value) == "array" {
        safe_items := []
        for item in value { safe_items = push(safe_items, json_safe(item)) }
        return safe_items
    }
    return value
}

func redact_json(value) {
    if type(value) == "string" { return redact_text(value) }
    if type(value) == "dict" {
        redacted := {}
        for key in keys(value) { redacted[key] := redact_json(value[key]) }
        return redacted
    }
    if type(value) == "array" {
        redacted_items := []
        for item in value { redacted_items := push(redacted_items, redact_json(item)) }
        return redacted_items
    }
    return value
}

func last_json(raw) {
    text := trim(to_string(raw))
    try { return parse_json(text) } except err {}
    candidate_lines := split(text, "\n")
    i := len(candidate_lines) - 1
    while i >= 0 {
        candidate := trim(candidate_lines[i])
        if candidate != "" {
            try { return parse_json(candidate) } except err {}
        }
        i = i - 1
    }
    return null
}

func process_options(extra_env, timeout_ms) {
    env_map := {}
    allowed := []
    env_map["PATH"] := "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    allowed := push(allowed, "PATH")
    for name in ["HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL"] {
        value := env(name)
        if type(value) != "null" { env_map[name] := value; allowed := push(allowed, name) }
    }
    for name in keys(extra_env) {
        if name == "PATH" { continue }
        if safe_env_name(name) == false { continue }
        env_map[name] := extra_env[name]
        allowed := push(allowed, name)
    }
    env_map["PATH"] := "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    if index_of(allowed, "PATH") < 0 { allowed := push(allowed, "PATH") }
    return {"inherit_env": false, "timeout_ms": timeout_ms, "max_output_bytes": 8388608, "env": env_map, "env_allow": allowed}
}

func call_relay_worker(tool_name, input_payload, context, payload) {
    configured_relay_root := to_string(env("RELAY_ROOT"))
    if configured_relay_root == "" { configured_relay_root = "." }
    configured_kujo_bin := to_string(env("KUJO_BIN"))
    if configured_kujo_bin == "" { configured_kujo_bin = configured_relay_root + "/../kujo/target/release/kujo" }
    requested_relay_root := to_string(get(payload, "relay_root", configured_relay_root))
    requested_kujo_bin := to_string(get(payload, "kujo_bin", configured_kujo_bin))
    if requested_relay_root != configured_relay_root { return {"ok": false, "error": {"code": "relay_root_mismatch", "message": "Agents SDK worker root must match trusted RELAY_ROOT"}} }
    if requested_kujo_bin != configured_kujo_bin { return {"ok": false, "error": {"code": "kujo_bin_mismatch", "message": "Agents SDK worker binary must match trusted KUJO_BIN"}} }
    if path_is_dir(configured_relay_root) == false || path_is_symlink_safe(configured_relay_root) || path_has_symlink_component(configured_relay_root) || path_exists(configured_relay_root + "/main.kujo") == false || path_is_symlink_safe(configured_relay_root + "/main.kujo") || path_has_symlink_component(configured_relay_root + "/main.kujo") { return {"ok": false, "error": {"code": "relay_root_invalid", "message": "Trusted Relay worker root is missing or unsafe"}} }
    relay_root := configured_relay_root
    kujo_bin := configured_kujo_bin
    capability := to_string(get(payload, "capability", ""))
    clean_input := {}
    if tool_name == "relay.write_file" { clean_input = {"path": to_string(get(input_payload, "path", "")), "content": to_string(get(input_payload, "content", ""))} }
    if tool_name == "relay.run_command" { clean_input = {"command": to_string(get(input_payload, "command", "")), "timeout_ms": get(input_payload, "timeout_ms", 120000)} }
    raw_spec := get(payload, "mission_spec", {})
    clean_spec := {"allow_writes": get(raw_spec, "allow_writes", false), "approval": get(raw_spec, "approval", {}), "allowed_commands": get(raw_spec, "allowed_commands", ["git", "kujo"]), "allowed_script_hashes": get(raw_spec, "allowed_script_hashes", {}), "budgets": get(raw_spec, "budgets", {})}
    request := {
        "tool_name": tool_name,
        "input": clean_input,
        "run_id": get(payload, "run_id", ""),
        "session_id": get(payload, "session_id", ""),
        "capability_nonce": get(payload, "capability_nonce", ""),
        "agent_id": get(context, "agent_id", ""),
        "workspace": get(payload, "workspace", ""),
        "mission_spec": clean_spec,
        "capability": capability
    }
    budgets := get(raw_spec, "budgets", {})
    max_tool_calls := get(budgets, "max_tool_calls", 4)
    if type(max_tool_calls) != "int" || max_tool_calls < 1 { max_tool_calls = 4 }
    call_count := get(payload, "tool_call_count", 0)
    if type(call_count) != "int" { call_count = 0 }
    if call_count >= max_tool_calls {
        return {"ok": false, "error": {"code": "budget_exceeded", "message": "Agents SDK tool-call budget exceeded"}}
    }
    payload["tool_call_count"] := call_count + 1
    command := ["/usr/bin/env", "-C", relay_root, kujo_bin, "run", relay_root + "/main.kujo", "--", "tools", "execute", "--json"]
    result := spawn_process(command, process_options({"RELAY_TOOL_REQUEST": to_json(request), "RELAY_TOOL_CAPABILITY": capability}, 120000))
    parsed := last_json(result.stdout)
    if type(parsed) != "dict" { return {"ok": false, "error": {"message": "Relay tools worker returned no JSON", "stderr": redact_text(to_string(result.stderr))}} }
    if result.success == false || get(parsed, "ok", false) == false { return {"ok": false, "error": {"message": redact_text(get(get(parsed, "error", {}), "message", "Relay tools worker failed")), "worker_success": result.success, "worker_stdout": redact_text(to_string(result.stdout)), "worker_stderr": redact_text(to_string(result.stderr))}} }
    return {"ok": true, "output": get(parsed, "result", {}), "artifacts": get(parsed, "artifacts", [])}
}

func summarize_agent_result(result) {
    metadata := get(result, "metadata", {})
    calls := get(metadata, "tool_calls", [])
    summaries := []
    for call in calls {
        call_result := get(call, "result", {})
        call_error := get(call_result, "error", {})
        summaries = push(summaries, {"tool_name": get(call, "tool_name", ""), "ok": get(call_result, "ok", false), "output": redact_json(get(call_result, "output", {})), "error_kind": get(call_error, "kind", ""), "error_message": redact_text(get(call_error, "message", ""))})
    }
    error_payload := get(result, "error", {})
    return {"ok": get(result, "status", "failed") == "completed", "status": get(result, "status", "failed"), "output_text": redact_text(get(get(result, "output", {}), "text", get(result, "output_text", ""))), "tool_calls": summaries, "error_kind": get(error_payload, "kind", "")}
}

payload_text := env("RELAY_AGENT_PAYLOAD")
if type(payload_text) == "null" || trim(to_string(payload_text)) == "" { print(to_json({"ok": false, "error": {"code": "missing_agent_payload"}})); exit(1) }
payload_text := to_string(payload_text)
if len(payload_text) > 131072 { print(to_json({"ok": false, "error": {"code": "payload_too_large", "message": "RELAY_AGENT_PAYLOAD exceeds the 128 KiB safety limit"}})); exit(1) }
payload := null
try { payload = parse_json(payload_text) } except err { print(to_json({"ok": false, "error": {"code": "invalid_payload", "message": "RELAY_AGENT_PAYLOAD is invalid JSON"}})); exit(1) }
if type(payload) != "dict" { print(to_json({"ok": false, "error": {"code": "invalid_payload", "message": "RELAY_AGENT_PAYLOAD must be a JSON object"}})); exit(1) }

fake_chat := func(client, messages, request_options) {
    return {"ok": true, "provider": "relay-agent-fixture", "model": get(payload, "model", "fixture-model"), "output_text": get(payload, "output_text", "Relay Agents SDK tool execution"), "tool_calls": get(payload, "tool_calls", []), "usage": {"input_tokens": 0, "output_tokens": 0, "total_tokens": 0}}
}
adapter := create_ai_sdk_adapter({"chat_completion_fn": fake_chat})
runner := create_agent_runner({"ai_adapter": adapter})
agent := create_agent({"id": get(payload, "agent_id", "relay-agent"), "name": get(payload, "agent_name", "Relay Agent")})

registry := create_tool_registry({"metadata": {"owner": "relay", "authority": "policy_worker"}})
write_register := register_tool(registry, {
    "id": "relay.write_file",
    "name": "relay.write_file",
    "description": "Write one approved file through Relay policy.",
    "permissions": ["write"],
    "risk": "high",
    "input_schema": {"type": "object", "required": ["path", "content"], "properties": {"path": {"type": "string"}, "content": {"type": "string"}}},
    "handler": func(input_payload, context) { return call_relay_worker("relay.write_file", input_payload, context, payload) }
})
write_registry := get(write_register, "registry", registry)
command_register := register_tool(write_registry, {
    "id": "relay.run_command",
    "name": "relay.run_command",
    "description": "Run one approved read-oriented command through Relay policy.",
    "permissions": [],
    "risk": "medium",
    "input_schema": {"type": "object", "required": ["command"], "properties": {"command": {"type": "string"}, "timeout_ms": {"type": "integer"}}},
    "handler": func(input_payload, context) { return call_relay_worker("relay.run_command", input_payload, context, payload) }
})
if get(write_register, "ok", false) == false || get(command_register, "ok", false) == false { print(to_json({"ok": false, "error": {"code": "tool_registry_setup_failed"}})); exit(1) }

approval_policy := {"mode": "write_tool"}
approval_provider := {"kind": "deny_all"}
if get(payload, "approval_approved", false) == true { approval_provider = {"kind": "auto"} }
run_request := create_agent_run_request(get(payload, "prompt", "Execute the approved Relay tool plan"), {"run_id": get(payload, "run_id", "relay-agent-run"), "session_id": get(payload, "session_id", "relay-agent-session"), "metadata": {"relay_tool_execution": true}})
registry_final := get(command_register, "registry", get(write_register, "registry", registry))
result := run_agent(runner, agent, run_request, {"tool_registry": registry_final, "approval_policy": approval_policy, "approval_provider": approval_provider, "max_iterations": get(payload, "max_iterations", 4)})
summary := summarize_agent_result(result)
print(to_json(summary))
if get(summary, "ok", false) == false { exit(1) }
