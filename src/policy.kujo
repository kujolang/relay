from src.common import command_args, contains_any, dict_get_or, string_or, process_options, path_is_symlink_safe, path_has_symlink_component

func classify_failure(code) {
    normalized := to_lower(trim(to_string(code)))
    if contains_any(normalized, ["cancel", "aborted"]) { return "cancelled" }
    if contains_any(normalized, ["auth", "unauthorized", "401"]) { return "authentication_failure" }
    if contains_any(normalized, ["rate", "429", "allowance"]) { return "rate_or_allowance_limit" }
    if contains_any(normalized, ["timeout", "timed_out"]) { return "timeout" }
    # Specific policy and permission classes must precede the generic tool
    # class; otherwise `tool_permission_denied` loses the authority signal
    # needed by repair and escalation policy.
    if contains_any(normalized, ["workflow_definition_failure", "invalid_workflow", "workflow_definition"]) { return "workflow_definition_failure" }
    if contains_any(normalized, ["policy_violation", "policy"]) { return "policy_violation" }
    if contains_any(normalized, ["permission", "denied", "forbidden"]) { return "permission_denial" }
    if contains_any(normalized, ["malformed_tool", "invalid_tool_call"]) { return "malformed_tool_call" }
    if contains_any(normalized, ["invalid_model", "malformed_response", "structured_output"]) { return "invalid_model_response" }
    if contains_any(normalized, ["missing_context", "context_missing"]) { return "missing_context" }
    if contains_any(normalized, ["implementation", "code_failure"]) { return "implementation_failure" }
    if contains_any(normalized, ["test", "eval", "evaluation"]) { return "evaluation_failure" }
    if contains_any(normalized, ["repo", "git", "workspace"]) { return "repository_failure" }
    if contains_any(normalized, ["tool", "command"]) { return "tool_failure" }
    return "provider_failure"
}

func repair_allowed(failure_class) {
    normalized := to_lower(trim(to_string(failure_class)))
    return normalized == "timeout" || normalized == "rate_or_allowance_limit" || normalized == "provider_failure" || normalized == "repository_failure" || normalized == "tool_failure" || normalized == "implementation_failure" || normalized == "evaluation_failure"
}

func canonicalize_path(raw_path) {
    value := replace(trim(to_string(raw_path)), "\\", "/")
    absolute := starts_with(value, "/")
    stack := []
    for part in split(value, "/") {
        if part == "" || part == "." { continue }
        if part == ".." {
            if len(stack) > 0 { stack = slice(stack, 0, len(stack) - 1) }
            continue
        }
        stack := push(stack, part)
    }
    joined := join(stack, "/")
    if absolute { return "/" + joined }
    if joined == "" { return "." }
    return joined
}

func path_is_within_root(candidate, root) {
    candidate := canonicalize_path(candidate)
    root := canonicalize_path(root)
    if root == "." { return starts_with(candidate, "/") == false }
    return candidate == root || starts_with(candidate, root + "/")
}

func path_is_safe(root, requested) {
    if type(requested) != "string" || trim(requested) == "" { return false }
    clean := requested
    if starts_with(clean, "/") || contains(clean, "\\") { return false }
    if contains_any(clean, [";", "&&", "||", "|", "`", "$(", ">", "<", "\n", "\r", "\t"]) { return false }
    for segment in split(clean, "/") {
        normalized_segment := to_lower(segment)
        if segment == ".." || normalized_segment == ".env" || starts_with(normalized_segment, ".env.") || normalized_segment == ".git" || normalized_segment == ".relay" || starts_with(normalized_segment, ".ssh") { return false }
    }
    if starts_with(clean, "./") { clean = substring(clean, 2, len(clean)) }
    return path_is_within_root(root + "/" + clean, root)
}

func path_parent(path) {
    i := len(path) - 1
    while i >= 0 {
        if substring(path, i, i + 1) == "/" { return substring(path, 0, i) }
        i = i - 1
    }
    return "."
}

func real_path(path) {
    try {
        result := spawn_process(["realpath", path], process_options({}, 5000, 4096))
        if result.success { return trim(result.stdout) }
    } except err {}
    return ""
}

func path_is_within_workspace(root, requested) {
    if path_is_safe(root, requested) == false { return false }
    root_real := real_path(root)
    if root_real == "" { return false }
    target := root + "/" + requested
    target_real := real_path(target)
    if target_real != "" { return path_is_within_root(target_real, root_real) }
    parent_real := real_path(path_parent(target))
    return parent_real != "" && path_is_within_root(parent_real, root_real)
}

func git_read_argv_allowed(argv) {
    if type(argv) != "array" || len(argv) < 2 || argv[0] != "git" { return false }
    subcommand := argv[1]
    allowed_options := []
    if subcommand == "status" { allowed_options = ["--short", "--porcelain", "--branch", "--untracked-files=no"] }
    else if subcommand == "diff" { allowed_options = ["--check", "--stat", "--name-only", "--name-status"] }
    else if subcommand == "rev-parse" { allowed_options = ["--show-toplevel", "--is-inside-work-tree", "--verify"] }
    else if subcommand == "log" { allowed_options = ["--oneline", "--decorate", "--no-decorate", "--max-count=1", "--max-count=5", "--max-count=10"] }
    else if subcommand == "show" { allowed_options = ["--stat", "--oneline", "--name-only"] }
    else { return false }
    mut i := 2
    while i < len(argv) {
        token := argv[i]
        # Read-only mission commands never accept arbitrary pathspecs. This
        # prevents a permitted Git reader from reaching outside the workspace
        # or from using a path-like option to redirect interpretation.
        if starts_with(token, "-") == false { return false }
        matched := false
        for option in allowed_options { if token == option { matched = true } }
        if matched == false { return false }
        i = i + 1
    }
    return true
}

func script_argv_allowed(argv, interpreter, policy) {
    if type(argv) != "array" || len(argv) != 2 || argv[0] != interpreter { return false }
    target := string_or(argv[1], "")
    workspace := string_or(dict_get_or(policy, "workspace", "."), ".")
    if starts_with(target, "scripts/") == false || ends_with(target, ".sh") == false || path_is_safe(workspace, target) == false { return false }
    script_path := workspace + "/" + target
    if path_is_symlink_safe(script_path) || path_has_symlink_component(script_path) || path_is_file(script_path) == false { return false }
    expected_hash := string_or(dict_get_or(dict_get_or(policy, "allowed_script_hashes", {}), target, ""), "")
    if len(expected_hash) != 64 { return false }
    try { return to_lower(expected_hash) == to_lower(to_string(sha256_file(script_path))) } except err { return false }
}

func script_hash_policy_valid(workspace, hashes) {
    if type(hashes) != "dict" || len(keys(hashes)) > 16 { return false }
    for script_path in keys(hashes) {
        expected_hash := string_or(dict_get_or(hashes, script_path, ""), "")
        if starts_with(script_path, "scripts/") == false || ends_with(script_path, ".sh") == false || path_is_safe(workspace, script_path) == false || len(expected_hash) != 64 || regex_match(to_lower(expected_hash), "^[0-9a-f]{64}$") == false { return false }
    }
    return true
}

func command_is_allowed(command, policy) {
    value := string_or(command, "")
    if value == "" { return false }
    if contains_any(value, ["rm -rf", "sudo", "mkfs", "dd if=", "force-push", "--force", "reset --hard", "clean -f", "credential", ".env", ".ssh", "id_rsa", "git push", "git config", "git remote", "git checkout", "git switch", "git reset", "git clean", "--ext-diff", "--textconv", "--upload-pack", "--exec-path", "--output", "--config", " --config-env"]) { return false }
    if contains_any(value, [";", "&&", "||", "|", "&", "`", "$", ">", "<", "~", "*", "?", "{", "}", "'", "\"", "\\", "\n", "\r", "\t"]) { return false }
    argv := command_args(value)
    if len(argv) == 0 { return false }
    allowed := dict_get_or(policy, "allowed_commands", ["git", "kujo"])
    for prefix in allowed {
        if prefix == "git" && git_read_argv_allowed(argv) { return true }
        if prefix == "kujo" && value == "kujo test" { return true }
        if prefix == "kujo" && starts_with(value, "kujo test ") {
            target := trim(substring(value, 10, len(value)))
            if ends_with(target, ".kujo") && path_is_safe(dict_get_or(policy, "workspace", "."), target) { return true }
            return false
        }
        if prefix == "kujo" && starts_with(value, "kujo run ") {
            target := trim(substring(value, 9, len(value)))
            if target == "" || starts_with(target, "-") || contains(target, " ") { return false }
            if ends_with(target, ".kujo") && path_is_safe(dict_get_or(policy, "workspace", "."), target) { return true }
            return false
        }
        if prefix == "bash" && script_argv_allowed(argv, "bash", policy) { return true }
        if prefix == "sh" && script_argv_allowed(argv, "sh", policy) { return true }
    }
    return false
}

func tool_decision(tool_name, input, policy) {
    if tool_name != "write_file" && tool_name != "run_command" {
        return {"allowed": false, "status": "denied", "reason": "unknown_tool"}
    }
    if tool_name == "write_file" {
        path := dict_get_or(input, "path", "")
        if path_is_safe(dict_get_or(policy, "workspace", "."), path) == false {
            return {"allowed": false, "status": "denied", "reason": "path_outside_workspace"}
        }
        if dict_get_or(policy, "allow_writes", false) == false {
            return {"allowed": false, "status": "approval_required", "reason": "write_authority_not_granted"}
        }
    }
    if tool_name == "run_command" && command_is_allowed(dict_get_or(input, "command", ""), policy) == false {
        return {"allowed": false, "status": "denied", "reason": "command_not_allowlisted"}
    }
    return {"allowed": true, "status": "allowed", "reason": "policy_match"}
}

export classify_failure := classify_failure
export repair_allowed := repair_allowed
export git_read_argv_allowed := git_read_argv_allowed
export path_is_safe := path_is_safe
export canonicalize_path := canonicalize_path
export path_is_within_root := path_is_within_root
export path_is_within_workspace := path_is_within_workspace
export real_path := real_path
export command_is_allowed := command_is_allowed
export script_hash_policy_valid := script_hash_policy_valid
export tool_decision := tool_decision
