from src.common import dict_get_or, env_or, string_or, bool_or, int_or, now_iso, safe_id, read_json_or, read_json_limited, write_json, append_jsonl_bounded, safe_json, shell_quote_single, command_args, write_text_atomic, process_options, process_options_with_cancel, redact_text, path_is_symlink_safe, path_has_symlink_component, ensure_safe_directory, consume_agent_capability
from src.contracts import run_state, event, event_integrity_input, receipt, receipt_integrity_input, event_chain_integrity_valid, receipt_sequence_valid, state_integrity_input, state_integrity_valid
from src.registry import find_agent
from src.policy import tool_decision, classify_failure, repair_allowed, path_is_safe, path_is_within_workspace, command_is_allowed, script_hash_policy_valid
from src.adapters import ai_chat_correlated, ai_chat_correlated_with_tools, normalize_provider_tool_calls, tool_definitions, agents_sdk_smoke, agents_sdk_tool_run, packwrite_generate, runledger_start, runledger_finish, changebucket, eval_run
from src.store import rebuild_run_index, load_run_index, persist_run_index, store_root_safe

export MISSION_SPEC_MAX_BYTES := 1048576
export MISSION_COMMAND_MAX_BYTES := 16384

func ensure_dir(path) {
    return ensure_safe_directory(path)
}

func relay_root() { return env_or("RELAY_ROOT", ".") }
func state_root() { return env_or("RELAY_STATE_ROOT", relay_root() + "/.relay") }
func run_root() { return state_root() + "/runs" }
func index_path() { return state_root() + "/index.json" }

func state_store_ready() {
    if store_root_safe(state_root()) == false { return {"ok": false, "error": "Relay state store root is unsafe"} }
    return {"ok": true}
}

func mark_evidence_failure(state, message) {
    failure := {"class": "evidence_failure", "message": string_or(message, "run evidence could not be persisted")}
    state["evidence_failure"] := failure
    state["status"] := "failed"
    state["failure"] := failure
    return state
}

func save_state(state, run_dir) {
    evidence_failure := dict_get_or(state, "evidence_failure", null)
    if type(evidence_failure) == "dict" {
        state["status"] := "failed"
        state["failure"] := evidence_failure
    }
    state["updated_at"] := now_iso()
    state["integrity_sha256"] := sha256(state_integrity_input(state))
    if write_json(run_dir + "/state.json", state) == false { state = mark_evidence_failure(state, "run state could not be persisted") }
    return state
}

func record_receipt(state, run_dir, kind, step_id, agent_id, artifact_ref, status, payload) {
    item := receipt(kind, state["mission_id"], state["run_id"], step_id, agent_id, artifact_ref, status, payload)
    item["metadata"] := {
        "mission_id": string_or(dict_get_or(state, "mission_id", ""), ""),
        "run_id": string_or(dict_get_or(state, "run_id", ""), ""),
        "workflow": string_or(dict_get_or(state, "workflow", ""), ""),
        "model": string_or(dict_get_or(state, "model", ""), ""),
        "provider": string_or(dict_get_or(state, "provider", ""), ""),
        "packet_revision": int_or(dict_get_or(state, "packet_revision", 0), 0),
        "attempt": int_or(dict_get_or(state, "attempt", 0), 0),
        "repair_attempt": int_or(dict_get_or(state, "repair_attempts", 0), 0),
        "retry_id": string_or(dict_get_or(state, "retry_id", ""), ""),
        "repair_id": string_or(dict_get_or(state, "repair_id", ""), ""),
        "tool": string_or(dict_get_or(payload, "tool_name", dict_get_or(payload, "kind", "")), ""),
        "artifact": string_or(artifact_ref, ""),
        "evaluation_id": string_or(dict_get_or(payload, "evaluation_id", ""), ""),
        "runledger_id": string_or(dict_get_or(dict_get_or(state, "runledger", {}), "run_id", ""), ""),
        "correlation_id": string_or(dict_get_or(dict_get_or(state, "telemetry", {}), "correlation_id", ""), "")
    }
    item["integrity_sha256"] := sha256(receipt_integrity_input(item))
    receipts := push(dict_get_or(state, "receipts", []), item)
    if len(safe_json(receipts)) > 8388608 { return {"receipt": item, "receipts": receipts, "evidence_failure": {"class": "evidence_failure", "message": "run receipt index exceeds the 8 MiB evidence limit"}} }
    if write_json(run_dir + "/receipts.json", receipts) == false { return {"receipt": item, "receipts": receipts, "evidence_failure": {"class": "evidence_failure", "message": "run receipt index could not be persisted"}} }
    return {"receipt": item, "receipts": receipts}
}

func apply_receipt_result(state, result) {
    state["receipts"] := dict_get_or(result, "receipts", dict_get_or(state, "receipts", []))
    failure := dict_get_or(result, "evidence_failure", null)
    if type(failure) == "dict" { state = mark_evidence_failure(state, string_or(dict_get_or(failure, "message", "run receipt index could not be persisted"), "run receipt index could not be persisted")) }
    return state
}

func evidence_status(ok) {
    if bool_or(ok, false) { return "completed" }
    return "failed"
}

func add_event(state, run_dir, kind, step_id, agent_id, payload) {
    parent := ""
    if len(state["events"]) > 0 { parent = dict_get_or(state["events"][len(state["events"]) - 1], "event_id", "") }
    item := event(kind, state["mission_id"], state["run_id"], step_id, agent_id, payload, parent)
    metadata := item["metadata"]
    metadata["workflow"] := string_or(dict_get_or(state, "workflow", ""), "")
    metadata["mission_id"] := string_or(dict_get_or(state, "mission_id", ""), "")
    metadata["run_id"] := string_or(dict_get_or(state, "run_id", ""), "")
    metadata["step_id"] := string_or(step_id, "")
    metadata["agent_id"] := string_or(agent_id, "")
    metadata["model"] := string_or(dict_get_or(state, "model", ""), "")
    metadata["provider"] := string_or(dict_get_or(state, "provider", ""), "")
    metadata["packet_revision"] := int_or(dict_get_or(state, "packet_revision", 0), 0)
    metadata["retry_id"] := string_or(dict_get_or(state, "retry_id", ""), "")
    metadata["repair_id"] := string_or(dict_get_or(state, "repair_id", ""), "")
    metadata["tool"] := string_or(dict_get_or(payload, "tool_name", dict_get_or(payload, "kind", "")), "")
    metadata["artifact"] := string_or(dict_get_or(payload, "path", ""), "")
    metadata["evaluation_id"] := string_or(dict_get_or(payload, "evaluation_id", ""), "")
    metadata["runledger_id"] := string_or(dict_get_or(dict_get_or(state, "runledger", {}), "run_id", ""), "")
    item["metadata"] := metadata
    item["integrity_sha256"] := sha256(event_integrity_input(item))
    state["events"] := push(state["events"], item)
    if append_jsonl_bounded(run_dir + "/events.jsonl", item, 8388608) == false { state = mark_evidence_failure(state, "run event log could not be persisted or exceeded the 8 MiB evidence limit") }
    return state
}

func persist_required_json(path, value, expected_type, label) {
    name := string_or(label, "required")
    if write_json(path, value) == false {
        return {"ok": false, "error": name + " artifact could not be persisted"}
    }
    if path_is_symlink_safe(path) || path_exists(path) == false || path_is_file(path) == false || file_size(path) > 8388608 {
        return {"ok": false, "error": name + " artifact persistence could not be verified"}
    }
    persisted := read_json_limited(path, null, 8388608)
    if type(persisted) != expected_type {
        return {"ok": false, "error": name + " artifact persistence has an invalid JSON shape"}
    }
    return {"ok": true, "path": path}
}

func packet_manifest_walk(root, relative, depth) {
    if depth > 16 { return {"ok": false, "error": "PackWrite packet exceeds the 16-level directory depth limit"} }
    target := root
    if relative != "" { target = root + "/" + relative }
    if path_is_symlink_safe(target) || path_has_symlink_component(target) { return {"ok": false, "error": "PackWrite packet contains a symbolic link"} }
    if path_is_dir(target) {
        names := sort(list_dir(target))
        if len(names) > 256 { return {"ok": false, "error": "PackWrite packet exceeds the 256-entry directory limit"} }
        mut entries := []
        mut bytes := 0
        mut files := 0
        mut directories := 1
        for name in names {
            child_relative := name
            if relative != "" { child_relative = relative + "/" + name }
            if path_is_safe(root, child_relative) == false { return {"ok": false, "error": "PackWrite packet contains an unsafe path"} }
            child := packet_manifest_walk(root, child_relative, depth + 1)
            if dict_get_or(child, "ok", false) == false { return child }
            for entry in dict_get_or(child, "entries", []) { entries := push(entries, entry) }
            bytes = bytes + int_or(dict_get_or(child, "bytes", 0), 0)
            files = files + int_or(dict_get_or(child, "files", 0), 0)
            directories = directories + int_or(dict_get_or(child, "directories", 0), 0)
            if len(entries) > 256 || bytes > 8388608 { return {"ok": false, "error": "PackWrite packet exceeds its bounded manifest limits"} }
        }
        return {"ok": true, "entries": entries, "bytes": bytes, "files": files, "directories": directories}
    }
    if path_is_file(target) == false { return {"ok": false, "error": "PackWrite packet contains an unsupported artifact path"} }
    bytes := file_size(target)
    if bytes > 8388608 { return {"ok": false, "error": "PackWrite packet contains an oversized artifact"} }
    digest := ""
    try { digest = to_string(sha256_file(target)) } except err { return {"ok": false, "error": "PackWrite packet artifact digest failed"} }
    return {"ok": true, "entries": [{"path": relative, "kind": "file", "bytes": bytes, "integrity_sha256": digest}], "bytes": bytes, "files": 1, "directories": 0}
}

func create_packet_manifest(run_dir, state) {
    root := run_dir + "/agent"
    walked := packet_manifest_walk(root, "", 0)
    if dict_get_or(walked, "ok", false) == false { return walked }
    has_master := false
    for entry in dict_get_or(walked, "entries", []) { if string_or(dict_get_or(entry, "path", ""), "") == "MASTER.md" { has_master = true } }
    if has_master == false { return {"ok": false, "error": "PackWrite packet manifest requires MASTER.md"} }
    manifest := {"contract_version": "relay-packwrite-manifest-v1", "run_id": state["run_id"], "mission_id": state["mission_id"], "packet_revision": int_or(dict_get_or(state, "packet_revision", 1), 1), "root": "agent", "summary": {"bytes": walked["bytes"], "files": walked["files"], "directories": walked["directories"]}, "entries": walked["entries"]}
    path := run_dir + "/packet-manifest.json"
    persisted := persist_required_json(path, manifest, "dict", "PackWrite packet manifest")
    if dict_get_or(persisted, "ok", false) == false { return persisted }
    persisted["path"] := path
    persisted["integrity_sha256"] := sha256_file(path)
    persisted["manifest"] := manifest
    return persisted
}

func verify_packet_manifest(run_dir, state) {
    required := bool_or(dict_get_or(state, "packet_manifest_required", false), false)
    if required == false { return {"required": false, "ok": true, "error": ""} }
    path := run_dir + "/packet-manifest.json"
    if path_is_symlink_safe(path) || path_exists(path) == false || path_is_file(path) == false || file_size(path) > 8388608 { return {"required": true, "ok": false, "error": "PackWrite packet manifest is missing or unsafe"} }
    expected_hash := string_or(dict_get_or(dict_get_or(state, "packet_manifest", {}), "integrity_sha256", ""), "")
    actual_hash := sha256_file(path)
    if expected_hash == "" || actual_hash == "" || expected_hash != actual_hash { return {"required": true, "ok": false, "error": "PackWrite packet manifest integrity does not match authoritative state"} }
    manifest := read_json_limited(path, null, 8388608)
    if type(manifest) != "dict" || string_or(dict_get_or(manifest, "contract_version", ""), "") != "relay-packwrite-manifest-v1" || string_or(dict_get_or(manifest, "run_id", ""), "") != string_or(dict_get_or(state, "run_id", ""), "") { return {"required": true, "ok": false, "error": "PackWrite packet manifest identity is invalid"} }
    walked := packet_manifest_walk(run_dir + "/agent", "", 0)
    if dict_get_or(walked, "ok", false) == false || safe_json(dict_get_or(walked, "entries", [])) != safe_json(dict_get_or(manifest, "entries", [])) { return {"required": true, "ok": false, "error": "PackWrite packet contents do not match the manifest"} }
    return {"required": true, "ok": true, "error": "", "path": path, "integrity_sha256": actual_hash, "entries": len(dict_get_or(manifest, "entries", []))}
}

func provider_assistant_tool_calls(calls) {
    messages := []
    if type(calls) != "array" { return messages }
    for call in calls {
        messages := push(messages, {"id": string_or(dict_get_or(call, "provider_call_id", ""), ""), "type": "function", "function": {"name": string_or(dict_get_or(call, "name", ""), ""), "arguments": safe_json(dict_get_or(call, "input", {}))}})
    }
    return messages
}

func provider_tool_result_messages(calls, agent_sdk_tools, turn) {
    messages := []
    results := []
    data := dict_get_or(agent_sdk_tools, "data", {})
    summaries := dict_get_or(data, "tool_calls", [])
    mut index := 0
    if type(calls) != "array" { return {"messages": messages, "results": results} }
    for call in calls {
        summary := {}
        if type(summaries) == "array" && index < len(summaries) && type(summaries[index]) == "dict" { summary = summaries[index] }
        result := {"ok": bool_or(dict_get_or(summary, "ok", false), false), "tool_name": string_or(dict_get_or(call, "name", ""), ""), "output": dict_get_or(summary, "output", {}), "error": {"kind": string_or(dict_get_or(summary, "error_kind", ""), ""), "message": redact_text(string_or(dict_get_or(summary, "error_message", ""), ""))}}
        message := {"role": "tool", "tool_call_id": string_or(dict_get_or(call, "provider_call_id", ""), ""), "name": string_or(dict_get_or(call, "name", ""), ""), "content": safe_json(result)}
        messages := push(messages, message)
        results := push(results, {"turn": turn, "provider_call_id": message["tool_call_id"], "tool_name": message["name"], "result": result})
        index = index + 1
    }
    return {"messages": messages, "results": results}
}

func persist_provider_tool_results(run_dir, state, results) {
    bundle := {"contract_version": "relay-tool-result-bundle-v1", "run_id": state["run_id"], "results": results}
    persisted := persist_required_json(run_dir + "/tool-results.json", bundle, "dict", "Provider tool-result bundle")
    if dict_get_or(persisted, "ok", false) == false { return persisted }
    persisted["integrity_sha256"] := sha256_file(run_dir + "/tool-results.json")
    return persisted
}

func record_model_fallback(state, run_dir, telemetry, step_id) {
    decision := dict_get_or(telemetry, "fallback_decision", null)
    if type(decision) != "dict" || string_or(dict_get_or(decision, "action", "none"), "none") == "none" { return state }
    state["retry_id"] := "retry-model-fallback-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999))
    fallback_action := string_or(dict_get_or(decision, "action", "skipped"), "skipped")
    fallback_status := "skipped"
    fallback_kind := "model_fallback_skipped"
    if fallback_action == "attempt" { fallback_status = "completed"; fallback_kind = "model_fallback_selected" }
    fallback_payload := {"decision": decision, "telemetry": telemetry, "retry_id": state["retry_id"]}
    fallback_receipt_result := record_receipt(state, run_dir, "fallback", step_id, "planner", "model/fallback", fallback_status, fallback_payload)
    state = apply_receipt_result(state, fallback_receipt_result)
    fallback_receipt := fallback_receipt_result["receipt"]
    state := add_event(state, run_dir, fallback_kind, step_id, "planner", {"decision": decision, "retry_id": state["retry_id"], "receipt_id": fallback_receipt["receipt_id"]})
    return state
}

func register_run(state, run_dir) {
    # The per-run state is authoritative. Let the locked persistence path
    # rebuild once from those state files instead of scanning the run tree
    # here and then scanning it again while persisting the cache.
    persist_run_index(state_root(), {})
}

func expected_budget(spec, key, fallback) {
    budgets := dict_get_or(spec, "budgets", {})
    if type(budgets) == "dict" && has_key(budgets, key) { return int_or(budgets[key], fallback) }
    return fallback
}

func resume_state_safe(state, run_id, run_dir) {
    if type(state) != "dict" || string_or(dict_get_or(state, "run_id", ""), "") != string_or(run_id, "") { return {"ok": false, "error": "run state identity does not match the requested run"} }
    if state_integrity_valid(state) == false { return {"ok": false, "error": "run state integrity verification failed"} }
    spec := dict_get_or(state, "mission_spec", null)
    if type(spec) != "dict" { return {"ok": false, "error": "run mission policy is missing"} }
    digest := string_or(dict_get_or(state, "mission_spec_integrity_sha256", ""), "")
    if digest == "" || digest != sha256(safe_json(spec)) { return {"ok": false, "error": "run mission policy integrity verification failed"} }
    if event_chain_integrity_valid(dict_get_or(state, "events", [])) == false { return {"ok": false, "error": "run event state integrity verification failed"} }
    if receipt_sequence_valid(dict_get_or(state, "receipts", [])) == false { return {"ok": false, "error": "run receipt state integrity verification failed"} }
    source_repo := string_or(dict_get_or(spec, "repository", ""), "")
    if source_repo == "" || path_is_dir(source_repo) == false || path_is_symlink_safe(source_repo) || path_exists(source_repo + "/.git") == false || path_is_symlink_safe(source_repo + "/.git") { return {"ok": false, "error": "run source repository integrity verification failed"} }
    repository := string_or(dict_get_or(state, "repository", ""), "")
    workspace := dict_get_or(state, "workspace", {})
    if type(workspace) != "dict" || repository == "" || path_is_dir(repository) == false || path_is_symlink_safe(repository) || path_exists(repository + "/.git") == false || path_is_symlink_safe(repository + "/.git") { return {"ok": false, "error": "run workspace integrity verification failed"} }
    mode := string_or(dict_get_or(spec, "workspace_mode", "provided"), "provided")
    workspace_mode := string_or(dict_get_or(workspace, "mode", ""), "")
    workspace_path := string_or(dict_get_or(workspace, "path", ""), "")
    workspace_source := string_or(dict_get_or(workspace, "source_repository", ""), "")
    if mode == "provided" {
        if workspace_mode != "provided" || repository != source_repo || workspace_path != source_repo || workspace_source != source_repo { return {"ok": false, "error": "provided workspace identity does not match the mission"} }
    } else if mode == "worktree" {
        expected_workspace := run_dir + "/workspace"
        if workspace_mode != "worktree" || repository != expected_workspace || workspace_path != expected_workspace || workspace_source != source_repo { return {"ok": false, "error": "worktree identity does not match the run"} }
    } else { return {"ok": false, "error": "run workspace mode is invalid"} }
    state_budgets := dict_get_or(state, "budgets", {})
    if type(state_budgets) != "dict" { return {"ok": false, "error": "run budget state is missing"} }
    defaults := {"max_steps": 8, "max_repairs": 1, "max_tokens": 4000, "max_tool_calls": 4, "max_tool_turns": 2, "max_output_bytes": 1048576, "max_write_bytes": 1048576}
    for key in keys(defaults) {
        if int_or(dict_get_or(state_budgets, key, -1), -1) != expected_budget(spec, key, defaults[key]) { return {"ok": false, "error": "run budget integrity verification failed"} }
    }
    attempt := int_or(dict_get_or(state, "attempt", -1), -1)
    if attempt < 0 || attempt > int_or(dict_get_or(state_budgets, "max_steps", 0), 0) { return {"ok": false, "error": "run attempt state is invalid"} }
    return {"ok": true}
}

func cleanup_state_safe(state, run_id, run_dir) {
    if type(state) != "dict" || string_or(dict_get_or(state, "run_id", ""), "") != string_or(run_id, "") { return {"ok": false, "error": "run state identity does not match the requested run"} }
    if state_integrity_valid(state) == false { return {"ok": false, "error": "run state integrity verification failed"} }
    spec := dict_get_or(state, "mission_spec", null)
    if type(spec) != "dict" { return {"ok": false, "error": "run mission policy is missing"} }
    digest := string_or(dict_get_or(state, "mission_spec_integrity_sha256", ""), "")
    if digest == "" || digest != sha256(safe_json(spec)) { return {"ok": false, "error": "run mission policy integrity verification failed"} }
    if event_chain_integrity_valid(dict_get_or(state, "events", [])) == false { return {"ok": false, "error": "run event state integrity verification failed"} }
    if receipt_sequence_valid(dict_get_or(state, "receipts", [])) == false { return {"ok": false, "error": "run receipt state integrity verification failed"} }
    source_repo := string_or(dict_get_or(spec, "repository", ""), "")
    if source_repo == "" || path_is_dir(source_repo) == false || path_is_symlink_safe(source_repo) || path_exists(source_repo + "/.git") == false || path_is_symlink_safe(source_repo + "/.git") { return {"ok": false, "error": "run source repository integrity verification failed"} }
    workspace := dict_get_or(state, "workspace", {})
    expected_workspace := run_dir + "/workspace"
    if type(workspace) != "dict" || string_or(dict_get_or(state, "repository", ""), "") != expected_workspace || string_or(dict_get_or(workspace, "mode", ""), "") != "worktree" || string_or(dict_get_or(workspace, "path", ""), "") != expected_workspace || string_or(dict_get_or(workspace, "source_repository", ""), "") != source_repo { return {"ok": false, "error": "worktree identity does not match the run"} }
    if path_exists(expected_workspace) {
        if path_is_dir(expected_workspace) == false || path_is_symlink_safe(expected_workspace) || path_exists(expected_workspace + "/.git") == false || path_is_symlink_safe(expected_workspace + "/.git") { return {"ok": false, "error": "run-owned worktree is missing or unsafe"} }
    } else if bool_or(dict_get_or(workspace, "cleaned", false), false) == false {
        return {"ok": false, "error": "run-owned worktree is missing before cleanup"}
    }
    return {"ok": true}
}

func control_state_safe(state, run_id, run_dir) {
    return resume_state_safe(state, run_id, run_dir)
}

func load_spec(path) {
    if type(path) != "string" || trim(path) == "" || path_exists(path) == false { return {"ok": false, "error": "Mission file is missing or invalid JSON: " + to_string(path)} }
    if path_is_symlink_safe(path) { return {"ok": false, "error": "Mission file must not be a symbolic link"} }
    if path_is_file(path) == false { return {"ok": false, "error": "Mission file must be a regular file"} }
    if file_size(path) > MISSION_SPEC_MAX_BYTES { return {"ok": false, "error": "Mission file exceeds the 1 MiB safety limit"} }
    spec := read_json_or(path, null)
    if type(spec) != "dict" { return {"ok": false, "error": "Mission file is missing or invalid JSON: " + path} }
    name := string_or(dict_get_or(spec, "name", ""), "")
    if name == "" { return {"ok": false, "error": "Mission requires name"} }
    if len(name) > 160 || contains(name, "\n") || contains(name, "\r") || contains(name, "\t") { return {"ok": false, "error": "Mission name exceeds the 160-character or control-character limit"} }
    goal := string_or(dict_get_or(spec, "goal", ""), "")
    if goal == "" { return {"ok": false, "error": "Mission requires goal"} }
    if len(goal) > 65536 { return {"ok": false, "error": "Mission goal exceeds the 64 KiB safety limit"} }
    actions := dict_get_or(spec, "actions", [])
    if type(actions) != "array" { return {"ok": false, "error": "Mission actions must be an array"} }
    if len(actions) > 32 { return {"ok": false, "error": "Mission exceeds the 32-action safety limit"} }
    budgets := dict_get_or(spec, "budgets", {})
    if type(budgets) != "dict" { return {"ok": false, "error": "Mission budgets must be an object"} }
    for key in ["max_steps", "max_repairs", "max_tokens", "max_tool_calls", "max_tool_turns", "max_output_bytes", "max_write_bytes"] {
        if has_key(budgets, key) {
            value := int_or(budgets[key], -1)
            if value < 0 { return {"ok": false, "error": "Mission budget " + key + " must be a non-negative integer"} }
            if (key == "max_tool_calls" || key == "max_output_bytes" || key == "max_write_bytes") && value == 0 { return {"ok": false, "error": "Mission budget " + key + " must be greater than zero"} }
            if key == "max_tool_calls" && value > 16 { return {"ok": false, "error": "Mission budget max_tool_calls exceeds the 16-call safety limit"} }
            if key == "max_repairs" && value > 4 { return {"ok": false, "error": "Mission budget max_repairs exceeds the 4-repair safety limit"} }
            if key == "max_tokens" && (value == 0 || value > 65536) { return {"ok": false, "error": "Mission aggregate budget max_tokens must be between 1 and 65536"} }
            if key == "max_tool_turns" && (value == 0 || value > 4) { return {"ok": false, "error": "Mission budget max_tool_turns must be between 1 and 4"} }
            if (key == "max_output_bytes" || key == "max_write_bytes") && value > 8388608 { return {"ok": false, "error": "Mission budget " + key + " exceeds the 8 MiB safety limit"} }
        }
    }
    max_write_bytes := expected_budget(spec, "max_write_bytes", 1048576)
    for action in actions {
        if type(action) != "dict" { return {"ok": false, "error": "Mission actions must contain objects"} }
        kind := string_or(dict_get_or(action, "type", ""), "")
        if kind == "write_file" {
            relative := string_or(dict_get_or(action, "path", ""), "")
            content := dict_get_or(action, "content", null)
            if relative == "" || type(content) != "string" { return {"ok": false, "error": "write_file requires path and string content"} }
            if len(relative) > 4096 { return {"ok": false, "error": "write_file path exceeds the 4 KiB safety limit"} }
            if len(content) > max_write_bytes { return {"ok": false, "error": "write_file content exceeds max_write_bytes"} }
        } else if kind == "run_command" {
            command := string_or(dict_get_or(action, "command", ""), "")
            if command == "" { return {"ok": false, "error": "run_command requires command"} }
            if len(command) > MISSION_COMMAND_MAX_BYTES { return {"ok": false, "error": "run_command exceeds the 16 KiB safety limit"} }
            timeout_ms := int_or(dict_get_or(action, "timeout_ms", 120000), -1)
            if timeout_ms <= 0 || timeout_ms > 600000 { return {"ok": false, "error": "run_command timeout_ms must be between 1 and 600000"} }
        } else { return {"ok": false, "error": "Mission action type is not supported: " + kind} }
    }
    allowed_commands := dict_get_or(spec, "allowed_commands", ["git", "kujo"])
    if type(allowed_commands) != "array" { return {"ok": false, "error": "Mission allowed_commands must be an array"} }
    for allowed_command in allowed_commands {
        if type(allowed_command) != "string" || trim(allowed_command) == "" { return {"ok": false, "error": "Mission allowed_commands must contain non-empty strings"} }
    }
    agent_tools := dict_get_or(spec, "agent_tools", [])
    if type(agent_tools) != "array" { return {"ok": false, "error": "Mission agent_tools must be an array"} }
    if len(agent_tools) > 16 { return {"ok": false, "error": "Mission exceeds the 16-tool-call safety limit"} }
    for tool_call in agent_tools {
        if type(tool_call) != "dict" { return {"ok": false, "error": "Mission agent_tools must contain objects"} }
        tool_name := string_or(dict_get_or(tool_call, "name", ""), "")
        input := dict_get_or(tool_call, "input", {})
        if type(input) != "dict" { return {"ok": false, "error": "Mission agent tool input must be an object"} }
        if tool_name == "relay.write_file" {
            if string_or(dict_get_or(input, "path", ""), "") == "" || type(dict_get_or(input, "content", null)) != "string" { return {"ok": false, "error": "relay.write_file requires path and string content"} }
            if len(string_or(dict_get_or(input, "path", ""), "")) > 4096 || len(dict_get_or(input, "content", "")) > max_write_bytes { return {"ok": false, "error": "relay.write_file input exceeds its path or write-byte safety limit"} }
        } else if tool_name == "relay.read_file" {
            relative := string_or(dict_get_or(input, "path", ""), "")
            if relative == "" || len(relative) > 4096 { return {"ok": false, "error": "relay.read_file requires a bounded path"} }
        } else if tool_name == "relay.list_files" {
            if len(keys(input)) > 0 { return {"ok": false, "error": "relay.list_files does not accept input fields"} }
        } else if tool_name == "relay.run_command" {
            if string_or(dict_get_or(input, "command", ""), "") == "" { return {"ok": false, "error": "relay.run_command requires command"} }
            if len(string_or(dict_get_or(input, "command", ""), "")) > MISSION_COMMAND_MAX_BYTES { return {"ok": false, "error": "relay.run_command exceeds the 16 KiB safety limit"} }
            tool_timeout := int_or(dict_get_or(input, "timeout_ms", 120000), -1)
            if tool_timeout <= 0 || tool_timeout > 600000 { return {"ok": false, "error": "relay.run_command timeout_ms must be between 1 and 600000"} }
        } else { return {"ok": false, "error": "Mission agent tool is not supported: " + tool_name} }
    }
    agent_tool_mode := string_or(dict_get_or(spec, "agent_tool_mode", "declared"), "declared")
    if agent_tool_mode != "declared" && agent_tool_mode != "provider" { return {"ok": false, "error": "agent_tool_mode must be declared or provider"} }
    agent_tool_allowlist := dict_get_or(spec, "agent_tool_allowlist", [])
    if type(agent_tool_allowlist) != "array" { return {"ok": false, "error": "Mission agent_tool_allowlist must be an array"} }
    for tool_name in agent_tool_allowlist {
        if tool_name != "relay.write_file" && tool_name != "relay.read_file" && tool_name != "relay.list_files" && tool_name != "relay.run_command" { return {"ok": false, "error": "Mission agent_tool_allowlist contains an unsupported tool"} }
    }
    configured_agent_tools := dict_get_or(spec, "agent_tools", [])
    if type(configured_agent_tools) != "array" { return {"ok": false, "error": "Mission agent_tools must be an array"} }
    if agent_tool_mode == "provider" && len(configured_agent_tools) > 0 { return {"ok": false, "error": "provider agent_tool_mode cannot combine agent_tools with agent_tool_allowlist"} }
    if agent_tool_mode == "declared" && len(agent_tool_allowlist) > 0 { return {"ok": false, "error": "agent_tool_allowlist requires provider agent_tool_mode"} }
    if agent_tool_mode == "provider" && len(agent_tool_allowlist) == 0 { return {"ok": false, "error": "provider agent_tool_mode requires a non-empty agent_tool_allowlist"} }
    workspace_mode := string_or(dict_get_or(spec, "workspace_mode", "provided"), "provided")
    if workspace_mode != "provided" && workspace_mode != "worktree" { return {"ok": false, "error": "workspace_mode must be provided or worktree"} }
    repository := string_or(dict_get_or(spec, "repository", ""), "")
    if repository == "" || path_is_dir(repository) == false || path_is_symlink_safe(repository) || path_has_symlink_component(repository) { return {"ok": false, "error": "Mission repository must be an existing non-symlink directory"} }
    if path_exists(repository + "/.git") == false { return {"ok": false, "error": "Mission repository must be a Git workspace"} }
    if path_is_symlink_safe(repository + "/.git") || path_has_symlink_component(repository + "/.git") { return {"ok": false, "error": "Mission Git metadata must not be a symbolic link"} }
    allowed_script_hashes := dict_get_or(spec, "allowed_script_hashes", {})
    if script_hash_policy_valid(repository, allowed_script_hashes) == false { return {"ok": false, "error": "Mission allowed_script_hashes contains an invalid scripts path or SHA-256"} }
    action_policy := {"workspace": repository, "allow_writes": bool_or(dict_get_or(spec, "allow_writes", false), false), "allowed_commands": allowed_commands, "allowed_script_hashes": allowed_script_hashes}
    for action in actions {
        if dict_get_or(action, "type", "") == "run_command" && command_is_allowed(dict_get_or(action, "command", ""), action_policy) == false {
            return {"ok": false, "error": "Mission run_command is not permitted by the declared command policy"}
        }
    }
    if bool_or(dict_get_or(spec, "allow_writes", false), false) && dict_get_or(dict_get_or(spec, "approval", {}), "approved", false) != true {
        return {"ok": false, "error": "Write-enabled missions require approval.approved=true"}
    }
    return {"ok": true, "spec": spec}
}

func provision_worktree(source_repo, worktree_path, requested_commit) {
    commit_query := string_or(requested_commit, "HEAD")
    resolved := spawn_process(["git", "-C", source_repo, "rev-parse", "--verify", "--end-of-options", commit_query + "^{commit}"], process_options({}, 30000, 65536))
    if resolved.success == false { return {"ok": false, "error": "starting commit could not be resolved", "stderr": redact_text(resolved.stderr)} }
    commit := trim(resolved.stdout)
    if commit == "" { return {"ok": false, "error": "starting commit resolution returned no commit"} }
    created := spawn_process(["git", "-C", source_repo, "worktree", "add", "--detach", worktree_path, commit], process_options({}, 60000, 65536))
    if created.success == false { return {"ok": false, "error": "isolated worktree creation failed", "stderr": redact_text(created.stderr), "commit": commit} }
    return {"ok": true, "path": worktree_path, "source_repository": source_repo, "starting_commit": commit, "mode": "worktree", "stdout": redact_text(created.stdout)}
}

func write_prompt(run_dir, spec) {
    prompt := "# Relay mission\n\nName: " + to_string(spec["name"]) + "\nGoal: " + to_string(spec["goal"]) + "\n\nAcceptance criteria:\n"
    for criterion in dict_get_or(spec, "acceptance_criteria", []) { prompt = prompt + "- " + to_string(criterion) + "\n" }
    path := run_dir + "/MEGA_PROMPT.md"
    return {"ok": write_text_atomic(path, prompt), "path": path}
}

func execute_action(action, spec, state, run_dir) {
    kind := dict_get_or(action, "type", "")
    repo := state["repository"]
    policy := {
        "workspace": repo,
        "allow_writes": bool_or(dict_get_or(spec, "allow_writes", false), false),
        "allowed_commands": dict_get_or(spec, "allowed_commands", ["git", "kujo"]),
        "allowed_script_hashes": dict_get_or(spec, "allowed_script_hashes", {})
    }
    if kind == "list_files" {
        result := spawn_process(["git", "-C", repo, "ls-files"], process_options({}, 30000, state["budgets"]["max_output_bytes"]))
        if result.success == false { return {"ok": false, "failure_class": "repository_failure", "error": "tracked file listing failed", "stderr": redact_text(result.stderr)} }
        return {"ok": true, "tool": "list_files", "files": split(trim(result.stdout), "\n"), "output_truncated": result.stdout_truncated}
    }
    if kind == "read_file" {
        relative := string_or(dict_get_or(action, "path", ""), "")
        if relative == "" || len(relative) > 4096 || path_is_within_workspace(repo, relative) == false { return {"ok": false, "failure_class": "permission_denial", "error": "unsafe or invalid read path"} }
        target := repo + "/" + relative
        if path_is_file(target) == false || path_is_symlink_safe(target) || path_has_symlink_component(target) { return {"ok": false, "failure_class": "permission_denial", "error": "read target is missing or unsafe"} }
        if file_size(target) > state["budgets"]["max_output_bytes"] { return {"ok": false, "failure_class": "budget_exceeded", "error": "read target exceeds max_output_bytes"} }
        try { return {"ok": true, "tool": "read_file", "path": relative, "content": redact_text(read_file(target))} } except err { return {"ok": false, "failure_class": "repository_failure", "error": "file read failed"} }
    }
    if kind == "write_file" {
        decision := tool_decision("write_file", action, policy)
        if decision["allowed"] == false { return {"ok": false, "failure_class": "permission_denial", "error": decision["reason"]} }
        relative := action["path"]
        target := repo + "/" + relative
        if path_is_within_workspace(repo, relative) == false { return {"ok": false, "failure_class": "permission_denial", "error": "unsafe or symlinked path"} }
        content := to_string(dict_get_or(action, "content", ""))
        if len(content) > state["budgets"]["max_write_bytes"] { return {"ok": false, "failure_class": "budget_exceeded", "error": "write_file content exceeds max_write_bytes"} }
        try {
            if write_text_atomic(target, content) == false { return {"ok": false, "failure_class": "repository_failure", "error": "atomic write failed"} }
            return {"ok": true, "tool": "write_file", "path": relative}
        } except err { return {"ok": false, "failure_class": "repository_failure", "error": to_string(err)} }
    }
    if kind == "run_command" {
        command := string_or(dict_get_or(action, "command", ""), "")
        if command_is_allowed(command, policy) == false { return {"ok": false, "failure_class": "policy_violation", "error": "command_not_allowlisted"} }
        argv := command_args(command)
        if len(argv) == 0 { return {"ok": false, "failure_class": "policy_violation", "error": "command_not_allowlisted"} }
        direct_command := ["/usr/bin/env", "-C", repo]
        for argument in argv { direct_command := push(direct_command, argument) }
        started_ms := current_timestamp()
        cancel_file := ""
        if path_exists(run_dir + "/state.json") { cancel_file = run_dir + "/cancel.request.json" }
        result := spawn_process(direct_command, process_options_with_cancel({}, int_or(dict_get_or(action, "timeout_ms", 120000), 120000), state["budgets"]["max_output_bytes"], cancel_file))
        duration_ms := current_timestamp() - started_ms
        ok := result.success
        output_truncated := result.stdout_truncated
        if result.stderr_truncated { output_truncated = true }
        failure_class := "tool_failure"
        if result.cancelled { failure_class = "cancelled" }
        else if result.timed_out { failure_class = "timeout" }
        return {"ok": ok, "tool": "run_command", "command": redact_text(command), "stdout": redact_text(result.stdout), "stderr": redact_text(result.stderr), "exit_code": result.exitcode, "timed_out": result.timed_out, "cancelled": result.cancelled, "stdout_truncated": result.stdout_truncated, "stderr_truncated": result.stderr_truncated, "output_truncated": output_truncated, "duration_ms": duration_ms, "failure_class": failure_class}
    }
    return {"ok": false, "failure_class": "policy_violation", "error": "unknown_action_type"}
}

func execute_tool_request(request, supplied_capability) {
    if type(request) != "dict" { return {"ok": false, "error": "tool request must be an object"} }
    capability := string_or(dict_get_or(request, "capability", ""), "")
    workspace := string_or(dict_get_or(request, "workspace", ""), "")
    if workspace == "" || path_is_dir(workspace) == false || path_is_symlink_safe(workspace) || path_has_symlink_component(workspace) { return {"ok": false, "error": "tool workspace is invalid"} }
    run_id := string_or(dict_get_or(request, "run_id", ""), "")
    session_id := string_or(dict_get_or(request, "session_id", ""), "")
    capability_nonce := string_or(dict_get_or(request, "capability_nonce", ""), "")
    expected_capability := sha256(run_id + "|" + session_id + "|" + workspace + "|" + capability_nonce + "|relay-agent-tools")
    supplied := string_or(supplied_capability, env_or("RELAY_TOOL_CAPABILITY", ""))
    if capability_nonce == "" || capability == "" || capability != expected_capability || supplied != expected_capability { return {"ok": false, "error": "tool capability is invalid"} }
    capability_check := consume_agent_capability(relay_root(), request, env_or("RELAY_TOOL_CAPABILITY_SECRET", ""))
    if dict_get_or(capability_check, "ok", false) == false { return {"ok": false, "error": dict_get_or(capability_check, "error", {"code": "capability_invalid", "message": "Tool capability could not be consumed"})} }
    if path_exists(workspace + "/.git") == false || path_is_symlink_safe(workspace + "/.git") || path_has_symlink_component(workspace + "/.git") { return {"ok": false, "error": "tool workspace must be a Git workspace"} }
    original_spec := dict_get_or(request, "mission_spec", {})
    if type(original_spec) != "dict" { return {"ok": false, "error": "mission policy is missing"} }
    spec := original_spec
    spec["repository"] := workspace
    if script_hash_policy_valid(workspace, dict_get_or(spec, "allowed_script_hashes", {})) == false { return {"ok": false, "error": "mission allowed_script_hashes is invalid"} }
    if bool_or(dict_get_or(spec, "allow_writes", false), false) && dict_get_or(dict_get_or(spec, "approval", {}), "approved", false) != true {
        return {"ok": false, "error": {"code": "permission_denial", "message": "write-enabled tool requests require approval.approved=true"}}
    }
    tool_name := string_or(dict_get_or(request, "tool_name", ""), "")
    input := dict_get_or(request, "input", {})
    action := {}
    if tool_name == "relay.list_files" {
        action = {"type": "list_files"}
    } else if tool_name == "relay.read_file" {
        action = {"type": "read_file", "path": dict_get_or(input, "path", "")}
    } else if tool_name == "relay.write_file" {
        action = {"type": "write_file", "path": dict_get_or(input, "path", ""), "content": dict_get_or(input, "content", "")}
    } else if tool_name == "relay.run_command" {
        action = {"type": "run_command", "command": dict_get_or(input, "command", ""), "timeout_ms": dict_get_or(input, "timeout_ms", 120000)}
    } else { return {"ok": false, "error": "unknown Relay tool"} }
    timeout_ms := int_or(dict_get_or(action, "timeout_ms", 120000), -1)
    if tool_name == "relay.run_command" && (timeout_ms <= 0 || timeout_ms > 600000) {
        return {"ok": false, "error": {"code": "policy_violation", "message": "tool timeout_ms must be between 1 and 600000"}}
    }
    budgets := {"max_output_bytes": int_or(dict_get_or(dict_get_or(spec, "budgets", {}), "max_output_bytes", 1048576), 1048576), "max_write_bytes": int_or(dict_get_or(dict_get_or(spec, "budgets", {}), "max_write_bytes", 1048576), 1048576)}
    if budgets["max_output_bytes"] <= 0 || budgets["max_output_bytes"] > 8388608 || budgets["max_write_bytes"] <= 0 || budgets["max_write_bytes"] > 8388608 {
        return {"ok": false, "error": {"code": "budget_exceeded", "message": "tool budgets must be between 1 and 8388608 bytes"}}
    }
    state := {"repository": workspace, "budgets": budgets}
    result := execute_action(action, spec, state, state_root())
    if dict_get_or(result, "ok", false) == false { return {"ok": false, "error": {"code": dict_get_or(result, "failure_class", "tool_failure"), "message": dict_get_or(result, "error", "tool execution failed")}, "result": result} }
    return {"ok": true, "tool_name": tool_name, "result": result, "artifacts": []}
}

func cancellation_integrity_input(request) {
    return to_string(dict_get_or(request, "run_id", "")) + "|" +
        to_string(dict_get_or(request, "requested_at", "")) + "|" +
        to_string(dict_get_or(request, "requested_by", "")) + "|" +
        to_string(dict_get_or(request, "reason", ""))
}

func cancellation_request(run_dir, expected_run_id) {
    path := run_dir + "/cancel.request.json"
    if path_is_symlink_safe(path) { return {"ok": false, "error": "cancellation request is a symbolic link"} }
    if path_exists(path) == false { return {"ok": true, "requested": false} }
    request := read_json_limited(path, null, 65536)
    if type(request) != "dict" { return {"ok": false, "error": "cancellation request is invalid"} }
    expected_id := string_or(expected_run_id, "")
    if expected_id != "" && string_or(dict_get_or(request, "run_id", ""), "") != expected_id { return {"ok": false, "error": "cancellation request run identity does not match"} }
    integrity := string_or(dict_get_or(request, "integrity_sha256", ""), "")
    if integrity == "" || integrity != sha256(cancellation_integrity_input(request)) { return {"ok": false, "error": "cancellation request integrity verification failed"} }
    return {"ok": true, "requested": true, "request": request}
}

func execute_actions(spec, state, run_dir) {
    actions := dict_get_or(spec, "actions", [])
    results := []
    for action in actions {
        cancellation := cancellation_request(run_dir, state["run_id"])
        if dict_get_or(cancellation, "ok", false) == false {
            return {"ok": false, "cancelled": false, "results": results, "state": state, "failure": {"failure_class": "evidence_failure", "error": dict_get_or(cancellation, "error", "cancellation request is invalid")}}
        }
        if bool_or(dict_get_or(cancellation, "requested", false), false) {
            return {"ok": false, "cancelled": true, "results": results, "state": state, "cancellation": dict_get_or(cancellation, "request", {}), "failure": {"failure_class": "cancelled", "error": "mission cancellation requested"}}
        }
        if state["attempt"] >= state["budgets"]["max_steps"] {
            return {"ok": false, "results": results, "state": state, "failure": {"failure_class": "budget_exceeded", "error": "Mission max_steps budget exceeded"}}
        }
        result := execute_action(action, spec, state, run_dir)
        results := push(results, result)
        state["attempt"] := state["attempt"] + 1
        cancellation := cancellation_request(run_dir, state["run_id"])
        if dict_get_or(cancellation, "ok", false) == false {
            return {"ok": false, "cancelled": false, "results": results, "state": state, "failure": {"failure_class": "evidence_failure", "error": dict_get_or(cancellation, "error", "cancellation request is invalid")}}
        }
        if bool_or(dict_get_or(cancellation, "requested", false), false) {
            return {"ok": false, "cancelled": true, "results": results, "state": state, "cancellation": dict_get_or(cancellation, "request", {}), "failure": {"failure_class": "cancelled", "error": "mission cancellation requested"}}
        }
        if result["ok"] == false { return {"ok": false, "results": results, "state": state, "failure": result} }
    }
    return {"ok": true, "results": results, "state": state}
}

func write_eval_config(run_dir, state) {
    repo := state["repository"]
    mut tests := [
        {"name": "git diff check", "check": "command_succeeds", "params": {"command": "git -C " + shell_quote_single(repo) + " diff --check"}}
    ]
    for action in dict_get_or(state["mission_spec"], "actions", []) {
        if dict_get_or(action, "type", "") == "write_file" {
            relative := string_or(dict_get_or(action, "path", ""), "")
            if relative != "" {
                tests := push(tests, {"name": "file exists: " + relative, "check": "command_succeeds", "params": {"command": "test -f " + shell_quote_single(repo + "/" + relative)}})
            }
        }
    }
    for tool_call in dict_get_or(state["mission_spec"], "agent_tools", []) {
        if dict_get_or(tool_call, "name", "") == "relay.write_file" {
            input := dict_get_or(tool_call, "input", {})
            relative := string_or(dict_get_or(input, "path", ""), "")
            if relative != "" {
                tests := push(tests, {"name": "agent tool file exists: " + relative, "check": "command_succeeds", "params": {"command": "test -f " + shell_quote_single(repo + "/" + relative)}})
            }
        }
    }
    config := {
        "name": "relay-" + state["mission_id"],
        "description": "Deterministic Relay acceptance checks",
        "version": "1.0.0",
        "output_dir": "./eval_results",
        "allowed_paths": [repo],
        "tests": tests
    }
    path := run_dir + "/eval.json"
    write_json(path, config)
    return path
}

func report(state, run_dir) {
    state["integrity_sha256"] := sha256(state_integrity_input(state))
    json_path := run_dir + "/report.json"
    json_artifact := persist_required_json(json_path, state, "dict", "report")
    failure := dict_get_or(state, "failure", {})
    failure_line := "- Failure: none\n"
    if type(failure) == "dict" && len(failure) > 0 { failure_line = "- Failure: " + to_string(dict_get_or(failure, "class", "unknown")) + " — " + to_string(dict_get_or(failure, "message", "")) + "\n" }
    markdown := "# Relay Run Report\n\n- Mission: " + state["mission_id"] + "\n- Run: " + state["run_id"] + "\n- Status: " + state["status"] + "\n- Current step: " + to_string(dict_get_or(state, "current_step", "")) + "\n- Workflow: " + state["workflow"] + "\n- Repository: " + state["repository"] + "\n" + failure_line + "\n## Evidence\n\n- Events: events.jsonl\n- Packet: agent/\n- Changes: changes.json\n- Evaluations: evaluations.json\n- JSON report: report.json\n"
    markdown_ok := write_text_atomic(run_dir + "/report.md", markdown)
    report_ok := dict_get_or(json_artifact, "ok", false) && markdown_ok
    return {"ok": report_ok, "json": json_artifact, "markdown_ok": markdown_ok}
}

func create_mission(path, output_path) {
    store_check := state_store_ready()
    if store_check["ok"] == false { return {"ok": false, "failure_class": "state_store_failure", "error": store_check["error"]} }
    name := "verified-feature"
    goal := "Execute one bounded, policy-controlled repository task and preserve evidence."
    spec := {"version": "0.1.0", "name": name, "goal": goal, "workflow": "verified-feature", "repository": ".", "allow_writes": false, "acceptance_criteria": ["deterministic checks pass"], "actions": []}
    if path != "" {
        loaded := load_spec(path)
        if loaded["ok"] == false { return loaded }
        spec = loaded["spec"]
    }
    if output_path == "" { output_path = state_root() + "/missions/" + name + ".json" }
    if ensure_dir(state_root() + "/missions") == false { return {"ok": false, "failure_class": "state_store_failure", "error": "Mission directory is unsafe or unavailable"} }
    if write_json(output_path, spec) == false { return {"ok": false, "failure_class": "state_store_failure", "error": "Mission file could not be persisted"} }
    return {"ok": true, "path": output_path, "mission": spec}
}

func run_mission(path, options) {
    store_check := state_store_ready()
    if store_check["ok"] == false { return {"ok": false, "failure_class": "state_store_failure", "error": store_check["error"]} }
    loaded := load_spec(path)
    if loaded["ok"] == false { return loaded }
    spec := loaded["spec"]
    if ensure_dir(run_root()) == false { return {"ok": false, "failure_class": "state_store_failure", "error": "Run directory is unsafe or unavailable"} }
    mission_id := safe_id(string_or(dict_get_or(spec, "id", dict_get_or(spec, "name", "mission")), "mission"), "mission")
    run_key := mission_id + "-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999))
    run_dir := run_root() + "/" + run_key
    if ensure_dir(run_dir) == false { return {"ok": false, "failure_class": "state_store_failure", "error": "Run workspace directory is unsafe or unavailable"} }
    source_repo := string_or(dict_get_or(spec, "repository", "."), ".")
    repo := source_repo
    workspace := {"mode": "provided", "source_repository": source_repo, "path": source_repo}
    if string_or(dict_get_or(spec, "workspace_mode", "provided"), "provided") == "worktree" {
        worktree := provision_worktree(source_repo, run_dir + "/workspace", dict_get_or(spec, "starting_commit", "HEAD"))
        if worktree["ok"] == false { return {"ok": false, "error": worktree["error"], "workspace": worktree} }
        repo = worktree["path"]
        workspace = worktree
    }
    state := run_state(mission_id, string_or(dict_get_or(spec, "workflow", "verified-feature"), "verified-feature"), repo, run_key)
    state["mission_spec"] := spec
    state["mission_spec_integrity_sha256"] := sha256(safe_json(spec))
    state["workspace"] := workspace
    state["model"] := string_or(dict_get_or(spec, "model", "fixture-model"), "fixture-model")
    state["provider"] := string_or(dict_get_or(spec, "provider", "fixture"), "fixture")
    configured_budgets := dict_get_or(spec, "budgets", {})
    budgets := state["budgets"]
    for key in ["max_steps", "max_repairs", "max_tokens", "max_tool_calls", "max_tool_turns", "max_output_bytes", "max_write_bytes"] {
        if has_key(configured_budgets, key) { budgets[key] := int_or(configured_budgets[key], budgets[key]) }
    }
    state["budgets"] := budgets
    # Persist the workspace reservation before invoking any external adapter.
    # A process crash after worktree creation can then still be discovered and
    # explicitly cleaned up from the run index.
    state = save_state(state, run_dir)
    ledger := runledger_start(run_dir, string_or(dict_get_or(spec, "model", "fixture-model"), "fixture-model"), string_or(dict_get_or(spec, "provider", "fixture"), "fixture"), to_string(spec["name"]), repo)
    state["runledger"] := ledger
    ledger_receipt_result := record_receipt(state, run_dir, "runledger", "plan", "relay", ledger["ledger"], evidence_status(ledger["ok"]), {"runledger_id": dict_get_or(ledger, "run_id", ""), "ok": ledger["ok"]})
    state = apply_receipt_result(state, ledger_receipt_result)
    ledger_receipt := ledger_receipt_result["receipt"]
    state["status"] := "running"
    state["current_step"] := "plan"
    state = save_state(state, run_dir)
    register_run(state, run_dir)
    state := add_event(state, run_dir, "run_started", "", "relay", {"workflow": state["workflow"], "repository": repo, "source_repository": source_repo, "workspace": workspace, "receipt_id": ledger_receipt["receipt_id"]})
    prompt := write_prompt(run_dir, spec)
    packet := {"ok": false, "artifact_dir": run_dir + "/agent", "packet_path": run_dir + "/agent", "error": "mission prompt could not be persisted"}
    if dict_get_or(prompt, "ok", false) { packet = packwrite_generate(run_dir, "MEGA_PROMPT.md", run_dir + "/agent") }
    state["packet_manifest_required"] := true
    packet_manifest := {"ok": false, "error": "PackWrite packet was not generated"}
    if dict_get_or(packet, "ok", false) { packet_manifest = create_packet_manifest(run_dir, state) }
    state["packet_manifest"] := {"required": true, "path": dict_get_or(packet_manifest, "path", run_dir + "/packet-manifest.json"), "integrity_sha256": dict_get_or(packet_manifest, "integrity_sha256", ""), "entries": int_or(dict_get_or(packet_manifest, "entries", len(dict_get_or(dict_get_or(packet_manifest, "manifest", {}), "entries", []))), 0)}
    if dict_get_or(packet, "ok", false) && dict_get_or(packet_manifest, "ok", false) == false { packet["ok"] := false; packet["error"] := dict_get_or(packet_manifest, "error", "PackWrite packet manifest could not be persisted") }
    packet_artifact := {"kind": "packwrite_agent_pack", "path": packet["artifact_dir"], "ok": packet["ok"], "revision": 1}
    if path_exists(run_dir + "/agent/MASTER.md") { packet_artifact["integrity_sha256"] := sha256_file(run_dir + "/agent/MASTER.md") }
    packet_artifact["manifest_path"] := state["packet_manifest"]["path"]
    packet_artifact["manifest_integrity_sha256"] := state["packet_manifest"]["integrity_sha256"]
    state["artifacts"] := push(state["artifacts"], packet_artifact)
    state["packet_revision"] := 1
    packet_receipt_result := record_receipt(state, run_dir, "artifact", "packet", "planner", run_dir + "/agent", evidence_status(packet["ok"]), packet_artifact)
    state = apply_receipt_result(state, packet_receipt_result)
    packet_receipt := packet_receipt_result["receipt"]
    packet_artifact["receipt_id"] := packet_receipt["receipt_id"]
    state := add_event(state, run_dir, "artifact_created", "packet", "planner", packet_artifact)
    agent_sdk := {"ok": true, "skipped": true, "reason": "configured skip"}
    if bool_or(dict_get_or(options, "agents_sdk_smoke", true), true) { agent_sdk = agents_sdk_smoke() }
    state["agent_sdk"] := agent_sdk
    agent_sdk_receipt_result := record_receipt(state, run_dir, "artifact", "agent-sdk", "planner", "agent_sdk", evidence_status(agent_sdk["ok"]), {"kind": "agents_sdk_offline_smoke", "ok": agent_sdk["ok"]})
    state = apply_receipt_result(state, agent_sdk_receipt_result)
    agent_sdk_receipt := agent_sdk_receipt_result["receipt"]
    state := add_event(state, run_dir, "artifact_created", "agent-sdk", "planner", {"kind": "agents_sdk_offline_smoke", "ok": agent_sdk["ok"], "receipt_id": agent_sdk_receipt["receipt_id"]})
    agent_tool_mode := string_or(dict_get_or(spec, "agent_tool_mode", "declared"), "declared")
    agent_sdk_tools := {"ok": true, "skipped": true, "reason": "no mission agent_tools configured"}
    configured_agent_tools := dict_get_or(spec, "agent_tools", [])
    if agent_tool_mode == "provider" {
        agent_sdk_tools = {"ok": true, "skipped": true, "reason": "provider-generated tool planning runs after the initial Agents SDK readiness check"}
    } else if type(configured_agent_tools) == "array" && len(configured_agent_tools) > 0 {
        agent_sdk_tools = agents_sdk_tool_run(repo, spec, state["run_id"], state["run_id"] + "-session")
    }
    state["agent_sdk_tools"] := agent_sdk_tools
    tool_receipt_result := record_receipt(state, run_dir, "tool", "agent-sdk-tools", "core-developer", "agent_sdk_tools", evidence_status(agent_sdk_tools["ok"]), {"kind": "agents_sdk_tool_registry", "ok": agent_sdk_tools["ok"], "skipped": dict_get_or(agent_sdk_tools, "skipped", false)})
    state = apply_receipt_result(state, tool_receipt_result)
    tool_receipt := tool_receipt_result["receipt"]
    state := add_event(state, run_dir, "tool_call_completed", "agent-sdk-tools", "core-developer", {"kind": "agents_sdk_tool_registry", "ok": agent_sdk_tools["ok"], "skipped": dict_get_or(agent_sdk_tools, "skipped", false), "data": dict_get_or(agent_sdk_tools, "data", {}), "receipt_id": tool_receipt["receipt_id"]})
    planner := find_agent("planner")
    planning_tools := []
    if agent_tool_mode == "provider" { planning_tools = tool_definitions(dict_get_or(spec, "agent_tool_allowlist", [])) }
    provider_messages := [{"role": "system", "content": planner["mandate"]}, {"role": "user", "content": to_string(spec["goal"])}]
    model_result := ai_chat_correlated_with_tools(provider_messages, string_or(dict_get_or(spec, "model", "fixture-model"), "fixture-model"), string_or(dict_get_or(spec, "provider", "fixture"), "fixture"), bool_or(dict_get_or(options, "offline_fixture", true), true), bool_or(dict_get_or(options, "stream", false), false), state["run_id"], planning_tools, state["budgets"]["max_tokens"])
    state["telemetry"] := dict_get_or(model_result, "relay_telemetry", {})
    if agent_tool_mode != "provider" { state = record_model_fallback(state, run_dir, state["telemetry"], "plan") }
    usage := dict_get_or(model_result, "usage", {})
    used_tokens := int_or(dict_get_or(usage, "total_tokens", 0), 0)
    used_input_tokens := int_or(dict_get_or(usage, "input_tokens", 0), 0)
    used_output_tokens := int_or(dict_get_or(usage, "output_tokens", 0), 0)
    if used_tokens < 0 { used_tokens = 0 }
    if used_input_tokens < 0 { used_input_tokens = 0 }
    if used_output_tokens < 0 { used_output_tokens = 0 }
    if agent_tool_mode == "provider" {
        max_tool_calls := int_or(dict_get_or(dict_get_or(spec, "budgets", {}), "max_tool_calls", 4), 4)
        max_tool_turns := int_or(dict_get_or(dict_get_or(spec, "budgets", {}), "max_tool_turns", 2), 2)
        tool_calls_accumulated := []
        tool_results_accumulated := []
        tool_result_artifact := {}
        mut tool_turns := 0
        mut provider_loop_ok := true
        mut provider_loop_complete := false
        while tool_turns < max_tool_turns {
            tool_turns = tool_turns + 1
            state["provider_tool_turn"] := tool_turns
            state["telemetry"] := dict_get_or(model_result, "relay_telemetry", state["telemetry"])
            state = record_model_fallback(state, run_dir, state["telemetry"], "plan-tool-turn-" + to_string(tool_turns))
            if dict_get_or(model_result, "ok", false) == false {
                provider_loop_ok = false
                break
            }
            if used_tokens > state["budgets"]["max_tokens"] {
                provider_loop_ok = false
                agent_sdk_tools["error"] := "mission token budget exceeded before provider tool execution"
                break
            }
            normalized_tools := normalize_provider_tool_calls(dict_get_or(model_result, "tool_calls", []))
            if dict_get_or(normalized_tools, "ok", false) == false {
                provider_loop_ok = false
                agent_sdk_tools["error"] := dict_get_or(normalized_tools, "error", "provider tool call is malformed")
                break
            }
            calls := dict_get_or(normalized_tools, "calls", [])
            if len(calls) == 0 {
                provider_loop_complete = true
                break
            }
            if len(tool_calls_accumulated) + len(calls) > max_tool_calls {
                provider_loop_ok = false
                agent_sdk_tools["error"] := "provider tool-call budget exceeded"
                break
            }
            cancellation := cancellation_request(run_dir, state["run_id"])
            if dict_get_or(cancellation, "ok", false) == false {
                provider_loop_ok = false
                agent_sdk_tools["error"] := dict_get_or(cancellation, "error", "cancellation request is invalid")
                break
            }
            if bool_or(dict_get_or(cancellation, "requested", false), false) {
                provider_loop_ok = false
                agent_sdk_tools["cancelled"] := true
                agent_sdk_tools["error"] := "mission cancellation requested during provider tool planning"
                break
            }
            for call in calls { tool_calls_accumulated := push(tool_calls_accumulated, call) }
            planned_spec := parse_json(safe_json(spec))
            planned_spec["agent_tools"] := calls
            execution := agents_sdk_tool_run(repo, planned_spec, state["run_id"], state["run_id"] + "-session-" + to_string(tool_turns))
            execution["provider_generated"] := true
            execution["calls"] := calls
            agent_sdk_tools := execution
            result_messages := provider_tool_result_messages(calls, execution, tool_turns)
            for result_item in dict_get_or(result_messages, "results", []) { tool_results_accumulated := push(tool_results_accumulated, result_item) }
            tool_result_artifact = persist_provider_tool_results(run_dir, state, tool_results_accumulated)
            if dict_get_or(tool_result_artifact, "ok", false) == false {
                provider_loop_ok = false
                agent_sdk_tools["error"] := dict_get_or(tool_result_artifact, "error", "provider tool-result artifact persistence failed")
                break
            }
            state["tool_results"] := tool_results_accumulated
            state["tool_result_artifact"] := tool_result_artifact
            state["agent_sdk_tools"] := agent_sdk_tools
            tool_round_receipt_result := record_receipt(state, run_dir, "tool", "agent-sdk-tools-turn-" + to_string(tool_turns), "core-developer", run_dir + "/tool-results.json", evidence_status(execution["ok"]), {"kind": "provider_generated_tool_result", "turn": tool_turns, "calls": calls, "artifact": tool_result_artifact})
            state = apply_receipt_result(state, tool_round_receipt_result)
            tool_round_receipt := tool_round_receipt_result["receipt"]
            state := add_event(state, run_dir, "tool_result_persisted", "agent-sdk-tools", "core-developer", {"turn": tool_turns, "ok": execution["ok"], "calls": calls, "artifact": tool_result_artifact, "receipt_id": tool_round_receipt["receipt_id"]})
            state = save_state(state, run_dir)
            if dict_get_or(execution, "ok", false) == false {
                provider_loop_ok = false
                break
            }
            provider_messages := push(provider_messages, {"role": "assistant", "content": string_or(dict_get_or(model_result, "output_text", ""), ""), "tool_calls": provider_assistant_tool_calls(calls)})
            for message in dict_get_or(result_messages, "messages", []) { provider_messages := push(provider_messages, message) }
            remaining_model_tokens := state["budgets"]["max_tokens"] - used_tokens
            if remaining_model_tokens <= 0 {
                provider_loop_ok = false
                agent_sdk_tools["error"] := "mission token budget exceeded before provider follow-up"
                break
            }
            model_result = ai_chat_correlated_with_tools(provider_messages, string_or(dict_get_or(spec, "model", "fixture-model"), "fixture-model"), string_or(dict_get_or(spec, "provider", "fixture"), "fixture"), bool_or(dict_get_or(options, "offline_fixture", true), true), bool_or(dict_get_or(options, "stream", false), false), state["run_id"], planning_tools, remaining_model_tokens)
            next_usage := dict_get_or(model_result, "usage", {})
            next_tokens := int_or(dict_get_or(next_usage, "total_tokens", 0), 0)
            next_input_tokens := int_or(dict_get_or(next_usage, "input_tokens", 0), 0)
            next_output_tokens := int_or(dict_get_or(next_usage, "output_tokens", 0), 0)
            if next_tokens < 0 { next_tokens = 0 }
            if next_input_tokens < 0 { next_input_tokens = 0 }
            if next_output_tokens < 0 { next_output_tokens = 0 }
            used_tokens = used_tokens + next_tokens
            used_input_tokens = used_input_tokens + next_input_tokens
            used_output_tokens = used_output_tokens + next_output_tokens
        }
        # A final model response after the last permitted tool round does not
        # consume another tool turn. Accept it when it requests no more tools;
        # reject only an additional tool request beyond the declared budget.
        if provider_loop_ok && provider_loop_complete == false && dict_get_or(model_result, "ok", false) {
            final_tools := normalize_provider_tool_calls(dict_get_or(model_result, "tool_calls", []))
            if dict_get_or(final_tools, "ok", false) == false {
                provider_loop_ok = false
                agent_sdk_tools["error"] := dict_get_or(final_tools, "error", "provider tool call is malformed")
            } else if len(dict_get_or(final_tools, "calls", [])) == 0 {
                provider_loop_complete = true
            } else {
                provider_loop_ok = false
                agent_sdk_tools["error"] := "provider tool-turn budget exceeded"
            }
        }
        agent_sdk_tools["provider_generated"] := true
        agent_sdk_tools["calls"] := tool_calls_accumulated
        agent_sdk_tools["results"] := tool_results_accumulated
        agent_sdk_tools["turns"] := tool_turns
        agent_sdk_tools["tool_result_artifact"] := tool_result_artifact
        agent_sdk_tools["ok"] := provider_loop_ok && provider_loop_complete
        if agent_sdk_tools["ok"] == false && string_or(dict_get_or(agent_sdk_tools, "error", ""), "") == "" { agent_sdk_tools["error"] := "provider tool planning did not complete" }
        if dict_get_or(tool_result_artifact, "ok", false) {
            state["artifacts"] := push(dict_get_or(state, "artifacts", []), {"kind": "provider_tool_result_bundle", "path": run_dir + "/tool-results.json", "integrity_sha256": dict_get_or(tool_result_artifact, "integrity_sha256", ""), "turns": tool_turns})
        }
        state["provider_tool_turns"] := tool_turns
        state["provider_tool_calls"] := len(tool_calls_accumulated)
        state["agent_sdk_tools"] := agent_sdk_tools
        provider_tool_receipt_result := record_receipt(state, run_dir, "tool", "agent-sdk-tools", "core-developer", "agent_sdk_tools", evidence_status(agent_sdk_tools["ok"]), {"kind": "provider_generated_tool_plan", "ok": agent_sdk_tools["ok"], "provider_generated": true, "calls": dict_get_or(agent_sdk_tools, "calls", [])})
        state = apply_receipt_result(state, provider_tool_receipt_result)
        provider_tool_receipt := provider_tool_receipt_result["receipt"]
        state := add_event(state, run_dir, "tool_plan_resolved", "agent-sdk-tools", "planner", {"kind": "provider_generated_tool_plan", "ok": agent_sdk_tools["ok"], "provider_generated": true, "calls": dict_get_or(agent_sdk_tools, "calls", []), "receipt_id": provider_tool_receipt["receipt_id"]})
    }
    usage := dict_get_or(model_result, "usage", {})
    if type(usage) != "dict" { usage = {} }
    usage["relay_accounted_total_tokens"] := used_tokens
    usage["relay_input_tokens"] := used_input_tokens
    usage["relay_output_tokens"] := used_output_tokens
    if agent_tool_mode == "provider" {
        usage["relay_total_tokens"] := used_tokens
        final_telemetry := dict_get_or(state, "telemetry", {})
        final_telemetry["provider_tool_turns"] := int_or(dict_get_or(state, "provider_tool_turns", 0), 0)
        final_telemetry["provider_tool_calls"] := int_or(dict_get_or(state, "provider_tool_calls", 0), 0)
        state["telemetry"] := final_telemetry
    }
    budgets := dict_get_or(state, "budgets", {})
    budgets["used_tokens"] := used_tokens
    state["budgets"] := budgets
    state["usage"] := usage
    planner_output := redact_text(string_or(dict_get_or(model_result, "output_text", ""), ""))
    planner_output_path := run_dir + "/agent-response.md"
    planner_output_ok := planner_output != "" && write_text_atomic(planner_output_path, planner_output)
    state["planner_output"] := planner_output
    state["planner_output_path"] := planner_output_path
    if planner_output_ok {
        planner_artifact := {"kind":"agent_response","path":planner_output_path,"integrity_sha256":sha256_file(planner_output_path)}
        state["artifacts"] := push(dict_get_or(state,"artifacts",[]),planner_artifact)
        planner_receipt_result := record_receipt(state,run_dir,"artifact","plan-response","planner",planner_output_path,"completed",planner_artifact)
        state = apply_receipt_result(state,planner_receipt_result)
        state := add_event(state,run_dir,"artifact_created","plan-response","planner",{"kind":"agent_response","path":planner_output_path,"receipt_id":planner_receipt_result["receipt"]["receipt_id"]})
    }
    model_receipt_result := record_receipt(state, run_dir, "model", "plan", "planner", string_or(dict_get_or(state, "model", ""), ""), evidence_status(dict_get_or(model_result, "ok", false)), {"ok": dict_get_or(model_result, "ok", false), "telemetry": state["telemetry"], "usage": usage})
    state = apply_receipt_result(state, model_receipt_result)
    model_receipt := model_receipt_result["receipt"]
    state := add_event(state, run_dir, "model_request_completed", "plan", "planner", {"ok": dict_get_or(model_result, "ok", false), "telemetry": state["telemetry"], "receipt_id": model_receipt["receipt_id"]})
    preflight_ok := ledger["ok"] && packet["ok"] && agent_sdk["ok"] && agent_sdk_tools["ok"] && dict_get_or(model_result, "ok", false) && planner_output_ok && used_tokens <= state["budgets"]["max_tokens"]
    if preflight_ok && bool_or(dict_get_or(options, "pause_after_plan", false), false) {
        state["status"] := "paused"
        state["current_step"] := "implementation"
        state["checkpoint"] := {"step": "implementation", "reason": "pause_after_plan", "created_at": now_iso()}
        state := add_event(state, run_dir, "run_paused", "implementation", "relay", {"reason": "checkpoint_requested", "resumable": true})
        state = save_state(state, run_dir)
        report(state, run_dir)
        register_run(state, run_dir)
        return {"ok": true, "run": state, "run_dir": run_dir}
    }
    mut actions := {"ok": false, "results": [], "state": state, "failure": {"failure_class": "integration_failure", "error": "mission preflight failed"}}
    if preflight_ok {
        state["current_step"] := "implementation"
        actions = execute_actions(spec, state, run_dir)
    }
    state := actions["state"]
    state["action_results"] := actions["results"]
    if actions["ok"] == false {
        if bool_or(dict_get_or(actions, "cancelled", false), false) {
            state["status"] := "cancelled"
            state["current_step"] := ""
            state["cancellation"] := dict_get_or(actions, "cancellation", {})
            state := add_event(state, run_dir, "run_cancelled", "implementation", "relay", {"reason": "operator_cancel", "cancellation": state["cancellation"]})
        } else {
            state["status"] := "failed"
            failure_class := dict_get_or(actions["failure"], "failure_class", "tool_failure")
            if used_tokens > state["budgets"]["max_tokens"] { failure_class = "budget_exceeded" }
            else if preflight_ok == false { failure_class = "integration_failure" }
            state["failure"] := {"class": failure_class, "message": dict_get_or(actions["failure"], "error", "action or preflight failed"), "repair_attempts": 0}
            state := add_event(state, run_dir, "run_failed", "implementation", "core-developer", state["failure"])
        }
    } else {
        state["current_step"] := "verify"
        state := add_event(state, run_dir, "tool_call_completed", "implementation", "core-developer", {"actions": len(actions["results"]), "ok": true})
        changes := changebucket(repo, run_dir)
        state["changes"] := dict_get_or(changes, "data", {"ok": changes["ok"]})
        changes_artifact := persist_required_json(run_dir + "/changes.json", state["changes"], "dict", "ChangeBucket")
        changes_ok := changes["ok"] && dict_get_or(changes_artifact, "ok", false)
        artifact_persistence := {"changes": changes_artifact}
        state["artifact_persistence"] := artifact_persistence
        changes_receipt_result := record_receipt(state, run_dir, "changes", "verify", "release-verifier", run_dir + "/changes.json", evidence_status(changes_ok), {"ok": changes["ok"], "persisted": dict_get_or(changes_artifact, "ok", false)})
        state = apply_receipt_result(state, changes_receipt_result)
        changes_receipt := changes_receipt_result["receipt"]
        eval_path := write_eval_config(run_dir, state)
        evaluation := eval_run(run_dir, "eval.json")
        state["evaluations"] := push(state["evaluations"], dict_get_or(evaluation, "data", {"ok": evaluation["ok"]}))
        evaluations_artifact := persist_required_json(run_dir + "/evaluations.json", state["evaluations"], "array", "Eval")
        evaluation_ok := evaluation["ok"] && dict_get_or(evaluations_artifact, "ok", false)
        artifact_persistence["evaluations"] := evaluations_artifact
        state["artifact_persistence"] := artifact_persistence
        evaluation_receipt_result := record_receipt(state, run_dir, "evaluation", "verify", "release-verifier", run_dir + "/evaluations.json", evidence_status(evaluation_ok), {"ok": evaluation["ok"], "persisted": dict_get_or(evaluations_artifact, "ok", false), "config": eval_path})
        state = apply_receipt_result(state, evaluation_receipt_result)
        evaluation_receipt := evaluation_receipt_result["receipt"]
        if evaluation_ok == false || changes_ok == false {
            state["status"] := "failed"
            failure_class := "evaluation_failure"
            if changes_ok == false || dict_get_or(changes_artifact, "ok", false) == false || dict_get_or(evaluations_artifact, "ok", false) == false { failure_class = "evidence_failure" }
            state["failure"] := {"class": failure_class, "message": "Acceptance evidence or required artifact persistence did not pass", "repair_attempts": 0}
            state := add_event(state, run_dir, "run_failed", "verify", "release-verifier", {"evaluation_ok": evaluation_ok, "changes_ok": changes_ok, "failure": state["failure"], "changes_receipt_id": changes_receipt["receipt_id"], "evaluation_receipt_id": evaluation_receipt["receipt_id"]})
        } else {
            state["status"] := "finalizing"
            state["current_step"] := ""
            state["completion_candidate"] := {"evaluation_ok": true, "changes_ok": true, "changes_receipt_id": changes_receipt["receipt_id"], "evaluation_receipt_id": evaluation_receipt["receipt_id"]}
        }
    }
    state = save_state(state, run_dir)
    verdict := "Relay run " + state["status"]
    ledger_status := "fail"
    if type(dict_get_or(state, "completion_candidate", null)) == "dict" && type(dict_get_or(state, "evidence_failure", null)) != "dict" && state["status"] != "failed" { ledger_status = "pass" }
    ledger_run_id := string_or(dict_get_or(ledger, "run_id", ""), run_key)
    finished := runledger_finish(run_dir, ledger_run_id, ledger_status, verdict, "Evidence in " + run_dir)
    if ledger_status == "pass" && finished["ok"] == false {
        state["status"] := "failed"
        state["failure"] := {"class": "evidence_failure", "message": "RunLedger finish persistence did not pass", "repair_attempts": 0}
        state := add_event(state, run_dir, "run_failed", "runledger", "relay", state["failure"])
        ledger_status = "fail"
        finished = runledger_finish(run_dir, ledger_run_id, ledger_status, "Relay run failed: RunLedger finish persistence", "Evidence in " + run_dir)
    }
    state["runledger_finish"] := finished
    finish_receipt_result := record_receipt(state, run_dir, "runledger", "finish", "relay", run_dir + "/ledger", ledger_status, {"runledger_id": ledger_run_id, "ok": finished["ok"]})
    state = apply_receipt_result(state, finish_receipt_result)
    state = save_state(state, run_dir)
    completion_pending := ledger_status == "pass" && finished["ok"] && type(dict_get_or(state, "evidence_failure", null)) != "dict" && state["status"] != "failed"
    if completion_pending {
        candidate := dict_get_or(state, "completion_candidate", {})
        state := add_event(state, run_dir, "run_completed", "verify", "release-verifier", candidate)
        if type(dict_get_or(state, "evidence_failure", null)) == "dict" {
            completion_pending = false
        } else {
            state["status"] := "completed"
        }
    }
    report_result := report(state, run_dir)
    if dict_get_or(report_result, "ok", false) == false && completion_pending {
        state["status"] := "failed"
        state["failure"] := {"class": "evidence_failure", "message": "Required report artifact persistence did not pass", "repair_attempts": 0}
        state := add_event(state, run_dir, "run_failed", "report", "release-verifier", state["failure"])
        state = save_state(state, run_dir)
        state["runledger_finish"] := runledger_finish(run_dir, ledger_run_id, "fail", "Relay run failed: report evidence persistence", "Evidence in " + run_dir)
        report(state, run_dir)
    }
    if dict_get_or(report_result, "ok", false) && completion_pending { state = save_state(state, run_dir) }
    register_run(state, run_dir)
    return {"ok": state["status"] == "completed", "run": state, "run_dir": run_dir}
}

func pause_run(run_id) {
    store_check := state_store_ready()
    if store_check["ok"] == false { return {"ok": false, "failure_class": "state_store_failure", "error": store_check["error"]} }
    index := load_run_index(state_root())
    record := dict_get_or(index, run_id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + run_id} }
    state := read_json_limited(record["run_dir"] + "/state.json", null, 67108864)
    if type(state) != "dict" { return {"ok": false, "error": "run state missing"} }
    if state["status"] != "running" { return {"ok": false, "error": "only running runs can be paused; use --pause-after-plan for a resumable checkpoint"} }
    integrity := control_state_safe(state, run_id, record["run_dir"])
    if integrity["ok"] == false { return {"ok": false, "failure_class": "state_integrity_failure", "error": integrity["error"]} }
    state["status"] := "paused"
    state := add_event(state, record["run_dir"], "run_paused", "pause", "relay", {"reason": "operator_pause", "resumable": true})
    state = save_state(state, record["run_dir"])
    register_run(state, record["run_dir"])
    return {"ok": true, "run": state}
}

func cancel_run(run_id) {
    store_check := state_store_ready()
    if store_check["ok"] == false { return {"ok": false, "failure_class": "state_store_failure", "error": store_check["error"]} }
    index := load_run_index(state_root())
    record := dict_get_or(index, run_id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + run_id} }
    run_dir := string_or(dict_get_or(record, "run_dir", ""), "")
    if run_dir == "" || path_is_dir(run_dir) == false || path_is_symlink_safe(run_dir) { return {"ok": false, "error": "run directory is missing or unsafe"} }
    state := read_json_limited(run_dir + "/state.json", null, 67108864)
    if type(state) != "dict" { return {"ok": false, "error": "run state missing"} }
    status := string_or(dict_get_or(state, "status", ""), "")
    if status == "completed" || status == "failed" || status == "cancelled" { return {"ok": false, "error": "run is already terminal", "run": state} }
    integrity := control_state_safe(state, run_id, run_dir)
    if integrity["ok"] == false { return {"ok": false, "failure_class": "state_integrity_failure", "error": integrity["error"]} }
    if status == "paused" {
        state["status"] := "cancelled"
        state["current_step"] := ""
        state["cancellation"] := {"requested_at": now_iso(), "requested_by": "operator", "reason": "operator_cancel"}
        state := add_event(state, run_dir, "run_cancelled", "cancel", "relay", {"reason": "operator_cancel", "resumable": false})
        ledger_id := string_or(dict_get_or(dict_get_or(state, "runledger", {}), "run_id", ""), run_id)
        state["runledger_finish"] := runledger_finish(run_dir, ledger_id, "fail", "Relay run cancelled", "Evidence in " + run_dir)
        finish_receipt_result := record_receipt(state, run_dir, "runledger", "cancel", "relay", run_dir + "/ledger", "fail", {"runledger_id": ledger_id, "ok": state["runledger_finish"]["ok"], "cancelled": true})
        state = apply_receipt_result(state, finish_receipt_result)
        state = save_state(state, run_dir)
        report(state, run_dir)
        register_run(state, run_dir)
        return {"ok": true, "run": state, "status": "cancelled"}
    }
    request_path := run_dir + "/cancel.request.json"
    if path_is_symlink_safe(request_path) { return {"ok": false, "error": "cancellation request is a symbolic link"} }
    request := {"run_id": run_id, "requested_at": now_iso(), "requested_by": "operator", "reason": "operator_cancel"}
    request["integrity_sha256"] := sha256(cancellation_integrity_input(request))
    if write_json(request_path, request) == false { return {"ok": false, "error": "cancellation request could not be recorded"} }
    latest := read_json_limited(run_dir + "/state.json", state, 67108864)
    latest_status := string_or(dict_get_or(latest, "status", status), status)
    if latest_status == "completed" || latest_status == "failed" || latest_status == "cancelled" {
        if path_exists(request_path) && path_is_symlink_safe(request_path) == false { delete_file(request_path) }
        return {"ok": false, "error": "run completed before cancellation was requested", "run": latest}
    }
    return {"ok": true, "status": "cancellation_requested", "run": latest, "request": request}
}

func cleanup_run(run_id, confirmed) {
    if bool_or(confirmed, false) == false { return {"ok": false, "error": "worktree cleanup requires --confirm"} }
    store_check := state_store_ready()
    if store_check["ok"] == false { return {"ok": false, "failure_class": "state_store_failure", "error": store_check["error"]} }
    index := load_run_index(state_root())
    record := dict_get_or(index, run_id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + run_id} }
    state := read_json_limited(record["run_dir"] + "/state.json", null, 67108864)
    if type(state) != "dict" { return {"ok": false, "error": "run state missing"} }
    integrity := cleanup_state_safe(state, run_id, record["run_dir"])
    if integrity["ok"] == false { return {"ok": false, "failure_class": "state_integrity_failure", "error": integrity["error"]} }
    workspace := dict_get_or(state, "workspace", {})
    if type(workspace) != "dict" || dict_get_or(workspace, "mode", "provided") != "worktree" { return {"ok": false, "error": "run does not own an isolated worktree"} }
    if state["status"] == "running" { return {"ok": false, "error": "running worktrees cannot be cleaned"} }
    source_repo := string_or(dict_get_or(workspace, "source_repository", ""), "")
    worktree_path := string_or(dict_get_or(workspace, "path", ""), "")
    if source_repo == "" || worktree_path == "" { return {"ok": false, "error": "worktree metadata is incomplete"} }
    expected_worktree_path := record["run_dir"] + "/workspace"
    if worktree_path != expected_worktree_path || path_is_symlink_safe(worktree_path) { return {"ok": false, "error": "worktree cleanup target is not the run-owned workspace"} }
    mission_spec := dict_get_or(state, "mission_spec", {})
    expected_source_repo := string_or(dict_get_or(mission_spec, "repository", ""), "")
    if expected_source_repo != "" && source_repo != expected_source_repo { return {"ok": false, "error": "worktree source repository does not match the mission"} }
    if path_exists(worktree_path) == false { return {"ok": true, "cleaned": true, "already_missing": true, "run": state} }
    removed := spawn_process(["git", "-C", source_repo, "worktree", "remove", "--force", worktree_path], process_options({}, 60000, 65536))
    if removed.success == false { return {"ok": false, "error": "worktree cleanup failed", "stderr": redact_text(removed.stderr)} }
    workspace["cleaned"] := true
    workspace["cleanup_at"] := now_iso()
    state["workspace"] := workspace
    state = save_state(state, record["run_dir"])
    report(state, record["run_dir"])
    register_run(state, record["run_dir"])
    return {"ok": true, "cleaned": true, "run": state}
}

func resume_run(run_id, repair_requested) {
    store_check := state_store_ready()
    if store_check["ok"] == false { return {"ok": false, "failure_class": "state_store_failure", "error": store_check["error"]} }
    index := load_run_index(state_root())
    record := dict_get_or(index, run_id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + run_id} }
    state := read_json_limited(record["run_dir"] + "/state.json", null, 67108864)
    if type(state) != "dict" { return {"ok": false, "error": "run state missing"} }
    repairing := bool_or(repair_requested, false)
    checkpoint := dict_get_or(state, "checkpoint", null)
    prior_failure := dict_get_or(state, "failure", {})
    if repairing {
        if state["status"] != "failed" { return {"ok": false, "error": "repair requires a failed run"} }
        failure_class := string_or(dict_get_or(prior_failure, "class", ""), "")
        if repair_allowed(failure_class) == false { return {"ok": false, "failure_class": "repair_not_allowed", "error": "failure class is not eligible for bounded repair: " + failure_class} }
        repair_attempts := int_or(dict_get_or(state, "repair_attempts", 0), 0)
        max_repairs := int_or(dict_get_or(dict_get_or(state, "budgets", {}), "max_repairs", 0), 0)
        if repair_attempts >= max_repairs { return {"ok": false, "failure_class": "repair_budget_exceeded", "error": "mission max_repairs budget exhausted", "repair_attempts": repair_attempts, "max_repairs": max_repairs} }
    } else {
        if state["status"] != "paused" { return {"ok": false, "error": "run is not paused"} }
        if type(checkpoint) != "dict" || dict_get_or(checkpoint, "step", "") != "implementation" {
            return {"ok": false, "error": "run has no supported resumable checkpoint"}
        }
    }
    integrity := resume_state_safe(state, run_id, record["run_dir"])
    if integrity["ok"] == false { return {"ok": false, "failure_class": "state_integrity_failure", "error": integrity["error"]} }
    state["status"] := "running"
    if repairing {
        state["repair_attempts"] := int_or(dict_get_or(state, "repair_attempts", 0), 0) + 1
        state["repair_id"] := "repair-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999))
        state["repair_mode"] := true
        state["current_step"] := "implementation"
        repair_receipt_result := record_receipt(state, record["run_dir"], "repair", "repair", "relay", "repair/" + state["repair_id"], "started", {"repair_id": state["repair_id"], "attempt": state["repair_attempts"], "max_repairs": state["budgets"]["max_repairs"], "failure": prior_failure})
        state = apply_receipt_result(state, repair_receipt_result)
        repair_receipt := repair_receipt_result["receipt"]
        state := add_event(state, record["run_dir"], "repair_started", "repair", "relay", {"repair_id": state["repair_id"], "attempt": state["repair_attempts"], "failure": prior_failure, "receipt_id": repair_receipt["receipt_id"]})
    } else {
        state := add_event(state, record["run_dir"], "handoff_started", "resume", "relay", {"checkpoint": checkpoint})
    }
    actions := execute_actions(state["mission_spec"], state, record["run_dir"])
    state := actions["state"]
    state["action_results"] := actions["results"]
    if actions["ok"] == false {
        state["status"] := "failed"
        state["failure"] := {"class": dict_get_or(actions["failure"], "failure_class", "tool_failure"), "message": dict_get_or(actions["failure"], "error", "resumed action failed"), "repair_attempts": int_or(dict_get_or(state, "repair_attempts", 0), 0)}
        if repairing {
            repair_failure_receipt_result := record_receipt(state, record["run_dir"], "repair", "repair", "relay", "repair/" + state["repair_id"], "failed", {"repair_id": state["repair_id"], "attempt": state["repair_attempts"], "failure": state["failure"]})
            state = apply_receipt_result(state, repair_failure_receipt_result)
            repair_failure_receipt := repair_failure_receipt_result["receipt"]
            state := add_event(state, record["run_dir"], "repair_failed", "repair", "relay", {"repair_id": state["repair_id"], "failure": state["failure"], "receipt_id": repair_failure_receipt["receipt_id"]})
        }
        state := add_event(state, record["run_dir"], "run_failed", "implementation", "core-developer", state["failure"])
    } else {
        state["current_step"] := "verify"
        changes := changebucket(state["repository"], record["run_dir"])
        state["changes"] := dict_get_or(changes, "data", {"ok": changes["ok"]})
        changes_artifact := persist_required_json(record["run_dir"] + "/changes.json", state["changes"], "dict", "ChangeBucket")
        changes_ok := changes["ok"] && dict_get_or(changes_artifact, "ok", false)
        artifact_persistence := {"changes": changes_artifact}
        state["artifact_persistence"] := artifact_persistence
        changes_receipt_result := record_receipt(state, record["run_dir"], "changes", "resume", "release-verifier", record["run_dir"] + "/changes.json", evidence_status(changes_ok), {"ok": changes["ok"], "persisted": dict_get_or(changes_artifact, "ok", false)})
        state = apply_receipt_result(state, changes_receipt_result)
        changes_receipt := changes_receipt_result["receipt"]
        write_eval_config(record["run_dir"], state)
        evaluation := eval_run(record["run_dir"], "eval.json")
        state["evaluations"] := push(state["evaluations"], dict_get_or(evaluation, "data", {"ok": evaluation["ok"]}))
        evaluations_artifact := persist_required_json(record["run_dir"] + "/evaluations.json", state["evaluations"], "array", "Eval")
        evaluation_ok := evaluation["ok"] && dict_get_or(evaluations_artifact, "ok", false)
        artifact_persistence["evaluations"] := evaluations_artifact
        state["artifact_persistence"] := artifact_persistence
        evaluation_receipt_result := record_receipt(state, record["run_dir"], "evaluation", "resume", "release-verifier", record["run_dir"] + "/evaluations.json", evidence_status(evaluation_ok), {"ok": evaluation["ok"], "persisted": dict_get_or(evaluations_artifact, "ok", false)})
        state = apply_receipt_result(state, evaluation_receipt_result)
        evaluation_receipt := evaluation_receipt_result["receipt"]
        if changes_ok && evaluation_ok {
            state["status"] := "finalizing"
            state["current_step"] := ""
            if repairing {
                repair_success_receipt_result := record_receipt(state, record["run_dir"], "repair", "repair", "relay", "repair/" + state["repair_id"], "completed", {"repair_id": state["repair_id"], "attempt": state["repair_attempts"], "evaluation_ok": true, "changes_ok": true})
                state = apply_receipt_result(state, repair_success_receipt_result)
                repair_success_receipt := repair_success_receipt_result["receipt"]
                state := add_event(state, record["run_dir"], "repair_completed", "repair", "relay", {"repair_id": state["repair_id"], "attempt": state["repair_attempts"], "receipt_id": repair_success_receipt["receipt_id"]})
            }
            state["completion_candidate"] := {"resumed": true, "repaired": repairing, "repair_id": string_or(dict_get_or(state, "repair_id", ""), ""), "repair_attempts": int_or(dict_get_or(state, "repair_attempts", 0), 0), "evaluation_ok": true, "changes_ok": true, "changes_receipt_id": changes_receipt["receipt_id"], "evaluation_receipt_id": evaluation_receipt["receipt_id"]}
        } else {
            state["status"] := "failed"
            state["failure"] := {"class": "evidence_failure", "message": "Resumed acceptance evidence or required artifact persistence did not pass", "repair_attempts": int_or(dict_get_or(state, "repair_attempts", 0), 0)}
            if repairing {
                repair_eval_failure_receipt_result := record_receipt(state, record["run_dir"], "repair", "repair", "relay", "repair/" + state["repair_id"], "failed", {"repair_id": state["repair_id"], "attempt": state["repair_attempts"], "failure": state["failure"]})
                state = apply_receipt_result(state, repair_eval_failure_receipt_result)
                repair_eval_failure_receipt := repair_eval_failure_receipt_result["receipt"]
                state := add_event(state, record["run_dir"], "repair_failed", "repair", "relay", {"repair_id": state["repair_id"], "failure": state["failure"], "receipt_id": repair_eval_failure_receipt["receipt_id"]})
            }
            state := add_event(state, record["run_dir"], "run_failed", "resume", "release-verifier", state["failure"])
        }
    }
    state = save_state(state, record["run_dir"])
    ledger_id := string_or(dict_get_or(dict_get_or(state, "runledger", {}), "run_id", ""), run_id)
    ledger_status := "fail"
    if type(dict_get_or(state, "completion_candidate", null)) == "dict" && type(dict_get_or(state, "evidence_failure", null)) != "dict" && state["status"] != "failed" { ledger_status = "pass" }
    finish_verb := "resumed"
    if repairing { finish_verb = "repaired" }
    finished := runledger_finish(record["run_dir"], ledger_id, ledger_status, "Relay " + finish_verb + " run " + state["status"], "Evidence in " + record["run_dir"])
    if ledger_status == "pass" && finished["ok"] == false {
        state["status"] := "failed"
        state["failure"] := {"class": "evidence_failure", "message": "RunLedger finish persistence did not pass", "repair_attempts": 0}
        state := add_event(state, record["run_dir"], "run_failed", "runledger", "relay", state["failure"])
        ledger_status = "fail"
        finished = runledger_finish(record["run_dir"], ledger_id, ledger_status, "Relay resumed run failed: RunLedger finish persistence", "Evidence in " + record["run_dir"])
    }
    state["runledger_finish"] := finished
    finish_receipt_result := record_receipt(state, record["run_dir"], "runledger", "finish", "relay", record["run_dir"] + "/ledger", ledger_status, {"runledger_id": ledger_id, "ok": state["runledger_finish"]["ok"], "resumed": true, "repaired": repairing})
    state = apply_receipt_result(state, finish_receipt_result)
    state = save_state(state, record["run_dir"])
    completion_pending := ledger_status == "pass" && finished["ok"] && type(dict_get_or(state, "evidence_failure", null)) != "dict" && state["status"] != "failed"
    if completion_pending {
        candidate := dict_get_or(state, "completion_candidate", {})
        state := add_event(state, record["run_dir"], "run_completed", "resume", "release-verifier", candidate)
        if type(dict_get_or(state, "evidence_failure", null)) == "dict" {
            completion_pending = false
        } else {
            state["status"] := "completed"
        }
    }
    report_result := report(state, record["run_dir"])
    if dict_get_or(report_result, "ok", false) == false && completion_pending {
        state["status"] := "failed"
        state["failure"] := {"class": "evidence_failure", "message": "Required report artifact persistence did not pass", "repair_attempts": 0}
        state := add_event(state, record["run_dir"], "run_failed", "report", "release-verifier", state["failure"])
        state = save_state(state, record["run_dir"])
        state["runledger_finish"] := runledger_finish(record["run_dir"], ledger_id, "fail", "Relay resumed run failed: report evidence persistence", "Evidence in " + record["run_dir"])
        report(state, record["run_dir"])
    }
    if dict_get_or(report_result, "ok", false) && completion_pending { state = save_state(state, record["run_dir"]) }
    register_run(state, record["run_dir"])
    return {"ok": state["status"] == "completed", "run": state, "run_dir": record["run_dir"]}
}

export ensure_dir := ensure_dir
