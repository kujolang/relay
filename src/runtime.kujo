from src.common import dict_get_or, env_or, string_or, bool_or, int_or, now_iso, safe_id, read_json_or, write_json, append_jsonl, safe_json, shell_quote_single, write_text_atomic, process_options, redact_text
from src.contracts import run_state, event
from src.registry import find_agent
from src.policy import tool_decision, classify_failure, path_is_safe, path_is_within_workspace, command_is_allowed
from src.adapters import ai_chat, agents_sdk_smoke, packwrite_generate, runledger_start, runledger_finish, changebucket, eval_run

func ensure_dir(path) {
    if path == "" || path == "." || path_is_dir(path) { return }
    parts := split(path, "/")
    mut cur := ""
    if starts_with(path, "/") { cur = "/" }
    mut i := 0
    while i < len(parts) {
        part := parts[i]
        if part != "" && part != "." {
            if cur == "/" { cur = "/" + part } else if cur == "" { cur = part } else { cur = cur + "/" + part }
            if path_is_dir(cur) == false { create_dir(cur) }
        }
        i = i + 1
    }
}

func relay_root() { return env_or("RELAY_ROOT", ".") }
func state_root() { return relay_root() + "/.relay" }
func run_root() { return state_root() + "/runs" }
func index_path() { return state_root() + "/index.json" }

func save_state(state, run_dir) {
    state["updated_at"] := now_iso()
    write_json(run_dir + "/state.json", state)
    return state
}

func add_event(state, run_dir, kind, step_id, agent_id, payload) {
    parent := ""
    if len(state["events"]) > 0 { parent = dict_get_or(state["events"][len(state["events"]) - 1], "event_id", "") }
    item := event(kind, state["mission_id"], state["run_id"], step_id, agent_id, payload, parent)
    state["events"] := push(state["events"], item)
    append_jsonl(run_dir + "/events.jsonl", item)
    return state
}

func register_run(state, run_dir) {
    index := read_json_or(index_path(), {})
    index[state["run_id"]] := {"run_dir": run_dir, "mission_id": state["mission_id"], "status": state["status"]}
    write_json(index_path(), index)
}

func load_spec(path) {
    spec := read_json_or(path, null)
    if type(spec) != "dict" { return {"ok": false, "error": "Mission file is missing or invalid JSON: " + path} }
    if string_or(dict_get_or(spec, "name", ""), "") == "" { return {"ok": false, "error": "Mission requires name"} }
    if string_or(dict_get_or(spec, "goal", ""), "") == "" { return {"ok": false, "error": "Mission requires goal"} }
    actions := dict_get_or(spec, "actions", [])
    if type(actions) != "array" { return {"ok": false, "error": "Mission actions must be an array"} }
    if len(actions) > 32 { return {"ok": false, "error": "Mission exceeds the 32-action safety limit"} }
    budgets := dict_get_or(spec, "budgets", {})
    if type(budgets) != "dict" { return {"ok": false, "error": "Mission budgets must be an object"} }
    for key in ["max_steps", "max_repairs", "max_tokens"] {
        if has_key(budgets, key) {
            value := int_or(budgets[key], -1)
            if value < 0 { return {"ok": false, "error": "Mission budget " + key + " must be a non-negative integer"} }
        }
    }
    workspace_mode := string_or(dict_get_or(spec, "workspace_mode", "provided"), "provided")
    if workspace_mode != "provided" && workspace_mode != "worktree" { return {"ok": false, "error": "workspace_mode must be provided or worktree"} }
    repository := string_or(dict_get_or(spec, "repository", ""), "")
    if repository == "" || path_is_dir(repository) == false { return {"ok": false, "error": "Mission repository must be an existing directory"} }
    if path_exists(repository + "/.git") == false { return {"ok": false, "error": "Mission repository must be a Git workspace"} }
    if bool_or(dict_get_or(spec, "allow_writes", false), false) && dict_get_or(dict_get_or(spec, "approval", {}), "approved", false) != true {
        return {"ok": false, "error": "Write-enabled missions require approval.approved=true"}
    }
    return {"ok": true, "spec": spec}
}

func provision_worktree(source_repo, worktree_path, requested_commit) {
    commit_query := string_or(requested_commit, "HEAD")
    resolved := spawn_process(["git", "-C", source_repo, "rev-parse", "--verify", commit_query + "^{commit}"], process_options({}, 30000, 65536))
    if resolved.success == false { return {"ok": false, "error": "starting commit could not be resolved", "stderr": redact_text(resolved.stderr)} }
    commit := trim(resolved.stdout)
    if commit == "" { return {"ok": false, "error": "starting commit resolution returned no commit"} }
    created := spawn_process(["git", "-C", source_repo, "worktree", "add", "--detach", worktree_path, commit], process_options({}, 60000, 65536))
    if created.success == false { return {"ok": false, "error": "isolated worktree creation failed", "stderr": redact_text(created.stderr), "commit": commit} }
    return {"ok": true, "path": worktree_path, "source_repository": source_repo, "starting_commit": commit, "mode": "worktree", "stdout": redact_text(created.stdout)}
}

func write_prompt(run_dir, spec) {
    prompt := "# Relay mission\n\nName: " + to_string(spec["name"]) + "\nGoal: " + to_string(spec["goal"]) + "\n\nAcceptance criteria:\n"
    for criterion in dict_get_or(spec, "acceptance_criteria", []) { prompt = prompt + "- " + to_string(criterion) + "\n" }
    write_text_atomic(run_dir + "/MEGA_PROMPT.md", prompt)
    return run_dir + "/MEGA_PROMPT.md"
}

func execute_action(action, spec, state, run_dir) {
    kind := dict_get_or(action, "type", "")
    repo := state["repository"]
    policy := {
        "workspace": repo,
        "allow_writes": bool_or(dict_get_or(spec, "allow_writes", false), false),
        "allowed_commands": dict_get_or(spec, "allowed_commands", ["git", "kujo"])
    }
    if kind == "write_file" {
        decision := tool_decision("write_file", action, policy)
        if decision["allowed"] == false { return {"ok": false, "failure_class": "permission_denial", "error": decision["reason"]} }
        relative := action["path"]
        target := repo + "/" + relative
        if path_is_within_workspace(repo, relative) == false { return {"ok": false, "failure_class": "permission_denial", "error": "unsafe or symlinked path"} }
        try {
            if write_text_atomic(target, to_string(dict_get_or(action, "content", ""))) == false { return {"ok": false, "failure_class": "repository_failure", "error": "atomic write failed"} }
            return {"ok": true, "tool": "write_file", "path": relative}
        } except err { return {"ok": false, "failure_class": "repository_failure", "error": to_string(err)} }
    }
    if kind == "run_command" {
        command := string_or(dict_get_or(action, "command", ""), "")
        if command_is_allowed(command, policy) == false { return {"ok": false, "failure_class": "policy_violation", "error": "command_not_allowlisted"} }
        result := spawn_process(["/usr/bin/env", "-C", repo, "/bin/sh", "-lc", command], process_options({}, int_or(dict_get_or(action, "timeout_ms", 120000), 120000), 1048576))
        ok := result.success
        output_truncated := result.stdout_truncated
        if result.stderr_truncated { output_truncated = true }
        return {"ok": ok, "tool": "run_command", "command": redact_text(command), "stdout": redact_text(result.stdout), "stderr": redact_text(result.stderr), "timed_out": result.timed_out, "stdout_truncated": result.stdout_truncated, "stderr_truncated": result.stderr_truncated, "output_truncated": output_truncated, "failure_class": "tool_failure"}
    }
    return {"ok": false, "failure_class": "policy_violation", "error": "unknown_action_type"}
}

func execute_actions(spec, state, run_dir) {
    actions := dict_get_or(spec, "actions", [])
    results := []
    for action in actions {
        if state["attempt"] >= state["budgets"]["max_steps"] {
            return {"ok": false, "results": results, "state": state, "failure": {"failure_class": "budget_exceeded", "error": "Mission max_steps budget exceeded"}}
        }
        result := execute_action(action, spec, state, run_dir)
        results := push(results, result)
        state["attempt"] := state["attempt"] + 1
        if result["ok"] == false { return {"ok": false, "results": results, "state": state, "failure": result} }
    }
    return {"ok": true, "results": results, "state": state}
}

func write_eval_config(run_dir, state) {
    repo := state["repository"]
    mut tests := [
        {"name": "git diff check", "check": "command_succeeds", "params": {"command": "git -C " + shell_quote_single(repo) + " diff --check"}}
    ]
    for action in dict_get_or(state["mission_spec"], "actions", []) {
        if dict_get_or(action, "type", "") == "write_file" {
            relative := string_or(dict_get_or(action, "path", ""), "")
            if relative != "" {
                tests := push(tests, {"name": "file exists: " + relative, "check": "command_succeeds", "params": {"command": "test -f " + shell_quote_single(repo + "/" + relative)}})
            }
        }
    }
    config := {
        "name": "relay-" + state["mission_id"],
        "description": "Deterministic Relay acceptance checks",
        "version": "1.0.0",
        "output_dir": "./eval_results",
        "allowed_paths": [repo],
        "tests": tests
    }
    path := run_dir + "/eval.json"
    write_json(path, config)
    return path
}

func report(state, run_dir) {
    json_path := run_dir + "/report.json"
    write_json(json_path, state)
    failure := dict_get_or(state, "failure", {})
    failure_line := "- Failure: none\n"
    if type(failure) == "dict" && len(failure) > 0 { failure_line = "- Failure: " + to_string(dict_get_or(failure, "class", "unknown")) + " — " + to_string(dict_get_or(failure, "message", "")) + "\n" }
    markdown := "# Relay Run Report\n\n- Mission: " + state["mission_id"] + "\n- Run: " + state["run_id"] + "\n- Status: " + state["status"] + "\n- Current step: " + to_string(dict_get_or(state, "current_step", "")) + "\n- Workflow: " + state["workflow"] + "\n- Repository: " + state["repository"] + "\n" + failure_line + "\n## Evidence\n\n- Events: events.jsonl\n- Packet: agent/\n- Changes: changes.json\n- Evaluations: evaluations.json\n- JSON report: report.json\n"
    write_text_atomic(run_dir + "/report.md", markdown)
}

func create_mission(path, output_path) {
    name := "verified-feature"
    goal := "Execute one bounded, policy-controlled repository task and preserve evidence."
    spec := {"version": "0.1.0", "name": name, "goal": goal, "workflow": "verified-feature", "repository": ".", "allow_writes": false, "acceptance_criteria": ["deterministic checks pass"], "actions": []}
    if path != "" {
        loaded := load_spec(path)
        if loaded["ok"] == false { return loaded }
        spec = loaded["spec"]
    }
    if output_path == "" { output_path = state_root() + "/missions/" + name + ".json" }
    ensure_dir(state_root() + "/missions")
    write_json(output_path, spec)
    return {"ok": true, "path": output_path, "mission": spec}
}

func run_mission(path, options) {
    loaded := load_spec(path)
    if loaded["ok"] == false { return loaded }
    spec := loaded["spec"]
    ensure_dir(run_root())
    mission_id := safe_id(string_or(dict_get_or(spec, "id", dict_get_or(spec, "name", "mission")), "mission"), "mission")
    run_key := mission_id + "-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 999999))
    run_dir := run_root() + "/" + run_key
    ensure_dir(run_dir)
    source_repo := string_or(dict_get_or(spec, "repository", "."), ".")
    repo := source_repo
    workspace := {"mode": "provided", "source_repository": source_repo, "path": source_repo}
    if string_or(dict_get_or(spec, "workspace_mode", "provided"), "provided") == "worktree" {
        worktree := provision_worktree(source_repo, run_dir + "/workspace", dict_get_or(spec, "starting_commit", "HEAD"))
        if worktree["ok"] == false { return {"ok": false, "error": worktree["error"], "workspace": worktree} }
        repo = worktree["path"]
        workspace = worktree
    }
    state := run_state(mission_id, string_or(dict_get_or(spec, "workflow", "verified-feature"), "verified-feature"), repo, run_key)
    state["mission_spec"] := spec
    state["workspace"] := workspace
    configured_budgets := dict_get_or(spec, "budgets", {})
    budgets := state["budgets"]
    for key in ["max_steps", "max_repairs", "max_tokens"] {
        if has_key(configured_budgets, key) { budgets[key] := int_or(configured_budgets[key], budgets[key]) }
    }
    state["budgets"] := budgets
    ledger := runledger_start(run_dir, string_or(dict_get_or(spec, "model", "fixture-model"), "fixture-model"), string_or(dict_get_or(spec, "provider", "fixture"), "fixture"), to_string(spec["name"]), repo)
    state["runledger"] := ledger
    state["status"] := "running"
    state["current_step"] := "plan"
    register_run(state, run_dir)
    state := add_event(state, run_dir, "run_started", "", "relay", {"workflow": state["workflow"], "repository": repo, "source_repository": source_repo, "workspace": workspace})
    prompt := write_prompt(run_dir, spec)
    packet := packwrite_generate(run_dir, "MEGA_PROMPT.md", run_dir + "/agent")
    packet_artifact := {"kind": "packwrite_agent_pack", "path": packet["artifact_dir"], "ok": packet["ok"], "revision": 1}
    if path_exists(run_dir + "/agent/MASTER.md") { packet_artifact["integrity_sha256"] := sha256_file(run_dir + "/agent/MASTER.md") }
    state["artifacts"] := push(state["artifacts"], packet_artifact)
    state := add_event(state, run_dir, "artifact_created", "packet", "planner", packet_artifact)
    agent_sdk := {"ok": true, "skipped": true, "reason": "configured skip"}
    if bool_or(dict_get_or(options, "agents_sdk_smoke", true), true) { agent_sdk = agents_sdk_smoke() }
    state["agent_sdk"] := agent_sdk
    state := add_event(state, run_dir, "artifact_created", "agent-sdk", "planner", {"kind": "agents_sdk_offline_smoke", "ok": agent_sdk["ok"]})
    planner := find_agent("planner")
    model_result := ai_chat([{"role": "system", "content": planner["mandate"]}, {"role": "user", "content": to_string(spec["goal"])}], string_or(dict_get_or(spec, "model", "fixture-model"), "fixture-model"), string_or(dict_get_or(spec, "provider", "fixture"), "fixture"), bool_or(dict_get_or(options, "offline_fixture", true), true), bool_or(dict_get_or(options, "stream", false), false))
    state["telemetry"] := dict_get_or(model_result, "relay_telemetry", {})
    usage := dict_get_or(model_result, "usage", {})
    used_tokens := int_or(dict_get_or(usage, "total_tokens", 0), 0)
    budgets := dict_get_or(state, "budgets", {})
    budgets["used_tokens"] := used_tokens
    state["budgets"] := budgets
    state := add_event(state, run_dir, "model_request_completed", "plan", "planner", {"ok": dict_get_or(model_result, "ok", false), "telemetry": state["telemetry"]})
    preflight_ok := ledger["ok"] && packet["ok"] && agent_sdk["ok"] && dict_get_or(model_result, "ok", false) && used_tokens <= state["budgets"]["max_tokens"]
    if preflight_ok && bool_or(dict_get_or(options, "pause_after_plan", false), false) {
        state["status"] := "paused"
        state["current_step"] := "implementation"
        state["checkpoint"] := {"step": "implementation", "reason": "pause_after_plan", "created_at": now_iso()}
        state := add_event(state, run_dir, "run_cancelled", "implementation", "relay", {"reason": "checkpoint_requested", "resumable": true})
        save_state(state, run_dir)
        report(state, run_dir)
        register_run(state, run_dir)
        return {"ok": true, "run": state, "run_dir": run_dir}
    }
    mut actions := {"ok": false, "results": [], "state": state, "failure": {"failure_class": "integration_failure", "error": "mission preflight failed"}}
    if preflight_ok {
        state["current_step"] := "implementation"
        actions = execute_actions(spec, state, run_dir)
    }
    state := actions["state"]
    state["action_results"] := actions["results"]
    if actions["ok"] == false {
        state["status"] := "failed"
        failure_class := dict_get_or(actions["failure"], "failure_class", "tool_failure")
        if preflight_ok == false { failure_class = "integration_failure" }
        state["failure"] := {"class": failure_class, "message": dict_get_or(actions["failure"], "error", "action or preflight failed"), "repair_attempts": 0}
        state := add_event(state, run_dir, "run_failed", "implementation", "core-developer", state["failure"])
    } else {
        state["current_step"] := "verify"
        state := add_event(state, run_dir, "tool_call_completed", "implementation", "core-developer", {"actions": len(actions["results"]), "ok": true})
        changes := changebucket(repo, run_dir)
        state["changes"] := dict_get_or(changes, "data", {"ok": changes["ok"]})
        write_json(run_dir + "/changes.json", state["changes"])
        eval_path := write_eval_config(run_dir, state)
        evaluation := eval_run(run_dir, "eval.json")
        state["evaluations"] := push(state["evaluations"], dict_get_or(evaluation, "data", {"ok": evaluation["ok"]}))
        write_json(run_dir + "/evaluations.json", state["evaluations"])
        if evaluation["ok"] == false || changes["ok"] == false {
            state["status"] := "failed"
            failure_class := "evaluation_failure"
            if changes["ok"] == false { failure_class = "evidence_failure" }
            state["failure"] := {"class": failure_class, "message": "Acceptance evidence did not pass", "repair_attempts": 0}
            state := add_event(state, run_dir, "run_failed", "verify", "release-verifier", {"evaluation_ok": evaluation["ok"], "changes_ok": changes["ok"], "failure": state["failure"]})
        } else {
            state["status"] := "completed"
            state["current_step"] := ""
            state := add_event(state, run_dir, "run_completed", "verify", "release-verifier", {"evaluation_ok": true, "changes_ok": true})
        }
    }
    save_state(state, run_dir)
    verdict := "Relay run " + state["status"]
    ledger_status := "fail"
    if state["status"] == "completed" { ledger_status = "pass" }
    ledger_run_id := string_or(dict_get_or(ledger, "run_id", ""), run_key)
    finished := runledger_finish(run_dir, ledger_run_id, ledger_status, verdict, "Evidence in " + run_dir)
    state["runledger_finish"] := finished
    save_state(state, run_dir)
    report(state, run_dir)
    register_run(state, run_dir)
    return {"ok": state["status"] == "completed", "run": state, "run_dir": run_dir}
}

func pause_run(run_id) {
    index := read_json_or(index_path(), {})
    record := dict_get_or(index, run_id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + run_id} }
    state := read_json_or(record["run_dir"] + "/state.json", null)
    if type(state) != "dict" { return {"ok": false, "error": "run state missing"} }
    if state["status"] != "running" { return {"ok": false, "error": "only running runs can be paused; use --pause-after-plan for a resumable checkpoint"} }
    state["status"] := "paused"
    state := add_event(state, record["run_dir"], "run_cancelled", "pause", "relay", {"reason": "operator_pause", "resumable": true})
    save_state(state, record["run_dir"])
    register_run(state, record["run_dir"])
    return {"ok": true, "run": state}
}

func cleanup_run(run_id, confirmed) {
    if bool_or(confirmed, false) == false { return {"ok": false, "error": "worktree cleanup requires --confirm"} }
    index := read_json_or(index_path(), {})
    record := dict_get_or(index, run_id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + run_id} }
    state := read_json_or(record["run_dir"] + "/state.json", null)
    if type(state) != "dict" { return {"ok": false, "error": "run state missing"} }
    workspace := dict_get_or(state, "workspace", {})
    if type(workspace) != "dict" || dict_get_or(workspace, "mode", "provided") != "worktree" { return {"ok": false, "error": "run does not own an isolated worktree"} }
    if state["status"] == "running" { return {"ok": false, "error": "running worktrees cannot be cleaned"} }
    source_repo := string_or(dict_get_or(workspace, "source_repository", ""), "")
    worktree_path := string_or(dict_get_or(workspace, "path", ""), "")
    if source_repo == "" || worktree_path == "" { return {"ok": false, "error": "worktree metadata is incomplete"} }
    if path_exists(worktree_path) == false { return {"ok": true, "cleaned": true, "already_missing": true, "run": state} }
    removed := spawn_process(["git", "-C", source_repo, "worktree", "remove", "--force", worktree_path], process_options({}, 60000, 65536))
    if removed.success == false { return {"ok": false, "error": "worktree cleanup failed", "stderr": redact_text(removed.stderr)} }
    workspace["cleaned"] := true
    workspace["cleanup_at"] := now_iso()
    state["workspace"] := workspace
    save_state(state, record["run_dir"])
    report(state, record["run_dir"])
    register_run(state, record["run_dir"])
    return {"ok": true, "cleaned": true, "run": state}
}

func resume_run(run_id) {
    index := read_json_or(index_path(), {})
    record := dict_get_or(index, run_id, null)
    if type(record) != "dict" { return {"ok": false, "error": "unknown run: " + run_id} }
    state := read_json_or(record["run_dir"] + "/state.json", null)
    if type(state) != "dict" { return {"ok": false, "error": "run state missing"} }
    if state["status"] != "paused" { return {"ok": false, "error": "run is not paused"} }
    checkpoint := dict_get_or(state, "checkpoint", null)
    if type(checkpoint) != "dict" || dict_get_or(checkpoint, "step", "") != "implementation" {
        return {"ok": false, "error": "run has no supported resumable checkpoint"}
    }
    state["status"] := "running"
    state := add_event(state, record["run_dir"], "handoff_started", "resume", "relay", {"checkpoint": checkpoint})
    actions := execute_actions(state["mission_spec"], state, record["run_dir"])
    state := actions["state"]
    state["action_results"] := actions["results"]
    if actions["ok"] == false {
        state["status"] := "failed"
        state["failure"] := {"class": dict_get_or(actions["failure"], "failure_class", "tool_failure"), "message": dict_get_or(actions["failure"], "error", "resumed action failed"), "repair_attempts": 0}
        state := add_event(state, record["run_dir"], "run_failed", "implementation", "core-developer", state["failure"])
    } else {
        state["current_step"] := "verify"
        changes := changebucket(state["repository"], record["run_dir"])
        state["changes"] := dict_get_or(changes, "data", {"ok": changes["ok"]})
        write_json(record["run_dir"] + "/changes.json", state["changes"])
        write_eval_config(record["run_dir"], state)
        evaluation := eval_run(record["run_dir"], "eval.json")
        state["evaluations"] := push(state["evaluations"], dict_get_or(evaluation, "data", {"ok": evaluation["ok"]}))
        write_json(record["run_dir"] + "/evaluations.json", state["evaluations"])
        if changes["ok"] && evaluation["ok"] {
            state["status"] := "completed"
            state["current_step"] := ""
            state := add_event(state, record["run_dir"], "run_completed", "resume", "release-verifier", {"resumed": true, "evaluation_ok": true, "changes_ok": true})
        } else {
            state["status"] := "failed"
            state["failure"] := {"class": "evidence_failure", "message": "Resumed acceptance evidence did not pass", "repair_attempts": 0}
            state := add_event(state, record["run_dir"], "run_failed", "resume", "release-verifier", state["failure"])
        }
    }
    save_state(state, record["run_dir"])
    ledger_id := string_or(dict_get_or(dict_get_or(state, "runledger", {}), "run_id", ""), run_id)
    ledger_status := "fail"
    if state["status"] == "completed" { ledger_status = "pass" }
    state["runledger_finish"] := runledger_finish(record["run_dir"], ledger_id, ledger_status, "Relay resumed run " + state["status"], "Evidence in " + record["run_dir"])
    save_state(state, record["run_dir"])
    report(state, record["run_dir"])
    register_run(state, record["run_dir"])
    return {"ok": state["status"] == "completed", "run": state, "run_dir": record["run_dir"]}
}

export ensure_dir := ensure_dir
export load_spec := load_spec
export create_mission := create_mission
export run_mission := run_mission
export pause_run := pause_run
export cleanup_run := cleanup_run
export resume_run := resume_run
export state_root := state_root
export run_root := run_root
