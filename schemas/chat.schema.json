{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/relay/schemas/chat.schema.json",
  "title": "Kujo Relay chat result",
  "type": "object",
  "required": ["ok", "model", "provider", "output_text", "usage", "relay_telemetry"],
  "properties": {
    "ok": {"type": "boolean"},
    "model": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "output_text": {"type": "string"},
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "relay_telemetry": {
      "type": "object",
      "required": ["correlation_id", "route"],
      "properties": {
        "correlation_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "route": {"enum": ["direct_ai_sdk", "watchdog_proxy"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
