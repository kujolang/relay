{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/relay/schemas/machine-request-v2.schema.json",
  "title": "Relay machine authorization request v2",
  "type": "object",
  "required": [
    "identity",
    "tenant",
    "action",
    "resource",
    "request_id",
    "expires_at_ms",
    "contract_version"
  ],
  "properties": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "action": {
      "enum": [
        "runs.read.list",
        "runs.read.show",
        "runs.read.events",
        "runs.read.export",
        "runs.read.verify",
        "runs.cancel",
        "runs.cleanup",
        "missions.run"
      ]
    },
    "expires_at_ms": {
      "type": "integer"
    },
    "contract_version": {
      "const": "relay-machine-request-v2"
    }
  },
  "additionalProperties": false
}
