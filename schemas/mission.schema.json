{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/relay/schemas/mission.schema.json",
  "title": "Kujo Relay mission",
  "type": "object",
  "required": ["name", "goal", "repository", "actions"],
  "properties": {
    "version": {"type": "string"},
    "id": {"type": "string", "maxLength": 160},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "goal": {"type": "string", "minLength": 1, "maxLength": 65536},
    "workflow": {"type": "string"},
    "repository": {"type": "string", "minLength": 1},
    "starting_commit": {"type": "string"},
    "workspace_mode": {"enum": ["provided", "worktree"]},
    "allow_writes": {"type": "boolean"},
    "approval": {"type": "object"},
    "model": {"type": "string"},
    "provider": {"type": "string"},
    "allowed_commands": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "allowed_script_hashes": {"type": "object", "maxProperties": 16, "patternProperties": {"^scripts/[A-Za-z0-9._/-]+\\.sh$": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}, "additionalProperties": false},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "budgets": {
      "type": "object",
      "properties": {
        "max_steps": {"type": "integer", "minimum": 0},
        "max_repairs": {"type": "integer", "minimum": 0, "maximum": 4},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_tool_turns": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "max_write_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
      },
      "additionalProperties": true
    },
    "agent_tools": {"type": "array", "maxItems": 16},
    "agent_tool_mode": {"enum": ["declared", "provider"]},
    "agent_tool_allowlist": {"type": "array", "items": {"enum": ["relay.write_file", "relay.run_command"]}, "maxItems": 2, "uniqueItems": true},
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"enum": ["write_file", "run_command"]},
          "path": {"type": "string", "maxLength": 4096},
          "content": {"type": "string", "maxLength": 1048576},
          "command": {"type": "string", "maxLength": 16384},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}
        }
      }
    }
  },
  "additionalProperties": true
}
