{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/relay/schemas/tool-result-bundle.schema.json",
  "title": "Kujo Relay provider tool-result bundle",
  "type": "object",
  "required": ["contract_version", "run_id", "results"],
  "properties": {
    "contract_version": {"const": "relay-tool-result-bundle-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "results": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["turn", "provider_call_id", "tool_name", "result"],
        "properties": {
          "turn": {"type": "integer", "minimum": 1, "maximum": 4},
          "provider_call_id": {"type": "string", "minLength": 1},
          "tool_name": {"type": "string", "minLength": 1},
          "result": {"$ref": "tool-result.schema.json"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
