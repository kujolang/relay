{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/relay/schemas/doctor.schema.json",
  "title": "Kujo Relay doctor result",
  "type": "object",
  "required": ["ok", "mode", "required_failures", "checks"],
  "properties": {
    "ok": {"type": "boolean"},
    "mode": {"enum": ["fixture", "live"]},
    "required_failures": {"type": "integer", "minimum": 0},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "ok", "required", "safe"]}}
  },
  "additionalProperties": true
}
