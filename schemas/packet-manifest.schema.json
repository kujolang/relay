{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/relay/schemas/packet-manifest.schema.json",
  "title": "Kujo Relay PackWrite packet manifest",
  "type": "object",
  "required": ["contract_version", "run_id", "mission_id", "packet_revision", "root", "summary", "entries"],
  "properties": {
    "contract_version": {"const": "relay-packwrite-manifest-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "packet_revision": {"type": "integer", "minimum": 1},
    "root": {"const": "agent"},
    "summary": {"type": "object", "required": ["bytes", "files", "directories"], "properties": {"bytes": {"type": "integer", "minimum": 0}, "files": {"type": "integer", "minimum": 1, "maximum": 256}, "directories": {"type": "integer", "minimum": 1, "maximum": 256}}, "additionalProperties": false},
    "entries": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "required": ["path", "kind", "bytes", "integrity_sha256"], "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "kind": {"const": "file"}, "bytes": {"type": "integer", "minimum": 0}, "integrity_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
