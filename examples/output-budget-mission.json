{
  "version": "0.1.0",
  "id": "relay-output-budget",
  "name": "relay-output-budget",
  "goal": "Prove command evidence is bounded and truncation is explicit.",
  "workflow": "verified-feature",
  "repository": "/tmp/relay-output-budget-workspace",
  "model": "fixture-model",
  "provider": "fixture",
  "allow_writes": true,
  "approval": {"approved": true, "actor": "fixture-operator", "reason": "bounded output smoke"},
  "budgets": {"max_steps": 4, "max_repairs": 0, "max_tokens": 4000, "max_output_bytes": 16, "max_write_bytes": 128},
  "actions": [
    {"type": "write_file", "path": "OUTPUT_BUDGET.txt", "content": "This content makes the git diff larger than the command evidence budget.\n"},
    {"type": "run_command", "command": "git status --short"}
  ]
}
