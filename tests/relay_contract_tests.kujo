from src.contracts import event, event_integrity_valid, event_chain_integrity_valid, event_sequence_matches_state, receipt, receipt_integrity_valid, receipt_sequence_valid, receipt_sequence_matches_state, run_state, agent_profile, RELAY_VERSION, EVENT_CONTRACT, RECEIPT_CONTRACT
from src.policy import classify_failure, path_is_safe, path_is_within_workspace, command_is_allowed, tool_decision
from src.runtime import resume_state_safe, cleanup_state_safe, control_state_safe, save_state, mark_evidence_failure, cancellation_request, persist_required_json, report
from src.common import safe_id, redact_text, shell_quote_single, command_args, process_options, process_options_with_cancel, safe_env_name, path_is_symlink_safe, path_has_symlink_component, path_has_parent_component, read_json_limited, append_jsonl, dict_get_or, bool_or, safe_json
from src.adapters import fallback_allowed, watchdog_route_allowed
from src.store import safe_run_key, store_root_safe, acquire_index_lock, acquire_index_lock_retry, release_index_lock
from src.watchdog import safe_base, safe_correlation_id, route_policy

func check(label, condition) {
    if condition { print("PASS " + label); return 0 }
    print("FAIL " + label); return 1
}

failed := 0
failed = failed + check("version", RELAY_VERSION == "0.1.0")
failed = failed + check("event contract", EVENT_CONTRACT == "AgentEvent-compatible-v1")
failed = failed + check("receipt contract", RECEIPT_CONTRACT == "relay-receipt-v1")
e := event("run_started", "m1", "r1", "s1", "a1", {"ok": true}, "")
failed = failed + check("event required fields", has_key(e, "run_id") && has_key(e, "payload") && has_key(e, "metadata"))
failed = failed + check("event integrity", event_integrity_valid(e))
tampered_payload := e["payload"]
tampered_payload["tampered"] := true
e["payload"] := tampered_payload
failed = failed + check("tampered event rejected", event_integrity_valid(e) == false)
chain_first := event("run_started", "m1", "r1", "s1", "a1", {"ok": true}, "")
chain_second := event("run_completed", "m1", "r1", "s2", "a1", {"ok": true}, chain_first["event_id"])
failed = failed + check("event chain integrity", event_chain_integrity_valid([chain_first, chain_second]))
failed = failed + check("event sequence matches state", event_sequence_matches_state([chain_first, chain_second], [chain_first, chain_second]))
failed = failed + check("event sequence truncation rejected", event_sequence_matches_state([chain_first, chain_second], [chain_first]) == false)
state_event_tamper := chain_first
state_event_tamper["payload"] := {"state_only_tamper": true}
failed = failed + check("event state payload divergence rejected", event_sequence_matches_state([state_event_tamper, chain_second], [chain_first, chain_second]) == false)
chain_second["parent_event_id"] := "tampered-parent"
failed = failed + check("event chain tamper rejected", event_chain_integrity_valid([chain_first, chain_second]) == false)
r := receipt("artifact", "m1", "r1", "s1", "a1", "agent/MASTER.md", "completed", {"ok": true})
failed = failed + check("receipt required fields", has_key(r, "receipt_id") && has_key(r, "artifact_ref") && has_key(r, "integrity_sha256") && has_key(r, "metadata"))
failed = failed + check("receipt integrity", receipt_integrity_valid(r))
failed = failed + check("receipt sequence integrity", receipt_sequence_valid([r]))
failed = failed + check("receipt sequence matches state", receipt_sequence_matches_state([r], [r]))
r["status"] := "tampered"
failed = failed + check("tampered receipt rejected", receipt_integrity_valid(r) == false)
s := run_state("m1", "verified-feature", ".", "r1")
failed = failed + check("run state", s["status"] == "created" && s["run_id"] == "r1")
a := agent_profile("planner", "Planner", "plan", "fixture-model", ["read_repo"], "read_only")
failed = failed + check("agent authority", a["authority"] == "read_only")
failed = failed + check("safe relative path", path_is_safe(".", "src/file.txt"))
failed = failed + check("parent component identified", path_has_parent_component("../outside"))
failed = failed + check("safe sibling path inspected", path_has_symlink_component("./../ai-sdk") == false)
failed = failed + check("state store parent component denied", store_root_safe("../relay-contract-store") == false)
failed = failed + check("unsafe traversal", path_is_safe(".", "../secret") == false)
failed = failed + check("nested traversal", path_is_safe(".", "src/../secret") == false)
failed = failed + check("secret file denied", path_is_safe(".", ".env") == false)
failed = failed + check("workspace containment", path_is_within_workspace(".", "src/common.kujo"))
failed = failed + check("safe command", command_is_allowed("git status", {"allowed_commands": ["git"]}))
failed = failed + check("safe Git status option", command_is_allowed("git status --porcelain", {"allowed_commands": ["git"]}))
failed = failed + check("safe Git diff check", command_is_allowed("git diff --check", {"allowed_commands": ["git"]}))
failed = failed + check("Git pathspec denied", command_is_allowed("git diff /etc/passwd", {"allowed_commands": ["git"]}) == false)
failed = failed + check("Git unknown subcommand denied", command_is_allowed("git status-malicious", {"allowed_commands": ["git"]}) == false)
failed = failed + check("unsafe git command", command_is_allowed("git commit -am unsafe", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked command", command_is_allowed("rm -rf /", {"allowed_commands": ["rm"]}) == false)
failed = failed + check("blocked push", command_is_allowed("git push --force", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked shell chain", command_is_allowed("git status; touch escaped", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked env expansion", command_is_allowed("git status $HOME", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked glob expansion", command_is_allowed("git status *", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked shell background", command_is_allowed("git status &", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked quoted shell form", command_is_allowed("git status 'README.md'", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked git output flag", command_is_allowed("git diff --output=/tmp/escape", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked external diff", command_is_allowed("git diff --ext-diff", {"allowed_commands": ["git"]}) == false)
failed = failed + check("script arguments denied", command_is_allowed("bash scripts/check.sh --unsafe", {"allowed_commands": ["bash"]}) == false)
failed = failed + check("safe Kujo test command", command_is_allowed("kujo test", {"allowed_commands": ["kujo"]}))
failed = failed + check("unsafe Kujo test path denied", command_is_allowed("kujo test /tmp/evil.kujo", {"workspace": ".", "allowed_commands": ["kujo"]}) == false)
failed = failed + check("unsafe Kujo script path denied", command_is_allowed("kujo run /tmp/evil.kujo", {"workspace": ".", "allowed_commands": ["kujo"]}) == false)
failed = failed + check("safe Kujo workspace script", command_is_allowed("kujo run scripts/check.kujo", {"workspace": ".", "allowed_commands": ["kujo"]}))
failed = failed + check("shell quote", contains(shell_quote_single("repo's path"), "'\"'\"'"))
argv := command_args("git status --short")
failed = failed + check("direct command argv", len(argv) == 3 && argv[0] == "git" && argv[2] == "--short")
failed = failed + check("tabbed command denied", command_is_allowed("git status\t--short", {"allowed_commands": ["git"]}) == false)
process := process_options({"RELAY_TEST_ENV": "ok"}, 1000, 4096)
failed = failed + check("bounded process environment", process["inherit_env"] == false && process["max_output_bytes"] == 4096 && has_key(process["env"], "RELAY_TEST_ENV"))
cancel_options := process_options_with_cancel({}, 1000, 4096, "/tmp/relay-cancel-contract.request")
failed = failed + check("process cancellation hook", cancel_options["cancel_file"] == "/tmp/relay-cancel-contract.request")
failed = failed + check("fixed process PATH", process["env"]["PATH"] == "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin")
failed = failed + check("safe API env name", safe_env_name("OLLAMA_API_KEY") && safe_env_name("VENDOR_TOKEN_1"))
failed = failed + check("reserved API env name denied", safe_env_name("PATH") == false)
failed = failed + check("invalid API env name denied", safe_env_name("OPENAI-API-KEY") == false)
failed = failed + check("dynamic loader env denied", safe_env_name("LD_PRELOAD") == false && safe_env_name("DYLD_INSERT_LIBRARIES") == false)
failed = failed + check("interpreter injection env denied", safe_env_name("PYTHONPATH") == false && safe_env_name("BASH_ENV") == false && safe_env_name("NODE_OPTIONS") == false)
failed = failed + check("Git override env denied", safe_env_name("GIT_CONFIG_GLOBAL") == false && safe_env_name("GIT_EXTERNAL_DIFF") == false)
failed = failed + check("missing symlink probe is safe", path_is_symlink_safe("/tmp/relay-contract-missing-symlink") == false)
failed = failed + check("symlink probe errors fail closed", path_is_symlink_safe(123) == true)
probe_path := env_or("RELAY_SYMLINK_PROBE_PATH", "/tmp/relay-contract-missing-symlink")
probe_expected := bool_or(env_or("RELAY_EXPECT_SYMLINK_PROBE", "false"), false)
failed = failed + check("configured symlink probe boundary", path_is_symlink_safe(probe_path) == probe_expected)
store_probe_path := env_or("RELAY_STORE_PROBE_PATH", "")
if store_probe_path != "" { failed = failed + check("parent symlink store rejected", path_has_symlink_component(store_probe_path)) }
dependency_probe_path := env_or("RELAY_DEPENDENCY_PROBE_PATH", "")
if dependency_probe_path != "" { failed = failed + check("parent symlink dependency rejected", path_has_symlink_component(dependency_probe_path)) }
dangling_append_path := env_or("RELAY_DANGLING_APPEND_PATH", "")
if dangling_append_path != "" { failed = failed + check("dangling JSONL append rejected", append_jsonl(dangling_append_path, {"probe": true}) == false) }
cancel_probe_dir := env_or("RELAY_DANGLING_CANCEL_RUN_DIR", "")
if cancel_probe_dir != "" { failed = failed + check("dangling cancellation request rejected", cancellation_request(cancel_probe_dir)["ok"] == false) }
decision := tool_decision("write_file", {"path": "x.txt"}, {"workspace": ".", "allow_writes": false})
failed = failed + check("write approval boundary", decision["status"] == "approval_required")
failed = failed + check("unknown tool denied", tool_decision("unknown", {}, {})["allowed"] == false)
failed = failed + check("safe id", safe_id("feature/name", "fallback") == "feature-name")
failed = failed + check("redaction", contains(redact_text("Authorization: Bearer secret"), "[REDACTED]"))
expanded_redaction := redact_text("ANTHROPIC_API_KEY=secret")
failed = failed + check("expanded redaction", contains(expanded_redaction, "[REDACTED]") || contains(expanded_redaction, "[REDACTED_CREDENTIAL]"))
failed = failed + check("Watchdog token redaction", contains(redact_text("X-Watchdog-Token: relay-api-token"), "[REDACTED_CREDENTIAL]"))
failed = failed + check("generic secret redaction", contains(redact_text("RELAY_WATCHDOG_PROXY_TOKEN=relay-proxy-token"), "[REDACTED_CREDENTIAL]"))
json_redaction := redact_text("{\"api_key\":\"json-secret\",\"access_token\":\"access-secret\",\"password\":\"pw-secret\"}")
failed = failed + check("JSON credential redaction", bool_or(contains(json_redaction, "json-secret"), true) == false && bool_or(contains(json_redaction, "access-secret"), true) == false && bool_or(contains(json_redaction, "pw-secret"), true) == false && bool_or(contains(json_redaction, "[REDACTED_CREDENTIAL]"), false))
failed = failed + check("provider token redaction", contains(redact_text("sk-12345678abcdefghijklmnopqrstuvwxyz"), "[REDACTED_KEY]") && contains(redact_text("github_pat_123456789012345678901234567890"), "[REDACTED_KEY]"))
failed = failed + check("private key redaction", contains(redact_text("-----BEGIN PRIVATE KEY-----"), "[REDACTED_PRIVATE_KEY]"))
bounded_json_path := "/tmp/relay-contract-bounded-json-" + to_string(current_timestamp())
write_file(bounded_json_path, "{\"ok\":true}")
failed = failed + check("bounded JSON read accepts small file", dict_get_or(read_json_limited(bounded_json_path, {}, 64), "ok", false) == true)
failed = failed + check("bounded JSON read rejects oversized file", len(keys(read_json_limited(bounded_json_path, {"fallback": true}, 4))) == 1 && dict_get_or(read_json_limited(bounded_json_path, {"fallback": true}, 4), "fallback", false) == true)
delete_file(bounded_json_path)
failed = failed + check("fallback allows timeout", fallback_allowed({"error": {"code": "timeout"}}))
failed = failed + check("fallback allows rate limit", fallback_allowed({"error": {"code": "rate_limit"}}))
failed = failed + check("fallback allows unavailable provider", fallback_allowed({"error": {"code": "provider_unavailable"}}))
failed = failed + check("fallback rejects authentication", fallback_allowed({"error": {"code": "authentication_failure"}}) == false)
failed = failed + check("fallback rejects policy failure", fallback_allowed({"error": {"code": "policy_violation"}}) == false)
failed = failed + check("cancelled failure classification", classify_failure("cancelled") == "cancelled")
failed = failed + check("timeout failure classification", classify_failure("timed_out") == "timeout")
failed = failed + check("safe Watchdog route", watchdog_route_allowed("http://127.0.0.1:7700/proxy/v1"))
failed = failed + check("HTTPS external Watchdog route", watchdog_route_allowed("https://watchdog.example.com/proxy/v1"))
failed = failed + check("HTTP external Watchdog route denied", watchdog_route_allowed("http://watchdog.example.com/proxy/v1") == false)
failed = failed + check("HTTP IPv6 loopback Watchdog route", watchdog_route_allowed("http://[::1]:7700/proxy/v1"))
failed = failed + check("Watchdog route rejects credentials", watchdog_route_allowed("http://user:secret@127.0.0.1:7700") == false)
failed = failed + check("Watchdog route rejects unsupported scheme", watchdog_route_allowed("file:///tmp/watchdog") == false)
failed = failed + check("Watchdog route rejects missing host", safe_base("https://") == false)
failed = failed + check("Watchdog route rejects query", safe_base("https://watchdog.example.com/proxy?v=1") == false)
failed = failed + check("Watchdog route policy redacts route value", dict_get_or(route_policy("https://user:secret@watchdog.example.com"), "reason", "") == "embedded_credentials")
failed = failed + check("Watchdog route policy records remote HTTP denial", dict_get_or(route_policy("http://watchdog.example.com"), "reason", "") == "http_non_loopback")
failed = failed + check("safe correlation ID", safe_correlation_id("relay-correlation-1") == "relay-correlation-1")
failed = failed + check("correlation query delimiters denied", safe_correlation_id("relay&extra=1") == "")
failed = failed + check("correlation whitespace denied", safe_correlation_id("relay id") == "")
failed = failed + check("safe run key", safe_run_key("relay-run-123"))
failed = failed + check("unsafe run key denied", safe_run_key("../outside") == false)
tmp_base := env_or("RELAY_TEST_TMP_ROOT", ".")
store_root := tmp_base + "/relay-contract-store-safe-" + to_string(current_timestamp())
create_dir(store_root)
failed = failed + check("real state store root accepted", store_root_safe(store_root))
if path_is_dir(store_root) { os_rmdir(store_root) }
lock_root := tmp_base + "/relay-contract-index-lock-" + to_string(current_timestamp())
create_dir(lock_root)
first_lock := acquire_index_lock(lock_root)
second_lock := acquire_index_lock(lock_root)
failed = failed + check("index lock acquired", first_lock["ok"] == true)
failed = failed + check("index lock excludes concurrent writer", second_lock["ok"] == false)
contended_lock := acquire_index_lock_retry(lock_root, 2, 1)
failed = failed + check("bounded lock retry reports contention", contended_lock["ok"] == false && contended_lock["attempts"] == 2)
released_lock := release_index_lock(lock_root, first_lock["token"])
failed = failed + check("index lock released", released_lock["ok"] == true)
retried_lock := acquire_index_lock_retry(lock_root, 2, 1)
failed = failed + check("bounded lock retry acquires after release", retried_lock["ok"] == true && retried_lock["attempts"] == 1)
release_index_lock(lock_root, retried_lock["token"])
if path_is_dir(lock_root) { os_rmdir(lock_root) }
failed = failed + check("safe Watchdog URL", safe_base("http://127.0.0.1:7700"))
failed = failed + check("Watchdog URL with embedded credentials denied", safe_base("http://user:secret@127.0.0.1:7700") == false)
failed = failed + check("Watchdog URL with unsupported scheme denied", safe_base("file:///tmp/watchdog") == false)
resume_spec := {"repository": ".", "workspace_mode": "provided", "budgets": {"max_steps": 8}}
resume_state := {"run_id": "resume-contract", "mission_spec": resume_spec, "mission_spec_integrity_sha256": sha256(safe_json(resume_spec)), "events": [], "receipts": [], "repository": ".", "workspace": {"mode": "provided", "source_repository": ".", "path": "."}, "budgets": {"max_steps": 8, "max_repairs": 1, "max_tokens": 4000, "max_tool_calls": 4, "max_output_bytes": 1048576, "max_write_bytes": 1048576}, "attempt": 0}
failed = failed + check("resume state integrity accepts matching state", resume_state_safe(resume_state, "resume-contract", "/tmp/relay-contract-run") ["ok"])
resume_state["repository"] := "/tmp"
failed = failed + check("resume state integrity rejects workspace substitution", resume_state_safe(resume_state, "resume-contract", "/tmp/relay-contract-run")["ok"] == false)
cleanup_state := {"run_id": "cleanup-contract", "mission_spec": {"repository": ".", "workspace_mode": "worktree"}, "mission_spec_integrity_sha256": sha256(safe_json({"repository": ".", "workspace_mode": "worktree"})), "events": [], "receipts": [], "repository": "/tmp/relay-contract-run/workspace", "workspace": {"mode": "worktree", "source_repository": ".", "path": "/tmp/other-workspace", "cleaned": true}}
failed = failed + check("cleanup state integrity rejects mismatched worktree", cleanup_state_safe(cleanup_state, "cleanup-contract", "/tmp/relay-contract-run")["ok"] == false)
failed = failed + check("control state integrity delegates to checkpoint policy", control_state_safe(resume_state, "resume-contract", "/tmp/relay-contract-run")["ok"] == false)
evidence_state := {"status": "completed"}
evidence_state = mark_evidence_failure(evidence_state, "contract evidence failure")
failed = failed + check("evidence failure marks state failed", evidence_state["status"] == "failed" && dict_get_or(evidence_state, "evidence_failure", {})["class"] == "evidence_failure")
evidence_root := "/tmp/relay-contract-evidence-" + to_string(current_timestamp())
create_dir(evidence_root)
create_dir(evidence_root + "/state.json")
persist_failure := save_state({"status": "completed"}, evidence_root)
failed = failed + check("state persistence failure fails closed", persist_failure["status"] == "failed" && dict_get_or(persist_failure, "evidence_failure", {})["class"] == "evidence_failure")
os_rmdir(evidence_root + "/state.json")
os_rmdir(evidence_root)
artifact_root := "/tmp/relay-contract-required-artifact-" + to_string(current_timestamp())
create_dir(artifact_root)
create_dir(artifact_root + "/changes.json")
required_write_failure := persist_required_json(artifact_root + "/changes.json", {"ok": true}, "dict", "ChangeBucket")
failed = failed + check("required artifact write failure fails closed", required_write_failure["ok"] == false)
os_rmdir(artifact_root + "/changes.json")
required_write_success := persist_required_json(artifact_root + "/evaluations.json", [], "array", "Eval")
failed = failed + check("required artifact persistence verifies shape", required_write_success["ok"] == true)
delete_file(artifact_root + "/evaluations.json")
create_dir(artifact_root + "/report.json")
report_failure := report({"mission_id": "m1", "run_id": "r1", "status": "completed", "current_step": "", "workflow": "verified-feature", "repository": ".", "failure": {}}, artifact_root)
failed = failed + check("report persistence failure fails closed", report_failure["ok"] == false)
os_rmdir(artifact_root + "/report.json")
delete_file(artifact_root + "/report.md")
os_rmdir(artifact_root)
exit(failed)
