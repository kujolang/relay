from src.contracts import event, run_state, agent_profile, RELAY_VERSION, EVENT_CONTRACT
from src.policy import classify_failure, path_is_safe, path_is_within_workspace, command_is_allowed, tool_decision
from src.common import safe_id, redact_text, shell_quote_single, process_options, safe_env_name
from src.store import safe_run_key

func check(label, condition) {
    if condition { print("PASS " + label); return 0 }
    print("FAIL " + label); return 1
}

failed := 0
failed = failed + check("version", RELAY_VERSION == "0.1.0")
failed = failed + check("event contract", EVENT_CONTRACT == "AgentEvent-compatible-v1")
e := event("run_started", "m1", "r1", "s1", "a1", {"ok": true}, "")
failed = failed + check("event required fields", has_key(e, "run_id") && has_key(e, "payload") && has_key(e, "metadata"))
s := run_state("m1", "verified-feature", ".", "r1")
failed = failed + check("run state", s["status"] == "created" && s["run_id"] == "r1")
a := agent_profile("planner", "Planner", "plan", "fixture-model", ["read_repo"], "read_only")
failed = failed + check("agent authority", a["authority"] == "read_only")
failed = failed + check("safe relative path", path_is_safe(".", "src/file.txt"))
failed = failed + check("unsafe traversal", path_is_safe(".", "../secret") == false)
failed = failed + check("nested traversal", path_is_safe(".", "src/../secret") == false)
failed = failed + check("secret file denied", path_is_safe(".", ".env") == false)
failed = failed + check("workspace containment", path_is_within_workspace(".", "src/common.kujo"))
failed = failed + check("safe command", command_is_allowed("git status", {"allowed_commands": ["git"]}))
failed = failed + check("unsafe git command", command_is_allowed("git commit -am unsafe", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked command", command_is_allowed("rm -rf /", {"allowed_commands": ["rm"]}) == false)
failed = failed + check("blocked push", command_is_allowed("git push --force", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked shell chain", command_is_allowed("git status; touch escaped", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked env expansion", command_is_allowed("git status $HOME", {"allowed_commands": ["git"]}) == false)
failed = failed + check("blocked glob expansion", command_is_allowed("git status *", {"allowed_commands": ["git"]}) == false)
failed = failed + check("safe Kujo test command", command_is_allowed("kujo test", {"allowed_commands": ["kujo"]}))
failed = failed + check("unsafe Kujo test path denied", command_is_allowed("kujo test /tmp/evil.kujo", {"workspace": ".", "allowed_commands": ["kujo"]}) == false)
failed = failed + check("unsafe Kujo script path denied", command_is_allowed("kujo run /tmp/evil.kujo", {"workspace": ".", "allowed_commands": ["kujo"]}) == false)
failed = failed + check("safe Kujo workspace script", command_is_allowed("kujo run scripts/check.kujo", {"workspace": ".", "allowed_commands": ["kujo"]}))
failed = failed + check("shell quote", contains(shell_quote_single("repo's path"), "'\"'\"'"))
process := process_options({"RELAY_TEST_ENV": "ok"}, 1000, 4096)
failed = failed + check("bounded process environment", process["inherit_env"] == false && process["max_output_bytes"] == 4096 && has_key(process["env"], "RELAY_TEST_ENV"))
failed = failed + check("safe API env name", safe_env_name("OLLAMA_API_KEY") && safe_env_name("VENDOR_TOKEN_1"))
failed = failed + check("reserved API env name denied", safe_env_name("PATH") == false)
failed = failed + check("invalid API env name denied", safe_env_name("OPENAI-API-KEY") == false)
decision := tool_decision("write_file", {"path": "x.txt"}, {"workspace": ".", "allow_writes": false})
failed = failed + check("write approval boundary", decision["status"] == "approval_required")
failed = failed + check("unknown tool denied", tool_decision("unknown", {}, {})["allowed"] == false)
failed = failed + check("safe id", safe_id("feature/name", "fallback") == "feature-name")
failed = failed + check("redaction", contains(redact_text("Authorization: Bearer secret"), "[REDACTED]"))
failed = failed + check("expanded redaction", contains(redact_text("ANTHROPIC_API_KEY=secret"), "[REDACTED]"))
failed = failed + check("safe run key", safe_run_key("relay-run-123"))
failed = failed + check("unsafe run key denied", safe_run_key("../outside") == false)
exit(failed)
