cleanup_state := {"run_id": "cleanup-contract", "mission_spec": {"repository": ".", "workspace_mode": "worktree"}, "mission_spec_integrity_sha256": sha256(safe_json({"repository": ".", "workspace_mode": "worktree"})), "events": [], "receipts": [], "repository": "/tmp/relay-contract-run/workspace", "workspace": {"mode": "worktree", "source_repository": ".", "path": "/tmp/other-workspace", "cleaned": true}}
cleanup_state["integrity_sha256"] := sha256(state_integrity_input(cleanup_state))
failed = failed + check("cleanup state integrity rejects mismatched worktree", cleanup_state_safe(cleanup_state, "cleanup-contract", "/tmp/relay-contract-run")["ok"] == false)
failed = failed + check("control state integrity delegates to checkpoint policy", control_state_safe(resume_state, "resume-contract", "/tmp/relay-contract-run")["ok"] == false)
evidence_state := {"status": "completed"}
evidence_state = mark_evidence_failure(evidence_state, "contract evidence failure")
failed = failed + check("evidence failure marks state failed", evidence_state["status"] == "failed" && dict_get_or(evidence_state, "evidence_failure", {})["class"] == "evidence_failure")
evidence_root := "/tmp/relay-contract-evidence-" + to_string(current_timestamp())
create_dir(evidence_root)
create_dir(evidence_root + "/state.json")
persist_failure := save_state({"status": "completed"}, evidence_root)
failed = failed + check("state persistence failure fails closed", persist_failure["status"] == "failed" && dict_get_or(persist_failure, "evidence_failure", {})["class"] == "evidence_failure")
os_rmdir(evidence_root + "/state.json")
os_rmdir(evidence_root)
artifact_root := "/tmp/relay-contract-required-artifact-" + to_string(current_timestamp())
create_dir(artifact_root)
create_dir(artifact_root + "/changes.json")
required_write_failure := persist_required_json(artifact_root + "/changes.json", {"ok": true}, "dict", "ChangeBucket")
failed = failed + check("required artifact write failure fails closed", required_write_failure["ok"] == false)
os_rmdir(artifact_root + "/changes.json")
required_write_success := persist_required_json(artifact_root + "/evaluations.json", [], "array", "Eval")
failed = failed + check("required artifact persistence verifies shape", required_write_success["ok"] == true)
delete_file(artifact_root + "/evaluations.json")
create_dir(artifact_root + "/report.json")
report_failure := report({"mission_id": "m1", "run_id": "r1", "status": "completed", "current_step": "", "workflow": "verified-feature", "repository": ".", "failure": {}}, artifact_root)
failed = failed + check("report persistence failure fails closed", report_failure["ok"] == false)
os_rmdir(artifact_root + "/report.json")
delete_file(artifact_root + "/report.md")
os_rmdir(artifact_root)
exit(failed)
