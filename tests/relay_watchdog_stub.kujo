from src.common import dict_get_or, safe_json

func header_value(headers, wanted) {
    for name in keys(headers) { if to_lower(name) == to_lower(wanted) { return to_string(headers[name]) } }
    return ""
}

port := parse_int(env("RELAY_TEST_PORT"))
correlation := env("RELAY_TEST_CORRELATION")
server := http_server(port)

server := server.route("GET", "/healthz", func(req) {
    return http_response(200, "{\"ok\":true,\"data\":{\"status\":\"ok\",\"service\":\"watchdog-stub\"}}")
})

server := server.route("GET", "/api/proxy-config", func(req) {
    headers := dict_get_or(req, "headers", {})
    if header_value(headers, "X-Watchdog-Token") != "relay-api-token" { return http_response(401, "{\"ok\":false,\"error\":\"api auth required\"}") }
    return http_response(200, "{\"ok\":true,\"data\":{\"upstream_base_url\":\"http://stub.invalid/v1\",\"api_auth_enabled\":true,\"proxy_auth_enabled\":true}}")
})

server := server.route("GET", "/api/requests", func(req) {
    headers := dict_get_or(req, "headers", {})
    if header_value(headers, "X-Watchdog-Token") != "relay-api-token" { return http_response(401, "{\"ok\":false,\"error\":\"api auth required\"}") }
    return http_response(200, "{\"ok\":true,\"data\":[{\"correlation_id\":\"" + correlation + "\",\"request_id\":\"stub-request\",\"model\":\"stub-model\",\"status\":\"success\",\"input_tokens\":2,\"output_tokens\":3,\"total_tokens\":5},{\"correlation_id\":\"" + correlation + "\",\"request_id\":\"stub-tool-request\",\"model\":\"stub-model\",\"status\":\"success\",\"input_tokens\":4,\"output_tokens\":6,\"total_tokens\":10},{\"correlation_id\":\"" + correlation + "\",\"request_id\":\"stub-tool-final\",\"model\":\"stub-model\",\"status\":\"success\",\"input_tokens\":8,\"output_tokens\":4,\"total_tokens\":12}]}")
})

server := server.route("POST", "/proxy/v1/chat/completions", func(req) {
    headers := dict_get_or(req, "headers", {})
    if header_value(headers, "X-Watchdog-Proxy-Token") != "relay-proxy-token" { return http_response(401, "{\"error\":{\"message\":\"proxy auth required\"}}") }
    if header_value(headers, "X-Watchdog-Upstream-Profile") != "relay-test-profile" { return http_response(400, "{\"error\":{\"message\":\"upstream profile required\"}}") }
    return http_response(200, "{\"id\":\"stub-request\",\"model\":\"stub-model\",\"choices\":[{\"message\":{\"content\":\"relay-watchdog-stub-ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":3,\"total_tokens\":5}}")
})

server := server.route("POST", "/v1/chat/completions", func(req) {
    body := to_string(dict_get_or(req, "body", ""))
    if body != "" {
        try {
            payload := parse_json(body)
            tools := dict_get_or(payload, "tools", [])
            messages := dict_get_or(payload, "messages", [])
            if type(messages) == "array" && len(messages) > 0 {
                last_message := messages[len(messages) - 1]
                if type(last_message) == "dict" && contains(to_string(dict_get_or(last_message, "content", "")), "Using the repository evidence below") {
                    arguments := safe_json({"answer": "Provider tool result accepted."})
                    response := {"id": "stub-tool-final", "model": "stub-model", "choices": [{"message": {"tool_calls": [{"id": "call-relay-submit", "type": "function", "function": {"name": "relay.submit_answer", "arguments": arguments}}]}, "finish_reason": "tool_calls"}], "usage": {"prompt_tokens": 8, "completion_tokens": 4, "total_tokens": 12}}
                    return http_response(200, safe_json(response))
                }
            }
            if type(tools) == "array" && len(tools) > 0 {
                has_tool_result := false
                if type(messages) == "array" {
                    for message in messages {
                        if type(message) == "dict" && dict_get_or(message, "role", "") == "tool" { has_tool_result = true }
                    }
                }
                if has_tool_result {
                    response := {"id": "stub-tool-final", "model": "stub-model", "choices": [{"message": {"content": "Provider tool result accepted."}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 8, "completion_tokens": 4, "total_tokens": 12}}
                    return http_response(200, safe_json(response))
                }
                arguments := safe_json({"path": "PROVIDER_TOOL_OUTPUT.txt", "content": "Created from a provider-generated tool call.\n"})
                response := {"id": "stub-tool-request", "model": "stub-model", "choices": [{"message": {"tool_calls": [{"id": "call-relay-write", "type": "function", "function": {"name": "relay.write_file", "arguments": arguments}}]}, "finish_reason": "tool_calls"}], "usage": {"prompt_tokens": 4, "completion_tokens": 6, "total_tokens": 10}}
                return http_response(200, safe_json(response))
            }
        } except err {}
    }
    return http_response(200, "{\"id\":\"stub-upstream-request\",\"model\":\"stub-model\",\"choices\":[{\"message\":{\"content\":\"relay-watchdog-upstream-ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":3,\"total_tokens\":5}}")
})

server.listen()
